<% layout("layouts/boilerplate") %>

<main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-blue-700">Administration</p>
      <h1 class="mt-1 text-3xl font-bold text-slate-900 dark:text-white">Notes management</h1>
      <p class="mt-2 text-slate-600 dark:text-slate-300">Review note details and metadata, manage publication, and remove notes.</p>
    </div>
    <nav class="flex gap-3 text-sm font-semibold text-blue-700">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/courses">Courses</a>
      <a href="/admin/universities">Universities</a>
      <a href="/admin/users">Users</a>
    </nav>
  </div>

  <div class="mt-8 space-y-4">
    <% notes.forEach(function (note) { %>
      <details class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
        <summary class="cursor-pointer list-none">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="font-bold"><%= note.title %></h2>
              <p class="mt-1 text-sm text-slate-500"><%= note.course %> · <%= note.subject %> · <%= note.author?.name || note.author?.email || "Unknown author" %></p>
            </div>
            <span class="rounded-full px-3 py-1 text-xs font-semibold <%= note.moderationStatus === 'approved' ? 'bg-emerald-100 text-emerald-800' : note.moderationStatus === 'rejected' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800' %>"><%= note.moderationStatus === "approved" ? "Published" : note.moderationStatus === "rejected" ? "Rejected" : "Awaiting review" %></span>
          </div>
        </summary>
        <form action="/admin/notes/<%= note._id %>" method="POST" class="mt-5 grid gap-4 border-t pt-5 sm:grid-cols-2">
          <input type="hidden" name="_method" value="PATCH">
          <label class="text-sm font-semibold">Title
            <input name="title" maxlength="160" required value="<%= note.title %>" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
          </label>
          <label class="text-sm font-semibold">Subject
            <input name="subject" maxlength="100" required value="<%= note.subject %>" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
          </label>
          <label class="text-sm font-semibold">Universities
            <select name="universities[]" multiple size="4" required class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
              <% universities.forEach(function (university) { %>
                <option value="<%= university._id %>" <%= (note.universities || []).some((item) => String(item._id || item) === String(university._id)) ? "selected" : "" %>><%= university.name %></option>
              <% }); %>
            </select>
          </label>
          <label class="text-sm font-semibold">Colleges
            <select name="colleges[]" multiple size="4" required class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
              <% colleges.forEach(function (college) { %>
                <option value="<%= college._id %>" <%= (note.colleges || []).some((item) => String(item._id || item) === String(college._id)) ? "selected" : "" %>><%= college.name %></option>
              <% }); %>
            </select>
            <span class="mt-1 block text-xs font-normal text-slate-500">Each selected college must belong to one of the selected universities.</span>
          </label>
          <label class="text-sm font-semibold">Description
            <textarea name="description" maxlength="2000" rows="3" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"><%= note.description || '' %></textarea>
          </label>
          <label class="text-sm font-semibold">SEO description
            <textarea name="metaDescription" maxlength="300" rows="3" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"><%= note.metaDescription || '' %></textarea>
          </label>
          <label class="text-sm font-semibold">SEO keywords (comma-separated)
            <textarea name="keywords" maxlength="1200" rows="3" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"><%= (note.keywords || []).join(", ") %></textarea>
          </label>
          <label class="text-sm font-semibold sm:col-span-2">Public resource URL
            <input name="sourceUrl" type="url" maxlength="2048" required value="<%= note.sourceUrl %>" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
          </label>
          <label class="text-sm font-semibold">Course
            <select name="courseId" required class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
              <% courses.forEach(function (course) { %><option value="<%= course._id %>" <%= String(note.courseId) === String(course._id) ? "selected" : "" %>><%= course.name %></option><% }) %>
            </select>
          </label>
          <label class="text-sm font-semibold">Specialization
            <input name="specialization" maxlength="100" value="<%= note.specialization || '' %>" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
          </label>
          <label class="text-sm font-semibold">Material category
            <input name="noteCategory" maxlength="80" value="<%= note.noteCategory || 'General' %>" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
          </label>
          <label class="text-sm font-semibold">Semester
            <input name="semester" type="number" min="1" max="12" required value="<%= note.semester || 1 %>" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
          </label>
          <label class="text-sm font-semibold">Review status
            <select name="moderationStatus" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
              <option value="pending" <%= note.moderationStatus === "pending" ? "selected" : "" %>>Awaiting review</option>
              <option value="approved" <%= note.moderationStatus === "approved" ? "selected" : "" %>>Approved and published</option>
              <option value="rejected" <%= note.moderationStatus === "rejected" ? "selected" : "" %>>Rejected</option>
            </select>
          </label>
          <label class="text-sm font-semibold">Note type
            <select name="type" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950">
              <% ["pdf", "handwritten", "typed", "solved"].forEach(function (type) { %><option value="<%= type %>" <%= note.type === type ? "selected" : "" %>><%= type %></option><% }) %>
            </select>
          </label>
          <div class="flex flex-wrap gap-3 sm:col-span-2">
            <button class="rounded-full bg-blue-600 px-5 py-2.5 font-semibold text-white">Save note</button>
            <a href="<%= note.sourceUrl %>" rel="noopener noreferrer" target="_blank" class="rounded-full border px-5 py-2.5 font-semibold">Open link</a>
          </div>
        </form>
        <% if (!note.isPublished) { %>
          <div class="mt-4 flex flex-wrap gap-3 border-t pt-4">
            <form action="/admin/notes/<%= note._id %>/moderate" method="POST">
              <input type="hidden" name="_method" value="PATCH">
              <input type="hidden" name="status" value="approved">
              <button class="rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700">Approve & publish</button>
            </form>
            <% if (note.moderationStatus !== "rejected") { %>
              <form action="/admin/notes/<%= note._id %>/moderate" method="POST" onsubmit="return confirm('Reject this note and keep it private?')">
                <input type="hidden" name="_method" value="PATCH">
                <input type="hidden" name="status" value="rejected">
                <button class="rounded-full border border-rose-300 px-5 py-2.5 text-sm font-semibold text-rose-700 hover:bg-rose-50">Reject</button>
              </form>
            <% } %>
          </div>
        <% } %>
        <form action="/admin/notes/<%= note._id %>" method="POST" class="mt-3" onsubmit="return confirm('Remove this note permanently?')">
          <input type="hidden" name="_method" value="DELETE">
          <button class="rounded-full border border-rose-300 px-4 py-2 text-sm font-semibold text-rose-700">Delete note</button>
        </form>
      </details>
    <% }) %>
    <% if (!notes.length) { %><p class="rounded-2xl border border-dashed p-8 text-center text-slate-500">No notes found.</p><% } %>
  </div>
</main>
