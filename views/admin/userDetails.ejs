<% layout("layouts/boilerplate") %>

<main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
  <a href="/admin/users" class="text-sm font-semibold text-blue-700 hover:underline">← Back to users</a>
  <header class="mt-4">
    <p class="text-sm font-semibold uppercase tracking-wider text-blue-700">Administrator view</p>
    <h1 class="mt-1 text-3xl font-bold text-slate-900 dark:text-white"><%= user.name %></h1>
    <p class="mt-2 break-all text-slate-600 dark:text-slate-300"><%= user.email || "No email" %> · <%= user.role %> · <%= user.isVerified ? "Verified" : "Unverified" %></p>
    <nav class="mt-3 flex flex-wrap gap-4 text-sm font-semibold text-blue-700"><a href="/admin/auth-activity">All auth activity</a><a href="/admin/contributions">All contributions</a></nav>
  </header>

  <div class="mt-8 grid gap-6 md:grid-cols-2">
    <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
      <h2 class="text-lg font-bold">Account details</h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Mobile</dt><dd><%= user.mobile || "—" %></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-slate-500">University</dt><dd><%= user.university || "—" %></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-slate-500">College</dt><dd><%= user.college || "—" %></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Account status</dt><dd><%= user.isBlocked ? "Blocked" : user.isActive ? "Active" : "Inactive" %></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Joined</dt><dd><%= user.createdAt ? new Date(user.createdAt).toLocaleString() : "—" %></dd></div>
      </dl>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
      <h2 class="text-lg font-bold">Recent sign-ins</h2>
      <% if (user.loginHistory?.length) { %>
        <ul class="mt-4 space-y-3 text-sm">
          <% user.loginHistory.slice().reverse().forEach(function (entry) { %>
            <li class="border-b pb-2 last:border-0"><%= entry.method %> · <%= entry.device || "unknown device" %><time class="block text-xs text-slate-500"><%= new Date(entry.loggedInAt).toLocaleString() %></time></li>
          <% }) %>
        </ul>
      <% } else { %><p class="mt-3 text-sm text-slate-500">No sign-in history.</p><% } %>
    </section>
  </div>

  <section class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
    <h2 class="text-lg font-bold">Authentication activity (<%= authActivities.length %>)</h2>
    <p class="mt-1 text-xs text-slate-500">Passwords and reset tokens are never stored. IP addresses are represented only by keyed hashes.</p>
    <ul class="mt-4 divide-y dark:divide-slate-700">
      <% authActivities.forEach(function (activity) { %>
        <li class="flex flex-col justify-between gap-2 py-3 text-sm sm:flex-row sm:items-start">
          <div><strong><%= activity.event === "login" ? "Login attempt" : "Password reset" %></strong> · <%= activity.outcome %><p class="mt-1 text-slate-600 dark:text-slate-300"><%= activity.details || "—" %> · <%= activity.device %> / <%= activity.browser %></p></div>
          <time class="shrink-0 text-xs text-slate-500"><%= new Date(activity.createdAt).toLocaleString() %></time>
        </li>
      <% }) %>
      <% if (!authActivities.length) { %><li class="py-3 text-sm text-slate-500">No authentication events recorded.</li><% } %>
    </ul>
  </section>

  <section class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
    <h2 class="text-lg font-bold">Edit account</h2>
    <p class="mt-1 text-sm text-slate-500">Email and authentication credentials are not editable from this screen.</p>
    <form action="/admin/users/<%= user._id %>" method="POST" class="mt-4 grid gap-4 sm:grid-cols-2">
      <input type="hidden" name="_method" value="PATCH">
      <label class="text-sm font-semibold">Name<input name="name" required maxlength="100" value="<%= user.name %>" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"></label>
      <label class="text-sm font-semibold">Mobile<input name="mobile" maxlength="20" value="<%= user.mobile || '' %>" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"></label>
      <label class="text-sm font-semibold">University<input name="university" maxlength="160" value="<%= user.university || '' %>" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"></label>
      <label class="text-sm font-semibold">College<input name="college" maxlength="160" value="<%= user.college || '' %>" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"></label>
      <label class="text-sm font-semibold">Role<select name="role" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"><option value="user" <%= user.role === "user" ? "selected" : "" %>>User</option><option value="admin" <%= user.role === "admin" ? "selected" : "" %>>Admin</option></select></label>
      <label class="text-sm font-semibold">Active<select name="isActive" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"><option value="true" <%= user.isActive ? "selected" : "" %>>Yes</option><option value="false" <%= !user.isActive ? "selected" : "" %>>No</option></select></label>
      <label class="text-sm font-semibold">Blocked<select name="isBlocked" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"><option value="true" <%= user.isBlocked ? "selected" : "" %>>Yes</option><option value="false" <%= !user.isBlocked ? "selected" : "" %>>No</option></select></label>
      <label class="text-sm font-semibold">Email verified<select name="isVerified" class="mt-1 w-full rounded-lg border px-3 py-2 dark:bg-slate-950"><option value="true" <%= user.isVerified ? "selected" : "" %>>Yes</option><option value="false" <%= !user.isVerified ? "selected" : "" %>>No</option></select></label>
      <button class="rounded-full bg-blue-600 px-5 py-2.5 font-semibold text-white sm:col-span-2 sm:justify-self-start">Save account changes</button>
    </form>
  </section>

  <section class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
    <h2 class="text-lg font-bold">Notes by this user (<%= notes.length %>)</h2>
    <ul class="mt-4 divide-y dark:divide-slate-700">
      <% notes.forEach(function (note) { %><li class="flex flex-wrap justify-between gap-2 py-3 text-sm"><a href="/admin/notes" class="font-semibold text-blue-700 hover:underline"><%= note.title %></a><span><%= note.course %> · <%= note.subject %> · <%= note.isPublished ? "Published" : "Hidden" %></span></li><% }) %>
      <% if (!notes.length) { %><li class="py-3 text-sm text-slate-500">No submitted notes.</li><% } %>
    </ul>
  </section>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
      <h2 class="text-lg font-bold">Saved notes (<%= user.savedNotes?.length || 0 %>) and likes (<%= likedNotes.length %>)</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <% (user.savedNotes || []).forEach(function (note) { %><li><a class="text-blue-700 hover:underline" href="/notes/<%= note._id %>"><%= note.title %></a> <span class="text-slate-500">· saved</span></li><% }) %>
        <% likedNotes.forEach(function (note) { %><li><a class="text-blue-700 hover:underline" href="/notes/<%= note._id %>"><%= note.title %></a> <span class="text-slate-500">· liked</span></li><% }) %>
        <% if (!user.savedNotes?.length && !likedNotes.length) { %><li class="text-slate-500">No saved or liked notes.</li><% } %>
      </ul>
    </section>
    <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
      <h2 class="text-lg font-bold">Saved and liked articles (<%= user.savedBlogs?.length || 0 %> saved · <%= likedBlogs.length %> liked)</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <% (user.savedBlogs || []).forEach(function (blog) { %><li><a class="text-blue-700 hover:underline" href="/blogs/<%= blog.id || blog._id %>"><%= blog.title %></a> <span class="text-slate-500">· saved</span></li><% }) %>
        <% likedBlogs.forEach(function (blog) { %><li><a class="text-blue-700 hover:underline" href="/blogs/<%= blog.id || blog._id %>"><%= blog.title %></a> <span class="text-slate-500">· liked</span></li><% }) %>
        <% if (!user.savedBlogs?.length && !likedBlogs.length) { %><li class="text-slate-500">No saved or liked articles.</li><% } %>
      </ul>
    </section>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
      <h2 class="text-lg font-bold">Note comments</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <% commentedNotes.forEach(function (note) { note.comments.forEach(function (comment) { %><li class="rounded-xl bg-slate-50 p-3 dark:bg-slate-800"><strong><%= note.title %></strong><p class="mt-1 whitespace-pre-line"><%= comment.text %></p><time class="text-xs text-slate-500"><%= new Date(comment.createdAt).toLocaleString() %></time></li><% }) }) %>
        <% if (!commentedNotes.some(function (note) { return note.comments.length; })) { %><li class="text-slate-500">No note comments.</li><% } %>
      </ul>
    </section>
    <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
      <h2 class="text-lg font-bold">Article comments</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <% commentedBlogs.forEach(function (blog) { blog.comments.forEach(function (comment) { %><li class="rounded-xl bg-slate-50 p-3 dark:bg-slate-800"><strong><%= blog.title %></strong><p class="mt-1 whitespace-pre-line"><%= comment.text %></p><time class="text-xs text-slate-500"><%= new Date(comment.createdAt).toLocaleString() %></time></li><% }) }) %>
        <% if (!commentedBlogs.some(function (blog) { return blog.comments.length; })) { %><li class="text-slate-500">No article comments.</li><% } %>
      </ul>
    </section>
  </div>

  <section class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
    <h2 class="text-lg font-bold">Downloads (<%= downloads.length %>)</h2>
    <ul class="mt-4 divide-y dark:divide-slate-700">
      <% downloads.forEach(function (download) { %><li class="py-3 text-sm"><%= download.note?.title || "Removed note" %> · <%= [download.university, download.college].filter(Boolean).join(" / ") || "Campus not provided" %><time class="ml-2 text-xs text-slate-500"><%= new Date(download.downloadedAt).toLocaleString() %></time></li><% }) %>
      <% if (!downloads.length) { %><li class="py-3 text-sm text-slate-500">No downloads recorded.</li><% } %>
    </ul>
  </section>

  <section class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
    <h2 class="text-lg font-bold">Contributions (<%= contributions.length %>)</h2>
    <ul class="mt-4 divide-y dark:divide-slate-700">
      <% contributions.forEach(function (item) { %>
        <li class="flex flex-col justify-between gap-2 py-3 text-sm sm:flex-row sm:items-center">
          <div><strong>₹<%= (item.amount / 100).toLocaleString("en-IN") %></strong> · <%= item.status %><p class="mt-1 break-all text-xs text-slate-500">From <%= item.sourcePage || "unknown page" %> · <%= item.razorpayPaymentId || "Payment not completed" %></p></div>
          <time class="text-xs text-slate-500"><%= item.paidAt ? new Date(item.paidAt).toLocaleString() : new Date(item.createdAt).toLocaleString() %></time>
        </li>
      <% }) %>
      <% if (!contributions.length) { %><li class="py-3 text-sm text-slate-500">No contributions recorded for this account.</li><% } %>
    </ul>
  </section>

  <section class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
    <h2 class="text-lg font-bold">Contact submissions (<%= contacts.length %>)</h2>
    <ul class="mt-4 divide-y dark:divide-slate-700">
      <% contacts.forEach(function (contact) { %><li class="py-3 text-sm"><strong><%= contact.subject %></strong> · <%= contact.message %><time class="block text-xs text-slate-500"><%= new Date(contact.msgDate).toLocaleString() %></time></li><% }) %>
      <% if (!contacts.length) { %><li class="py-3 text-sm text-slate-500">No contact submissions.</li><% } %>
    </ul>
  </section>
</main>
