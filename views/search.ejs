<% layout("/layouts/boilerplate") -%>

<main class="mx-auto min-h-[60vh] max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
  <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Search NoteSphere</h1>
  <form action="/search" method="GET" role="search" class="mt-6 flex gap-2">
    <label class="sr-only" for="search-query">Search notes, blogs, or pages</label>
    <input id="search-query" type="search" name="q" value="<%= query %>" maxlength="100" placeholder="Try a subject, blog, or page such as contact form"
      class="min-w-0 flex-1 rounded-xl border border-slate-300 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
    <button class="rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700">Search</button>
  </form>

  <% if (query) { %>
    <p class="mt-6 text-sm text-slate-500">Results for “<%= query %>”</p>
    <% if (results.length) { %>
      <ul class="mt-3 space-y-2">
        <% results.forEach(function (result) { %>
          <li>
            <a href="<%= result.url %>" class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 hover:border-blue-300 hover:bg-blue-50/50 dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-300"><i class="<%= result.icon %>"></i></span>
              <span class="min-w-0">
                <span class="block font-semibold text-slate-900 dark:text-white"><%= result.title %></span>
                <span class="mt-1 block line-clamp-2 text-sm text-slate-500 dark:text-slate-400"><%= result.subtitle %></span>
              </span>
            </a>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p class="mt-4 rounded-xl border border-dashed p-8 text-center text-slate-500">No close matches. Try a shorter search or different spelling.</p>
    <% } %>
  <% } %>
</main>
