<% layout("/layouts/boilerplate") -%>

<div class="min-h-screen bg-[#FBFAF7] px-4 py-8 dark:bg-slate-950 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-4xl">
    <!-- Header -->
    <div class="mb-8">
      <a href="/blogs/yourblogs" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 transition hover:text-[#0878E8] dark:text-slate-400"><i class="fa-solid fa-arrow-left text-xs"></i> Manage blogs</a>
      <h1 class="mt-4 text-3xl font-bold text-[#022E5A] dark:text-white sm:text-4xl">
        Edit Blog
      </h1>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 sm:text-base">
        Update your blog content, category and details below.
      </p>
    </div>

    <!-- Form Card -->
    <div class="rounded-3xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-8">
      <form 
        id="edit-blog-form"
        action="/blogs/<%= blog._id %>?_method=PUT" 
        method="POST" 
        class="space-y-8"
        enctype="multipart/form-data"
      >
        <!-- Title -->
        <div>
          <label for="title" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
            Title <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            name="title"
            id="title"
            value="<%= blog.title %>"
            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 transition focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            placeholder="Enter blog title..."
            required
          >
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
            A clear and engaging title that captures attention
          </p>
        </div>

        <!-- Category -->
        <div>
          <label for="category" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
            Category <span class="text-red-500">*</span>
          </label>
          <select 
            name="category" 
            id="category" 
            class="w-full appearance-none rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 transition focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            required
          >
            <option value="">Select a category</option>
            <% blogCategories.forEach(function (category) { %>
              <option value="<%= category %>" <%= blog.category === category ? "selected" : "" %>><%= category %></option>
            <% }); %>
          </select>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
            Choose the most relevant category for your blog
          </p>
        </div>

        <!-- Short Description -->
        <div>
          <label for="shortdescription" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
            Short Description <span class="text-red-500">*</span>
          </label>
          <textarea
            name="shortdescription"
            id="shortdescription"
            rows="3"
            class="w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 transition focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            placeholder="A short summary of the blog (appears in blog listings)..."
            required
          ><%= blog.shortdescription %></textarea>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
            150-200 characters recommended for best display
          </p>
        </div>

        <!-- Current Image Preview -->
        <% if (originalImageUrl) { %>
          <div id="current-image-card" class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950 sm:p-6">
            <label class="mb-4 block text-sm font-semibold text-slate-700 dark:text-slate-200">
              Current Image
            </label>
            <div class="flex flex-col sm:flex-row items-start gap-6">
              <div class="h-48 w-full shrink-0 overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900 sm:w-48">
                <img 
                  src="<%= originalImageUrl %>" 
                  alt="<%= blog.imageTitle || 'Blog image' %>"
                  class="w-full h-full object-cover"
                >
              </div>
              <div class="flex-1">
                <div class="space-y-4">
                  <div>
                    <h4 class="text-sm font-semibold text-slate-700 dark:text-slate-200">Current Image Details</h4>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                      This image is currently displayed with your blog. Upload a new image below if you want to change it.
                    </p>
                  </div>
                  <% if (blog.imageTitle) { %>
                    <div>
                      <h4 class="text-sm font-semibold text-slate-700 dark:text-slate-200">Current Alt Text</h4>
                      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                        <%= blog.imageTitle %>
                      </p>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% } %>

        <!-- Upload New Image -->
        <div class="space-y-6">
          <!-- Image Upload -->
          <div id="image-upload-field">
            <label for="image" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
              Upload New Image
              <span class="text-gray-500 font-normal">(Optional)</span>
            </label>
            <div class="mt-1 flex justify-center rounded-2xl border-2 border-dashed border-slate-300 px-6 py-6 transition-colors hover:border-[#0878E8] dark:border-slate-700 dark:hover:border-[#0878E8]">
              <div class="space-y-1 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                  <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div class="flex flex-wrap justify-center gap-1 text-sm text-slate-600 dark:text-slate-300">
                  <label for="image" class="relative cursor-pointer rounded-md bg-white font-semibold text-[#0878E8] hover:text-[#0668CC] focus-within:outline-none focus-within:ring-2 focus-within:ring-[#0878E8] dark:bg-slate-900">
                    <span>Upload a file</span>
                    <input id="image" name="image" type="file" class="sr-only" accept="image/jpeg,image/png,image/webp,image/gif">
                  </label>
                  <p>to preview a new cover image</p>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  PNG, JPG, WebP, or GIF · up to 5 MB
                </p>
              </div>
            </div>
            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
              Recommended size: 1200×630px for optimal display
            </p>
          </div>

          <!-- Image Alt Text -->
          <div>
            <label for="imageTitle" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
              Image Alt Text
              <span class="text-gray-500 font-normal">(Optional)</span>
            </label>
            <input
              type="text"
              name="imageTitle"
              id="imageTitle"
              value="<%= blog.imageTitle || '' %>"
              class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 transition focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              placeholder="Describe the image for SEO and accessibility..."
            >
            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
              This helps with search engines and screen readers. Example: "Person writing code on laptop"
            </p>
          </div>
        </div>

        <!-- Keywords -->
        <div>
          <label for="Keywords" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
            Keywords <span class="text-red-500">*</span>
          </label>
          <textarea
            name="Keywords"
            id="Keywords"
            rows="2"
            class="w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 transition focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            placeholder="Enter keywords separated by commas (e.g., machine learning, Python basics, career tips, engineering exams)"
            required
          ><%= blog.Keywords %></textarea>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
            Separate keywords with commas. These help readers find your content
          </p>
        </div>

        <!-- Full Content -->
        <div>
          <label for="content" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
            Content <span class="text-red-500">*</span>
          </label>
          <textarea
            name="content"
            id="content"
            rows="12"
            class="min-h-72 w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 font-mono text-sm text-slate-900 transition focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
            placeholder="Write HTML blog content or use the formatting buttons below"
            required
          ><%= blog.content %></textarea>
          <div class="mt-3 flex flex-wrap gap-2" role="toolbar" aria-label="Blog content formatting">
            <button type="button" data-format="h2" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:border-[#0878E8] hover:text-[#0878E8] dark:border-slate-700 dark:text-slate-200"><i class="fa-solid fa-heading mr-1"></i> Heading</button>
            <button type="button" data-format="strong" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:border-[#0878E8] hover:text-[#0878E8] dark:border-slate-700 dark:text-slate-200"><i class="fa-solid fa-bold mr-1"></i> Bold</button>
            <button type="button" data-format="em" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:border-[#0878E8] hover:text-[#0878E8] dark:border-slate-700 dark:text-slate-200"><i class="fa-solid fa-italic mr-1"></i> Italic</button>
            <button type="button" data-format="a" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:border-[#0878E8] hover:text-[#0878E8] dark:border-slate-700 dark:text-slate-200"><i class="fa-solid fa-link mr-1"></i> Link</button>
            <button type="button" data-format="ul" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:border-[#0878E8] hover:text-[#0878E8] dark:border-slate-700 dark:text-slate-200"><i class="fa-solid fa-list-ul mr-1"></i> List</button>
          </div>
          <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">Use H2 and H3 headings to create sections. The article page builds its table of contents from these headings.</p>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col gap-3 border-t border-slate-200 pt-6 dark:border-slate-800 sm:flex-row">
          <button
            type="submit"
            class="flex-1 rounded-xl bg-[#0878E8] px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-[#0668CC] focus:outline-none focus:ring-2 focus:ring-[#0878E8] focus:ring-offset-2"
          >
            <i class="fas fa-save mr-2"></i>
            Update Blog
          </button>
          <a
            href="/blogs/<%= blog._id %>"
            class="flex-1 rounded-xl border border-slate-200 px-6 py-3 text-center font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            <i class="fas fa-times mr-2"></i>
            Cancel
          </a>
        </div>
      </form>
    </div>

    <!-- Help Tips -->
    <div class="mt-8 rounded-2xl border border-[#0878E8]/15 bg-[#0878E8]/5 p-6 dark:border-blue-900/60 dark:bg-blue-950/30">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <i class="fas fa-lightbulb text-blue-600 text-xl"></i>
        </div>
        <div class="ml-4">
          <h3 class="text-lg font-semibold text-[#022E5A] dark:text-white">Editing Tips</h3>
          <div class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="text-sm text-slate-700 dark:text-slate-300">
              <p class="font-semibold">Title & Description</p>
              <p class="mt-1">Make them clear and useful to readers.</p>
            </div>
            <div class="text-sm text-slate-700 dark:text-slate-300">
              <p class="font-semibold">Keywords</p>
              <p class="mt-1">Use specific terms your audience searches for.</p>
            </div>
            <div class="text-sm text-slate-700 dark:text-slate-300">
              <p class="font-semibold">Images</p>
              <p class="mt-1">Use a relevant, accessible cover image.</p>
            </div>
            <div class="text-sm text-slate-700 dark:text-slate-300">
              <p class="font-semibold">Content</p>
              <p class="mt-1">Use subheadings and paragraphs for readability.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for Form Enhancement -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  const form = document.getElementById("edit-blog-form");
  if (!form) return;

  const submitButton = form.querySelector('button[type="submit"]');
  form.addEventListener("submit", function () {
    if (!form.reportValidity()) return;
    submitButton.disabled = true;
    submitButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Saving changes…';
  });

  const content = document.getElementById("content");
  form.querySelectorAll("[data-format]").forEach(function (button) {
    button.addEventListener("click", function () {
      const type = button.dataset.format;
      const start = content.selectionStart;
      const end = content.selectionEnd;
      const selected = content.value.slice(start, end);
      let insertion;

      if (type === "a") {
        const url = window.prompt("Enter the link URL (https://…):");
        if (!url) return;
        try {
          const parsedUrl = new URL(url);
          if (!["http:", "https:"].includes(parsedUrl.protocol)) throw new Error("Unsupported URL");
          insertion = `<a href="${parsedUrl.href}">${selected || "Link text"}</a>`;
        } catch {
          window.alert("Enter a valid http or https URL.");
          return;
        }
      } else if (type === "ul") {
        const items = (selected || "List item").split(/\r?\n/).filter(Boolean);
        insertion = `<ul>\n${items.map((item) => `<li>${item}</li>`).join("\n")}\n</ul>`;
      } else {
        const defaults = { h2: "Section heading", strong: "Bold text", em: "Emphasized text" };
        insertion = `<${type}>${selected || defaults[type]}</${type}>`;
      }

      content.setRangeText(insertion, start, end, "select");
      content.focus();
      content.dispatchEvent(new Event("input", { bubbles: true }));
    });
  });

  const fileInput = document.getElementById("image");
  if (fileInput) {
    fileInput.addEventListener("change", function () {
      const file = fileInput.files[0];
      let preview = form.querySelector(".image-preview");
      if (preview) preview.remove();
      if (!file) return;

      const allowedTypes = ["image/jpeg", "image/png", "image/webp", "image/gif"];
      if (!allowedTypes.includes(file.type) || file.size > 5 * 1024 * 1024) {
        window.alert("Choose a JPG, PNG, WebP, or GIF image up to 5 MB.");
        fileInput.value = "";
        return;
      }

      const reader = new FileReader();
      reader.addEventListener("load", function () {
        preview = document.createElement("div");
        preview.className = "image-preview mt-4 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/30";

        const heading = document.createElement("p");
        heading.className = "mb-3 text-sm font-semibold text-emerald-800 dark:text-emerald-200";
        heading.textContent = "New cover image preview";

        const row = document.createElement("div");
        row.className = "flex flex-col gap-3 sm:flex-row sm:items-center";
        const image = document.createElement("img");
        image.src = String(reader.result);
        image.alt = "Selected cover preview";
        image.className = "h-32 w-48 rounded-xl border border-emerald-200 bg-white object-contain dark:border-emerald-900";

        const details = document.createElement("p");
        details.className = "min-w-0 break-words text-sm text-emerald-900 dark:text-emerald-100";
        details.textContent = `${file.name} · ${(file.size / 1024).toFixed(1)} KB`;

        const removeButton = document.createElement("button");
        removeButton.type = "button";
        removeButton.className = "self-start rounded-lg px-3 py-2 text-sm font-semibold text-emerald-800 hover:bg-emerald-100 dark:text-emerald-200 dark:hover:bg-emerald-900/50 sm:ml-auto";
        removeButton.textContent = "Remove";
        removeButton.addEventListener("click", function () {
          fileInput.value = "";
          preview.remove();
        });

        row.append(image, details, removeButton);
        preview.append(heading, row);
        document.getElementById("image-upload-field").appendChild(preview);
      });
      reader.readAsDataURL(file);
    });
  }

  const shortDescription = document.getElementById("shortdescription");
  if (shortDescription) {
    const counter = document.createElement("p");
    counter.className = "mt-1 text-right text-xs text-slate-500 dark:text-slate-400";
    shortDescription.parentNode.appendChild(counter);
    const updateCounter = function () {
      counter.textContent = `${shortDescription.value.length} characters`;
    };
    shortDescription.addEventListener("input", updateCounter);
    updateCounter();
  }
});
</script>
