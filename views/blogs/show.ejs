<% layout("/layouts/boilerplate") -%>

<!-- Share Modal -->
<div id="shareModal" class="fixed inset-0 z-[120] hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="relative my-auto max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-3xl border border-slate-200 bg-white text-left shadow-2xl dark:border-slate-700 dark:bg-slate-900">
        
    <!-- Modal Header -->
    <div class="bg-[#022E5A] px-5 py-5 sm:px-6">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-white" id="modal-title">
              <i class="fas fa-share-alt mr-2"></i> Share This Blog
            </h3>
            <button type="button" onclick="closeShareModal()" aria-label="Close share dialog" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
    </div>

    <!-- Modal Body -->
    <div class="p-5 sm:p-6">
          <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">Choose where you’d like to share this article.</p>
          <div class="grid grid-cols-2 gap-3">
            <!-- Facebook -->
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(requestUrl) %>"
               target="_blank"
               rel="noopener noreferrer"
               class="flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold text-[#022E5A] transition hover:border-[#0878E8]/50 hover:bg-blue-50/70 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-800">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#1877F2]/10 text-[#1877F2]"><i class="fab fa-facebook-f"></i></span>
              <span class="truncate">Facebook</span>
            </a>

            <!-- WhatsApp -->
            <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(blog.title + ' ' + requestUrl) %>"
               target="_blank"
               rel="noopener noreferrer"
               class="flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold text-[#022E5A] transition hover:border-[#0878E8]/50 hover:bg-blue-50/70 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-800">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600"><i class="fab fa-whatsapp"></i></span>
              <span class="truncate">WhatsApp</span>
            </a>

            <!-- Twitter -->
            <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(requestUrl) %>&text=<%= encodeURIComponent('Check this out: ' + blog.title) %>"
               target="_blank"
               rel="noopener noreferrer"
               class="flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold text-[#022E5A] transition hover:border-[#0878E8]/50 hover:bg-blue-50/70 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-800">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-sky-500/10 text-sky-600"><i class="fab fa-twitter"></i></span>
              <span class="truncate">X / Twitter</span>
            </a>

            <!-- LinkedIn -->
            <a href="https://www.linkedin.com/shareArticle?mini=true&url=<%= encodeURIComponent(requestUrl) %>"
               target="_blank"
               rel="noopener noreferrer"
               class="flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold text-[#022E5A] transition hover:border-[#0878E8]/50 hover:bg-blue-50/70 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-800">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-700/10 text-blue-700"><i class="fab fa-linkedin-in"></i></span>
              <span class="truncate">LinkedIn</span>
            </a>

            <!-- Copy Link -->
            <button onclick="copyToClipboard()" 
                    id="copyBtn"
                    class="col-span-2 flex w-full items-center justify-center gap-2 rounded-xl bg-[#0878E8] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#0668CC]">
              <i class="far fa-copy"></i> Copy article link
            </button>
          </div>

          <!-- Current URL -->
          <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-950">
            <p class="mb-1 text-xs font-semibold text-slate-500 dark:text-slate-400">Article link</p>
            <div class="flex min-w-0 items-center gap-2">
              <input type="text" 
                     id="shareUrl" 
                     value="<%= requestUrl %>"
                     readonly
                     class="min-w-0 flex-1 border-none bg-transparent text-xs text-slate-700 focus:outline-none dark:text-slate-200">
              <button type="button" onclick="copyToClipboard()" aria-label="Copy article link" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-500 transition hover:bg-white hover:text-[#0878E8] dark:hover:bg-slate-800">
                <i class="far fa-copy"></i>
              </button>
            </div>
          </div>
    </div>

    <!-- Modal Footer -->
    <div class="border-t border-slate-100 px-5 py-4 dark:border-slate-800 sm:px-6">
          <button type="button" 
                  onclick="closeShareModal()" 
                  class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
            Close
          </button>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal<%= blog._id %>" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
  
  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-md">
        
        <!-- Modal Header -->
        <div class="bg-gradient-to-r from-red-500 to-red-600 px-6 py-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-white" id="modal-title">
              <i class="fas fa-exclamation-triangle mr-2"></i> Confirm Deletion
            </h3>
            <button type="button" onclick="closeDeleteModal()" class="rounded-md text-white hover:text-gray-200">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
        </div>

        <!-- Modal Body -->
        <div class="px-6 py-6">
          <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100">
            <i class="fas fa-trash-alt text-red-600 text-xl"></i>
          </div>
          <div class="mt-3 text-center">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              Delete "<%= blog.title %>"?
            </h3>
            <p class="text-sm text-gray-500">
              This action cannot be undone. The blog will be permanently deleted.
            </p>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="bg-gray-50 px-6 py-4 flex justify-end space-x-3 rounded-b-2xl">
          <button type="button" 
                  onclick="closeDeleteModal()" 
                  class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
            Cancel
          </button>
          <form action="/blogs/<%= blog._id %>?_method=DELETE" method="POST">
            <button type="submit" 
                    class="px-4 py-2 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-lg hover:from-red-600 hover:to-red-700 transition-colors">
              Yes, Delete
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<% if(blog){ %>
<div class="min-h-screen bg-[#FBFAF7] dark:bg-slate-950">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Blog Header -->
    <div class="mx-auto max-w-6xl">
      <!-- Alert for blocked blog -->
      <% if(blog.blocked){ %>
        <div class="mb-6 bg-gradient-to-r from-red-50 to-red-100 border border-red-200 rounded-2xl p-6 shadow-sm">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <i class="fas fa-ban text-red-600 text-2xl"></i>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-semibold text-red-800">Blog Blocked</h3>
              <p class="text-red-700 mt-1">
                This blog has been <strong>blocked by admin</strong> and may not be visible to regular users.
              </p>
            </div>
          </div>
        </div>
      <% } %>

      <% if(!blog.blocked){ %>
        <!-- Category & Metadata -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div class="flex items-center gap-3">
            <span class="rounded-full bg-[#0878E8]/10 px-4 py-1.5 text-sm font-semibold text-[#0878E8] dark:bg-blue-400/10 dark:text-blue-300">
              <%= blog.category %>
            </span>
            
            <!-- Author Info -->
            <div class="flex items-center text-slate-600 dark:text-slate-300 text-sm">
              <div class="mr-2 flex h-9 w-9 items-center justify-center overflow-hidden rounded-full bg-[#0878E8]/10 font-medium text-[#0878E8]">
                <% if (blog.author) { %>
                  <% if (blog.author.avatar) { %><img src="<%= blog.author.avatar %>" alt="" class="h-full w-full object-cover"><% } else { %><%= (blog.author.name || blog.author.username || 'U').charAt(0).toUpperCase() %><% } %>
                <% } else { %>
                  <i class="fas fa-user"></i>
                <% } %>
              </div>
              <div>
                <% if (blog.author) { %>
                  <span class="font-medium text-[#022E5A] dark:text-white">
                    <%= blog.author.name || blog.author.username || "Unnamed User" %>
                  </span>
                <% } else { %>
                  <span class="italic text-gray-500">Deleted User</span>
                <% } %>
                <div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                  <i class="far fa-clock mr-1"></i>
                  <% if(!blog.updatedAt){ %>
                    <%= new Date(blog.createdAt || Date.now()).toLocaleDateString('en-IN', {
                      timeZone: 'Asia/Kolkata', 
                      year: 'numeric', 
                      month: 'short', 
                      day: 'numeric'
                    }) %>
                  <% } else { %>
                    Updated <%= new Date(blog.updatedAt).toLocaleDateString('en-IN', {
                      timeZone: 'Asia/Kolkata', 
                      year: 'numeric', 
                      month: 'short', 
                      day: 'numeric'
                    }) %>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-2">
            <!-- Share Button -->
            <button onclick="openShareModal()" 
                    class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-[#022E5A] transition hover:border-[#0878E8] hover:text-[#0878E8] dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
              <i class="fas fa-share-alt"></i>
              <span class="hidden sm:inline">Share</span>
            </button>

            <!-- Download Button -->
            
          </div>
        </div>

        <section class="mb-8 grid items-center gap-6 rounded-3xl border border-slate-200/80 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6 <%= blog.image?.url ? 'lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]' : '' %> lg:gap-8">
          <% if(blog.image && blog.image.url){ %>
            <figure class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-[#FBFAF7] dark:border-slate-700 dark:bg-slate-950">
              <div class="flex h-52 items-center justify-center sm:h-64 lg:h-[300px]">
                <img
                  src="<%= blog.image.url %>"
                  alt="<%= blog.imageTitle || 'Blog image' %>"
                  class="h-full w-full object-contain"
                  loading="eager"
                  onerror="this.onerror=null;this.src='/images/logo.png';"
                >
              </div>
              <% if(blog.imageTitle){ %>
                <figcaption class="border-t border-slate-200 px-4 py-2 text-center text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400"><%= blog.imageTitle %></figcaption>
              <% } %>
            </figure>
          <% } %>
          <div class="min-w-0 py-1">
            <h1 class="text-3xl font-bold leading-tight text-[#022E5A] dark:text-white sm:text-4xl"><%= blog.title %></h1>
            <% if (blog.shortdescription) { %>
              <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-300"><%= blog.shortdescription %></p>
            <% } %>
            <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium text-slate-500 dark:text-slate-400">
              <span><i class="fa-regular fa-clock mr-1 text-[#0878E8]"></i><span id="blog-reading-time">Reading time</span></span>
              <span><i class="fa-regular fa-eye mr-1 text-[#0878E8]"></i><%= viewCount.toLocaleString("en-IN") %> views</span>
              <span><i class="fa-regular fa-comments mr-1 text-[#0878E8]"></i><%= (blog.comments || []).length.toLocaleString("en-IN") %> comments</span>
            </div>
          </div>
        </section>

        <div class="mb-8 flex flex-wrap items-center gap-2 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <% if (currUser) { %>
            <button type="button" data-blog-action="like" aria-pressed="<%= likedByMe %>" class="blog-engagement-button rounded-full border px-4 py-2 text-sm font-semibold">
              <i class="<%= likedByMe ? 'fa-solid' : 'fa-regular' %> fa-thumbs-up"></i> Like (<span class="blog-like-count"><%= blog.likes.length %></span>)
            </button>
            <button type="button" data-blog-action="save" aria-pressed="<%= savedByMe %>" class="blog-engagement-button rounded-full border px-4 py-2 text-sm font-semibold">
              <i class="<%= savedByMe ? 'fa-solid' : 'fa-regular' %> fa-bookmark"></i> <span><%= savedByMe ? "Saved" : "Save" %></span>
            </button>
          <% } else { %>
            <a href="/login" class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-[#0878E8] dark:border-slate-700">Log in to like or save</a>
          <% } %>
          <a href="#comments" class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-[#022E5A] dark:border-slate-700 dark:text-slate-100">
            <i class="fa-regular fa-comments"></i> Comments (<span><%= blog.comments.length %></span>)
          </a>
          <button type="button" onclick="openShareModal()" class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-[#022E5A] hover:border-[#0878E8] hover:text-[#0878E8] dark:border-slate-700 dark:text-slate-100">
            <i class="fa-solid fa-share-nodes"></i> Share
          </button>
        </div>

        <!-- Blog Content -->
        <div class="mb-12 grid gap-6 lg:grid-cols-[minmax(0,1fr)_280px] lg:items-start">
        <article id="blog-article" class="min-w-0">
          <div id="blog-article-content" class="blog-rich-content rounded-3xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-8">
            <% 
              const hasHTML = /<\/?[a-z][\s\S]*>/i.test(blog.content);
            %>
            <% if (hasHTML) { %>
              <div class="leading-relaxed">
                <%- blog.content %>
              </div>
            <% } else { %>
              <div class="leading-relaxed whitespace-pre-line">
                <%- blog.content.replace(/\n/g, '<br>') %>
              </div>
            <% } %>
          </div>
        </article>
        <aside class="space-y-4 lg:sticky lg:top-24">
          <details id="blog-toc-panel" open class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <summary class="cursor-pointer list-none text-sm font-bold text-[#022E5A] marker:hidden dark:text-white">
              <span class="flex items-center justify-between gap-3">
                <span class="flex items-center gap-2"><i class="fa-solid fa-list-ul text-[#0878E8]"></i> In this article</span>
                <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
              </span>
            </summary>
            <nav id="blog-toc" aria-label="Table of contents" class="mt-4 space-y-1 border-t border-slate-100 pt-3 dark:border-slate-800"></nav>
          </details>
          <div class="rounded-2xl border border-blue-200 bg-blue-50 p-5 dark:border-blue-900 dark:bg-blue-950/40">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white text-blue-700 dark:bg-slate-900 dark:text-blue-300"><i class="fa-solid fa-book-open"></i></span>
            <h3 class="mt-4 font-semibold text-[#022E5A] dark:text-white">Find notes for your next exam</h3>
            <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">Browse notes and study material shared by students.</p>
            <a href="/notes" class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#0878E8] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#0668CC]">
              Browse notes <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
          </div>
        </aside>
        </div>

        <div class="mb-8 flex flex-wrap items-center gap-3 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <% if (currUser) { %>
            <button type="button" data-blog-action="like" aria-pressed="<%= likedByMe %>" class="blog-engagement-button rounded-full border px-4 py-2 text-sm font-semibold">
              <i class="<%= likedByMe ? 'fa-solid' : 'fa-regular' %> fa-thumbs-up"></i> Like (<span class="blog-like-count"><%= blog.likes.length %></span>)
            </button>
            <button type="button" data-blog-action="save" aria-pressed="<%= savedByMe %>" class="blog-engagement-button rounded-full border px-4 py-2 text-sm font-semibold">
              <i class="<%= savedByMe ? 'fa-solid' : 'fa-regular' %> fa-bookmark"></i> <span><%= savedByMe ? "Saved" : "Save" %></span>
            </button>
          <% } else { %>
            <a href="/login" class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-[#0878E8] dark:border-slate-700">Log in to like or save</a>
          <% } %>
          <a href="#comments" class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-[#022E5A] dark:border-slate-700 dark:text-slate-100">
            <i class="fa-regular fa-comments"></i> Comments (<%= blog.comments.length %>)
          </a>
          <button type="button" onclick="openShareModal()" class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-[#022E5A] hover:border-[#0878E8] hover:text-[#0878E8] dark:border-slate-700 dark:text-slate-100">
            <i class="fa-solid fa-share-nodes"></i> Share
          </button>
        </div>

        <!-- Author Actions -->
        <% if(currUser && blog.author && currUser._id.equals(blog.author._id)){ %>
          <div class="flex flex-wrap gap-3 mb-8 p-6 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl border border-blue-100">
            <div class="flex-1">
              <h4 class="font-semibold text-gray-800 mb-1">Blog Owner Controls</h4>
              <p class="text-sm text-gray-600">Manage your blog post</p>
            </div>
            <div class="flex gap-3">
              <a href="/blogs/<%= blog._id %>/edit" 
                 class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-blue-300 text-blue-700 rounded-xl hover:bg-blue-50 transition-colors shadow-sm">
                <i class="fas fa-edit"></i>
                Edit
              </a>
              <button type="button" 
                      onclick="openDeleteModal()"
                      class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-xl hover:from-red-600 hover:to-red-700 transition-colors shadow-sm">
                <i class="fas fa-trash-alt"></i>
                Delete
              </button>
            </div>
          </div>
        <% } %>

        <!-- Comments Section -->
        <div class="space-y-10">
          <!-- Comment Form -->
          <% if(currUser){ %>
            <div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 border border-gray-100">
              <h3 class="mb-6 text-2xl font-bold text-[#022E5A] dark:text-white">Leave a Comment</h3>
              <form action="/blogs/<%= blog._id %>/comments" method="POST" class="space-y-4">
                <div>
                  <textarea 
                    name="text" 
                    rows="4" 
                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 transition-colors focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
                    placeholder="Share your thoughts, insights, or feedback..."
                    required
                  ></textarea>
                </div>
                <button type="submit" 
                        class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-medium rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all duration-300 shadow-lg hover:shadow-xl">
                  <i class="fas fa-paper-plane"></i>
                  Post Comment
                </button>
              </form>
            </div>
          <% } else { %>
            <div class="bg-gradient-to-r from-yellow-50 to-amber-50 border border-yellow-200 rounded-2xl p-6">
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <i class="fas fa-comment-alt text-yellow-600 text-2xl"></i>
                </div>
                <div class="ml-4">
                  <h3 class="text-lg font-semibold text-yellow-800">Join the Conversation</h3>
                  <p class="text-yellow-700 mt-1">
                    Please <a href="/login" class="font-medium text-blue-600 hover:text-blue-800">log in</a> or 
                    <a href="/signup" class="font-medium text-blue-600 hover:text-blue-800">create an account</a> 
                    to leave a comment and engage with the community.
                  </p>
                </div>
              </div>
            </div>
          <% } %>

          <!-- Comments List -->
          <div id="comments" class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-8">
            <div class="flex items-center justify-between mb-8">
              <h3 class="text-2xl font-bold text-[#022E5A] dark:text-white">
                <i class="far fa-comments mr-2 text-[#0878E8]"></i>
                Comments (<%= blog.comments.length %>)
              </h3>
              <% if (blog.comments.length > 0) { %>
                <span class="text-sm text-slate-500 dark:text-slate-400">
                  Sorted by: <span class="font-medium text-slate-700 dark:text-slate-200">Newest</span>
                </span>
              <% } %>
            </div>

            <% if (blog.comments.length === 0) { %>
              <div class="text-center py-12">
                <div class="inline-block p-6 bg-gray-100 rounded-2xl mb-4">
                  <i class="fas fa-comment-slash text-4xl text-gray-400"></i>
                </div>
                <h4 class="text-xl font-semibold text-gray-700 mb-2">No comments yet</h4>
                <p class="text-gray-600 max-w-md mx-auto">
                  Be the first to share your thoughts and start the discussion.
                </p>
              </div>
            <% } else { %>
              <div class="space-y-6">
                <% comments.forEach(comment => { %>
                  <div class="group rounded-2xl border border-slate-200 bg-slate-50 p-5 transition-colors hover:border-[#0878E8]/40 hover:bg-white dark:border-slate-800 dark:bg-slate-950 dark:hover:bg-slate-900 sm:p-6">
                    <div class="flex items-start justify-between mb-4">
                      <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#0878E8]/10 font-medium text-[#0878E8] dark:bg-blue-400/10 dark:text-blue-300">
                          <% if (comment.user) { %>
                            <%= (comment.user.name || comment.user.username || 'U').charAt(0).toUpperCase() %>
                          <% } else { %>
                            <i class="fas fa-user"></i>
                          <% } %>
                        </div>
                        <div>
                          <h5 class="font-semibold text-[#022E5A] dark:text-white">
                            <% if (comment.user) { %>
                              <%= comment.user.name || comment.user.username || "Unnamed User" %>
                            <% } else { %>
                              <span class="italic text-slate-500">Deleted User</span>
                            <% } %>
                          </h5>
                          <div class="flex items-center text-sm text-slate-500 dark:text-slate-400">
                            <i class="far fa-clock mr-1"></i>
                            <%= new Date(comment.createdAt).toLocaleString('en-IN', { 
                              timeZone: 'Asia/Kolkata',
                              dateStyle: 'medium',
                              timeStyle: 'short'
                            }) %>
                          </div>
                        </div>
                      </div>
                      
                      <% if(currUser && comment.user && currUser._id.equals(comment.user._id)){ %>
                        <form action="/blogs/<%= blog._id %>/comments/<%= comment._id %>?_method=DELETE" 
                              method="POST"
                              onsubmit="return confirm('Are you sure you want to delete this comment?');">
                          <button type="submit" aria-label="Delete comment"
                                  class="rounded-lg px-2 py-1 text-red-500 transition hover:bg-rose-50 hover:text-red-700 dark:hover:bg-rose-400/10">
                            <i class="fas fa-trash-alt"></i>
                          </button>
                        </form>
                      <% } %>
                    </div>
                    
                    <div class="whitespace-pre-line leading-relaxed text-slate-700 dark:text-slate-300">
                      <%= comment.text %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Related Blogs -->
        <% if (relatedBlogs && relatedBlogs.length > 0) { %>
          <div class="mt-16">
            <div class="flex items-center justify-between mb-8">
              <div>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">
                  More in "<%= blog.category %>"
                </h3>
                <p class="text-gray-600">
                  Explore related blogs in this category
                </p>
              </div>
              <a href="/blogs?category=<%= blog.category %>" 
                 class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium">
                View All
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <% relatedBlogs.forEach(relatedBlog => { %>
                <div class="group bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                  <div class="flex flex-col md:flex-row">
                    <!-- Image -->
                    <div class="md:w-2/5">
                      <img 
                        src="<%= (relatedBlog.image && relatedBlog.image.url) ? relatedBlog.image.url : '/images/default-blog.jpg' %>"
                        alt="<%= relatedBlog.title %>"
                        class="w-full h-48 md:h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      >
                    </div>
                    
                    <!-- Content -->
                    <div class="md:w-3/5 p-6 flex flex-col">
                      <div class="flex-1">
                        <span class="inline-block px-3 py-1 bg-blue-50 text-blue-600 text-xs font-semibold rounded-full mb-3">
                          <%= relatedBlog.category %>
                        </span>
                        <h4 class="text-lg font-bold text-gray-800 mb-3 line-clamp-2 group-hover:text-blue-600 transition-colors">
                          <a href="/blogs/<%= relatedBlog.id && relatedBlog.id.trim() !== '' ? relatedBlog.id : relatedBlog._id %>">
                            <%= relatedBlog.title %>
                          </a>
                        </h4>
                        <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                          <%= relatedBlog.shortdescription && relatedBlog.shortdescription.length > 120 
                              ? relatedBlog.shortdescription.substring(0, 120) + '...' 
                              : relatedBlog.shortdescription || 'No description available.' %>
                        </p>
                      </div>
                      
                      <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                        <div class="flex items-center text-sm text-gray-600">
                          <div class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 text-xs mr-2">
                            <% if (relatedBlog.author) { %>
                              <%= (relatedBlog.author.name || relatedBlog.author.username || 'A').charAt(0).toUpperCase() %>
                            <% } else { %>
                              <i class="fas fa-user"></i>
                            <% } %>
                          </div>
                          <span class="text-gray-700">
                            <%= relatedBlog.author?.name || relatedBlog.author?.username || 'Unknown Author' %>
                          </span>
                        </div>
                        
                        <a href="/blogs/<%= relatedBlog.id && relatedBlog.id.trim() !== '' ? relatedBlog.id : relatedBlog._id %>" 
                           class="text-sm font-medium text-blue-600 hover:text-blue-800 flex items-center gap-1">
                          Read
                          <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>
<% } else { %>
  <!-- Blog Not Found -->
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-b from-gray-50 to-white">
    <div class="text-center px-4">
      <div class="inline-block p-6 bg-gradient-to-r from-red-100 to-red-50 rounded-2xl mb-6">
        <i class="fas fa-exclamation-triangle text-5xl text-red-500"></i>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Blog Not Found</h1>
      <p class="text-gray-600 max-w-md mx-auto mb-8">
        The blog you are looking for does not exist or has been deleted.
      </p>
      <a href="/blogs" 
         class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-medium rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all duration-300">
        <i class="fas fa-arrow-left mr-2"></i>
        Back to Blogs
      </a>
    </div>
  </div>
<% } %>


<!-- JavaScript -->
<script>
// Share Modal Functions
function openShareModal() {
  const modal = document.getElementById('shareModal');
  if (!modal) return;
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  document.body.style.overflow = 'hidden';
}

function closeShareModal() {
  const modal = document.getElementById('shareModal');
  if (!modal) return;
  modal.classList.add('hidden');
  modal.classList.remove('flex');
  document.body.style.overflow = '';
}

// Delete Modal Functions
function openDeleteModal() {
  document.getElementById('deleteModal<%= blog._id %>').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function closeDeleteModal() {
  document.getElementById('deleteModal<%= blog._id %>').classList.add('hidden');
  document.body.style.overflow = 'auto';
}

// Copy to Clipboard
function copyToClipboard() {
  const url = document.getElementById('shareUrl')?.value || window.location.href;
  const copyBtn = document.getElementById('copyBtn');
  
  navigator.clipboard.writeText(url).then(() => {
    if (!copyBtn) return;
    copyBtn.innerHTML = '<i class="fas fa-check"></i> Link copied';
    setTimeout(() => {
      copyBtn.innerHTML = '<i class="far fa-copy"></i> Copy article link';
    }, 2000);
  }).catch(err => {
    console.error('Failed to copy: ', err);
    const input = document.getElementById('shareUrl');
    if (input) {
      input.focus();
      input.select();
      document.execCommand('copy');
    }
  });
}

// Close modals on Escape key
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeShareModal();
    closeDeleteModal();
  }
});

// Close modals when clicking outside
document.addEventListener('click', (e) => {
  const shareModal = document.getElementById('shareModal');
  const deleteModal = document.getElementById('deleteModal<%= blog._id %>');
  
  if (shareModal && !shareModal.classList.contains('hidden') && e.target === shareModal) {
    closeShareModal();
  }
  
  if (deleteModal && !deleteModal.classList.contains('hidden') && e.target === deleteModal) {
    closeDeleteModal();
  }
});

// Generate navigation for headings authored in the blog content.
(function buildBlogNavigation() {
  const content = document.getElementById("blog-article-content");
  const navigation = document.getElementById("blog-toc");
  const panel = document.getElementById("blog-toc-panel");
  if (!content || !navigation || !panel) return;

  const headings = Array.from(content.querySelectorAll("h2, h3, h4"))
    .filter((heading) => heading.textContent.trim());
  if (!headings.length) {
    panel.hidden = true;
    panel.classList.add("hidden");
  } else {
    const usedIds = new Set();
    headings.forEach((heading, index) => {
      const base = (heading.id || heading.textContent)
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "") || `section-${index + 1}`;
      let id = base;
      let suffix = 2;
      while (usedIds.has(id) || (document.getElementById(id) && document.getElementById(id) !== heading)) {
        id = `${base}-${suffix++}`;
      }
      heading.id = id;
      heading.style.scrollMarginTop = "6rem";
      usedIds.add(id);

      const link = document.createElement("a");
      link.href = `#${id}`;
      link.textContent = heading.textContent.trim();
      link.className = `blog-toc-link block rounded-lg px-3 py-2 text-sm leading-5 text-slate-600 transition hover:bg-blue-50 hover:text-[#0878E8] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-blue-300 ${heading.tagName.toLowerCase() === "h2" ? "font-semibold" : "ml-3 text-[13px]"}`;
      navigation.appendChild(link);
    });

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navigation.querySelectorAll("a").forEach((link) => link.removeAttribute("aria-current"));
          const activeLink = navigation.querySelector(`a[href="#${entry.target.id}"]`);
          if (activeLink) activeLink.setAttribute("aria-current", "location");
        });
      }, { rootMargin: "-15% 0px -75% 0px" });
      headings.forEach((heading) => observer.observe(heading));
    }
  }

  const text = content.innerText || content.textContent || "";
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  const readingTime = document.getElementById("blog-reading-time");
  if (readingTime) readingTime.textContent = `${Math.max(1, Math.ceil(words / 220))} min read`;
})();

// Prevent multiple form submissions
document.querySelectorAll('form').forEach(form => {
  form.addEventListener('submit', function(e) {
    const submitBtn = this.querySelector('button[type="submit"]');
    if (submitBtn && submitBtn.classList.contains('submitting')) {
      e.preventDefault();
      return;
    }
    
    if (submitBtn) {
      submitBtn.classList.add('submitting');
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Processing...';
    }
  });
});
</script>

