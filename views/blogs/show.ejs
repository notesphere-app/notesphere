<script>
  (function () {
    var blogId = "<%= blog._id %>";
    function send(action) {
      return fetch("/blogs/" + blogId + "/" + action, {
        method: "POST",
        headers: { Accept: "application/json" },
        credentials: "same-origin"
      }).then(function (response) {
        return response.json().then(function (result) {
          if (!response.ok) throw new Error(result.message || "Please sign in and try again.");
          return result;
        });
      });
    }
    document.querySelectorAll("[data-blog-action]").forEach(function (button) {
      button.addEventListener("click", function () {
        var action = button.dataset.blogAction;
        var actionButtons = Array.from(document.querySelectorAll('[data-blog-action="' + action + '"]'));
        actionButtons.forEach(function (item) { item.disabled = true; });
        send(action).then(function (result) {
          var active = action === "like" ? result.liked : result.saved;
          actionButtons.forEach(function (item) {
            item.setAttribute("aria-pressed", String(active));
            var icon = item.querySelector("i");
            if (icon) {
              icon.classList.toggle("fa-solid", active);
              icon.classList.toggle("fa-regular", !active);
            }
            if (action === "save") {
              var label = item.querySelector("span");
              if (label) label.textContent = active ? "Saved" : "Save";
            }
            if (action === "like") {
              var count = item.querySelector(".blog-like-count");
              if (count) count.textContent = String(result.count);
            }
          });
        }).catch(function (error) {
          window.alert(error.message);
        }).finally(function () {
          actionButtons.forEach(function (item) { item.disabled = false; });
        });
      });
    });
  })();
</script>