<% layout("layouts/boilerplate") %>
<%
  const displayName = user.name || user.username || "NoteSphere student";
  const initials = displayName.trim().charAt(0).toUpperCase() || "N";
  const loginHistory = (user.loginHistory || []).slice().reverse();
%>

<main class="min-h-screen bg-slate-50 py-8 dark:bg-slate-950 sm:py-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#022E5A] via-[#06447F] to-[#0878E8] p-6 text-white shadow-xl sm:p-9">
      <div class="pointer-events-none absolute -right-12 -top-20 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
      <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex min-w-0 items-center gap-4 sm:gap-5">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-white text-2xl font-bold text-blue-700 shadow-lg sm:h-20 sm:w-20 sm:text-3xl">
            <%= initials %>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-medium text-blue-100">Your NoteSphere account</p>
            <h1 class="mt-1 truncate text-2xl font-bold sm:text-3xl"><%= displayName %></h1>
            <p class="mt-1 break-all text-sm text-blue-100"><%= user.email || "" %></p>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold"><%= user.role || "student" %></span>
              <span class="rounded-full px-3 py-1 text-xs font-semibold <%= user.isVerified ? 'bg-emerald-300/20 text-emerald-100' : 'bg-amber-300/20 text-amber-100' %>">
                <i class="fa-solid <%= user.isVerified ? 'fa-circle-check' : 'fa-clock' %> mr-1"></i><%= user.isVerified ? "Verified account" : "Email not verified" %>
              </span>
            </div>
          </div>
        </div>
        <button type="button" id="profile-edit-open" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-[#022E5A] transition hover:bg-blue-50">
          <i class="fa-solid fa-pen"></i> Edit profile
        </button>
      </div>
    </section>

    <section class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Account overview">
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-sm text-slate-500 dark:text-slate-400">Notes shared</p>
        <p class="mt-2 text-3xl font-bold text-slate-900 dark:text-white"><%= noteCount %></p>
        <a href="/notes/mine" class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-blue-700 hover:underline dark:text-blue-300">Manage my notes <i class="fa-solid fa-arrow-right text-xs"></i></a>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-sm text-slate-500 dark:text-slate-400">Published notes</p>
        <p class="mt-2 text-3xl font-bold text-emerald-600 dark:text-emerald-400"><%= publishedNoteCount %></p>
        <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Approved and visible in the library</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-sm text-slate-500 dark:text-slate-400">University</p>
        <p class="mt-2 break-words text-lg font-bold text-slate-900 dark:text-white"><%= user.university || "Not added" %></p>
        <p class="mt-1 break-words text-sm text-slate-500 dark:text-slate-400"><%= user.college || "Add your college in profile settings" %></p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-sm text-slate-500 dark:text-slate-400">Member since</p>
        <p class="mt-2 text-lg font-bold text-slate-900 dark:text-white"><%= moment(user.createdAt).format("MMM D, YYYY") %></p>
        <a href="/notes" class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-blue-700 hover:underline dark:text-blue-300">Browse notes <i class="fa-solid fa-arrow-right text-xs"></i></a>
      </article>
    </section>

    <section class="mt-6 grid gap-6 lg:grid-cols-2">
      <article id="saved-notes" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-blue-700 dark:text-blue-300">Your collection</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">Saved notes</h2>
          </div>
          <i class="fa-regular fa-bookmark text-xl text-blue-600 dark:text-blue-300"></i>
        </div>
        <% if (user.savedNotes?.length) { %>
          <ul class="mt-5 divide-y divide-slate-100 dark:divide-slate-800">
            <% user.savedNotes.forEach(function (note) { %>
              <li class="py-3 first:pt-0 last:pb-0">
                <a href="/notes/<%= note._id %>" class="flex items-center justify-between gap-3 text-sm font-semibold text-slate-800 hover:text-blue-700 dark:text-slate-200 dark:hover:text-blue-300">
                  <span class="min-w-0 truncate"><%= note.title %><span class="ml-2 font-normal text-slate-500">· <%= note.course %></span></span>
                  <i class="fa-solid fa-arrow-up-right-from-square shrink-0 text-xs"></i>
                </a>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="mt-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-500 dark:bg-slate-800 dark:text-slate-400">Notes you bookmark will be collected here.</p>
        <% } %>
      </article>

      <article id="saved-blogs" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-700 dark:text-violet-300">Read it later</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">Saved articles</h2>
          </div>
          <i class="fa-regular fa-bookmark text-xl text-violet-600 dark:text-violet-300"></i>
        </div>
        <% if (user.savedBlogs?.length) { %>
          <ul class="mt-5 divide-y divide-slate-100 dark:divide-slate-800">
            <% user.savedBlogs.forEach(function (blog) { %>
              <li class="py-3 first:pt-0 last:pb-0">
                <a href="/blogs/<%= blog.id || blog._id %>" class="flex items-center justify-between gap-3 text-sm font-semibold text-slate-800 hover:text-blue-700 dark:text-slate-200 dark:hover:text-blue-300">
                  <span class="min-w-0 truncate"><%= blog.title %></span><i class="fa-solid fa-arrow-up-right-from-square shrink-0 text-xs"></i>
                </a>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="mt-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-500 dark:bg-slate-800 dark:text-slate-400">Articles you save will be collected here.</p>
        <% } %>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700 dark:text-emerald-300">Learning activity</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">Recent downloads</h2>
          </div>
          <i class="fa-solid fa-download text-xl text-emerald-600 dark:text-emerald-300"></i>
        </div>
        <% if (recentActivity.length) { %>
          <ul class="mt-5 space-y-3">
            <% recentActivity.forEach(function (activity) { %>
              <li class="flex items-start gap-3 rounded-xl bg-slate-50 p-3 dark:bg-slate-800">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300"><i class="fa-solid fa-arrow-down"></i></span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium text-slate-800 dark:text-slate-200"><%= activity.description %></span>
                  <time class="mt-1 block text-xs text-slate-500 dark:text-slate-400"><%= moment(activity.createdAt).fromNow() %></time>
                </span>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="mt-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-500 dark:bg-slate-800 dark:text-slate-400">Notes you open will appear here.</p>
        <% } %>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-amber-700 dark:text-amber-300">Account security</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">Recent sign-ins</h2>
          </div>
          <i class="fa-solid fa-shield-halved text-xl text-amber-600 dark:text-amber-300"></i>
        </div>
        <% if (loginHistory.length) { %>
          <ul class="mt-5 space-y-3">
            <% loginHistory.forEach(function (entry) { %>
              <li class="flex items-center justify-between gap-3 rounded-xl bg-slate-50 p-3 dark:bg-slate-800">
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-slate-800 dark:text-slate-200"><%= entry.method === "google" ? "Google sign-in" : "Email sign-in" %></span>
                  <span class="mt-1 block text-xs text-slate-500 dark:text-slate-400"><%= entry.device || "Device not specified" %></span>
                </span>
                <time class="shrink-0 text-right text-xs text-slate-500 dark:text-slate-400"><%= moment(entry.loggedInAt).format("MMM D, YYYY") %><br><%= moment(entry.loggedInAt).format("h:mm A") %></time>
              </li>
            <% }); %>
          </ul>
          <p class="mt-3 text-xs leading-5 text-slate-500 dark:text-slate-400">Only your 10 most recent sign-ins are retained.</p>
        <% } else { %>
          <p class="mt-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-500 dark:bg-slate-800 dark:text-slate-400">Recent sign-ins will appear here.</p>
        <% } %>
      </article>
    </section>

    <section class="mt-6 flex flex-col gap-4 rounded-2xl border border-blue-200 bg-blue-50 p-5 dark:border-blue-900 dark:bg-blue-950/40 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div>
        <h2 class="font-bold text-slate-900 dark:text-white">Have notes to share?</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Your uploads are reviewed before they are listed publicly.</p>
      </div>
      <a href="/notes/new" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-blue-600 px-5 py-3 text-sm font-semibold text-white hover:bg-blue-700"><i class="fa-solid fa-plus"></i> Share notes</a>
    </section>
  </div>
</main>

<div id="profile-edit-modal" class="fixed inset-0 z-[120] hidden items-center justify-center bg-slate-950/60 p-4" role="dialog" aria-modal="true" aria-labelledby="profile-edit-title">
  <section class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl dark:bg-slate-900 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <div><p class="text-xs font-semibold uppercase tracking-widest text-blue-700">Account settings</p><h2 id="profile-edit-title" class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">Edit profile</h2></div>
      <button type="button" id="profile-edit-close" aria-label="Close edit profile" class="flex h-9 w-9 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form id="profile-edit-form" action="/profile/update" method="POST" class="mt-6 space-y-4">
      <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Full name
        <input name="name" required maxlength="100" value="<%= user.name || '' %>" class="mt-1 w-full rounded-xl border border-slate-300 bg-transparent px-4 py-3 dark:border-slate-700">
      </label>
      <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">University
        <input name="university" maxlength="160" value="<%= user.university || '' %>" class="mt-1 w-full rounded-xl border border-slate-300 bg-transparent px-4 py-3 dark:border-slate-700">
      </label>
      <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">College
        <input name="college" maxlength="160" value="<%= user.college || '' %>" class="mt-1 w-full rounded-xl border border-slate-300 bg-transparent px-4 py-3 dark:border-slate-700">
      </label>
      <p id="profile-edit-message" class="hidden text-sm" role="status" aria-live="polite"></p>
      <div class="flex justify-end gap-3 pt-2">
        <button type="button" id="profile-edit-cancel" class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold dark:border-slate-700">Cancel</button>
        <button type="submit" id="profile-edit-submit" class="rounded-full bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Save changes</button>
      </div>
    </form>
  </section>
</div>

<script>
  (function () {
    var modal = document.getElementById("profile-edit-modal");
    var openButton = document.getElementById("profile-edit-open");
    var form = document.getElementById("profile-edit-form");
    var message = document.getElementById("profile-edit-message");
    var submitButton = document.getElementById("profile-edit-submit");
    if (!modal || !openButton || !form || !message || !submitButton) return;

    function openModal() {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      form.querySelector("input[name='name']").focus();
    }
    function closeModal() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    }
    function showMessage(text, success) {
      message.textContent = text;
      message.classList.remove("hidden", "text-rose-600", "text-emerald-600");
      message.classList.add(success ? "text-emerald-600" : "text-rose-600");
    }

    openButton.addEventListener("click", openModal);
    document.getElementById("profile-edit-close").addEventListener("click", closeModal);
    document.getElementById("profile-edit-cancel").addEventListener("click", closeModal);
    modal.addEventListener("click", function (event) {
      if (event.target === modal) closeModal();
    });
    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
    });
    form.addEventListener("submit", async function (event) {
      event.preventDefault();
      submitButton.disabled = true;
      try {
        var response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        var result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message || "Could not update your profile.");
        showMessage("Your profile was updated.", true);
        window.setTimeout(function () { window.location.reload(); }, 500);
      } catch (error) {
        showMessage(error.message || "Could not update your profile.", false);
        submitButton.disabled = false;
      }
    });
  })();
</script>
