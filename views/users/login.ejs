<% layout("/layouts/boilerplate") -%>
<%
  const prefilledEmail = (typeof email !== "undefined" && email) ? email : "";
%>

<section class="relative flex min-h-[calc(100vh-4rem)] items-center justify-center overflow-hidden bg-[#FBFAF7] px-4 py-12 dark:bg-slate-950 sm:py-16">

  <!-- Soft radial glows (same as home) -->
  <div class="pointer-events-none absolute -top-32 -left-24 h-72 w-72 rounded-full bg-[#0878E8]/10 blur-3xl sm:-left-32 sm:h-96 sm:w-96"></div>
  <div class="pointer-events-none absolute -bottom-40 -right-24 h-72 w-72 rounded-full bg-amber-400/10 blur-3xl sm:-right-32 sm:h-96 sm:w-96"></div>

  <div class="relative mx-auto grid w-full max-w-5xl gap-10 lg:grid-cols-2 lg:gap-16 lg:items-center">

    <!-- =========================================
         LEFT: Marketing side (desktop only)
    ========================================= -->
    <div class="hidden lg:block">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#0878E8]/25 bg-[#0878E8]/5 px-3 py-1 text-sm font-medium text-[#0878E8]">
        <i class="fa-solid fa-feather-pointed"></i> Welcome back
      </span>

      <h1 class="mt-5 text-4xl font-bold leading-tight text-[#022E5A] dark:text-white">
        Your notes are waiting
      </h1>

      <p class="mt-4 max-w-md text-base text-slate-600 dark:text-slate-300">
        Sign back in to pick up where you left off — your saved notes, uploads, and history are all exactly where you left them.
      </p>

      <ul class="mt-8 space-y-3 text-sm text-slate-700 dark:text-slate-300">
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
            <i class="fa-solid fa-check text-[10px]"></i>
          </span>
          Access 24,600+ free notes across 42+ courses
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
            <i class="fa-solid fa-check text-[10px]"></i>
          </span>
          Save notes to your personal library
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
            <i class="fa-solid fa-check text-[10px]"></i>
          </span>
          Track your uploads and downloads
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
            <i class="fa-solid fa-check text-[10px]"></i>
          </span>
          No ads, no tracking, no spam
        </li>
      </ul>
    </div>

    <!-- =========================================
         RIGHT: Login card
    ========================================= -->
    <div class="w-full">
      <div class="rounded-3xl bg-white p-7 shadow-xl ring-1 ring-slate-200/70 dark:bg-slate-900 dark:ring-slate-800 sm:p-9">

        <!-- Header -->
        <div class="mb-7">
          <h2 class="font-script text-3xl leading-none text-[#022E5A] dark:text-white">
            Welcome back
          </h2>
          <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
            Sign in to your NoteSphere account to continue.
          </p>
        </div>

        <!-- Form -->
        <form id="loginForm" action="/login" method="POST" class="space-y-5" novalidate>

          <!-- Email -->
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-slate-600 dark:text-slate-300">
              Email
            </label>
            <div class="relative">
              <i class="fa-regular fa-envelope pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                value="<%= prefilledEmail %>"
                placeholder="you@college.edu"
                class="w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-900 placeholder-slate-400
                       transition-colors
                       focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/25
                       dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder-slate-500"
              />
            </div>
          </div>

          <!-- Password -->
          <div>
            <div class="mb-1.5 flex items-center justify-between">
              <label for="password" class="block text-sm font-medium text-slate-600 dark:text-slate-300">
                Password
              </label>
              <a href="/forgot-password" class="text-xs font-medium text-[#0878E8] hover:underline">
                Forgot?
              </a>
            </div>
            <div class="relative">
              <i class="fa-solid fa-lock pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                placeholder="Your password"
                class="w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-10 pr-10 text-sm text-slate-900 placeholder-slate-400
                       transition-colors
                       focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/25
                       dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder-slate-500"
              />
              <button type="button" id="togglePassword" aria-label="Show password"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 transition-colors hover:text-[#0878E8]">
                <i id="passwordIcon" class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <!-- Remember me -->
          <div class="flex items-center gap-2">
            <input
              id="remember"
              name="remember"
              type="checkbox"
              checked
              class="h-4 w-4 rounded border-slate-300 text-[#0878E8] focus:ring-[#0878E8] dark:border-slate-600 dark:bg-slate-800"
            />
            <label for="remember" class="text-xs text-slate-600 dark:text-slate-300">
              Keep me signed in for 30 days
            </label>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="loginButton"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#0878E8] py-2.5 text-sm font-semibold text-white
                   transition-all hover:bg-[#0668CC] hover:shadow-md
                   focus:outline-none focus:ring-2 focus:ring-[#0878E8] focus:ring-offset-2
                   disabled:cursor-not-allowed disabled:opacity-70
                   dark:focus:ring-offset-slate-900"
          >
            <span id="buttonText" class="inline-flex items-center gap-2">
              <i class="fa-solid fa-right-to-bracket"></i> Log in
            </span>
            <span id="buttonLoader" class="hidden items-center gap-2">
              <i class="fa-solid fa-circle-notch fa-spin"></i> Signing in…
            </span>
          </button>
        </form>

        <!-- Divider -->
        <div class="my-6 flex items-center gap-3">
          <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>
          <span class="text-[11px] font-semibold uppercase tracking-widest text-slate-400">or</span>
          <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>
        </div>

        <!-- Google sign-in -->
        <a href="/auth/google"
           class="oauth-btn flex w-full items-center justify-center gap-2 rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium
                  text-slate-700 transition-colors hover:bg-slate-50
                  dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
          <img src="https://www.google.com/favicon.ico" alt="Google" class="h-4 w-4">
          Continue with Google
        </a>

        <!-- Sign up -->
        <p class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
          New to NoteSphere?
          <a href="/signup" class="font-semibold text-[#0878E8] hover:underline">Create an account</a>
        </p>

      </div>

      <p class="mt-6 text-center text-xs text-slate-400">
        By signing in you agree to our
        <a href="/terms" class="text-[#0878E8] hover:underline">Terms</a> and
        <a href="/privacy" class="text-[#0878E8] hover:underline">Privacy Policy</a>.
      </p>
    </div>

  </div>
</section>

<!-- =========================================
     Page-specific styles
========================================= -->
<style>
  .font-script { font-family: 'Lora', serif; font-style: italic; font-weight: 600; }

  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus,
  input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px #fff inset !important;
    box-shadow: 0 0 0 30px #fff inset !important;
    -webkit-text-fill-color: #0f172a !important;
    transition: background-color 5000s ease-in-out 0s;
  }
  .dark input:-webkit-autofill,
  .dark input:-webkit-autofill:hover,
  .dark input:-webkit-autofill:focus,
  .dark input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px #0f172a inset !important;
    box-shadow: 0 0 0 30px #0f172a inset !important;
    -webkit-text-fill-color: #e2e8f0 !important;
  }

  .oauth-btn {
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .oauth-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -6px rgba(8, 120, 232, 0.25);
  }
</style>

<!-- =========================================
     Page-specific scripts
========================================= -->
<script>
  (function () {
    const form = document.getElementById("loginForm");
    const btn = document.getElementById("loginButton");
    const btnText = document.getElementById("buttonText");
    const btnLoader = document.getElementById("buttonLoader");
    const passwordEl = document.getElementById("password");
    const toggleBtn = document.getElementById("togglePassword");
    const toggleIcon = document.getElementById("passwordIcon");

    /* ---------- Password show/hide ---------- */
    toggleBtn?.addEventListener("click", function () {
      const isPassword = passwordEl.type === "password";
      passwordEl.type = isPassword ? "text" : "password";
      toggleIcon.classList.toggle("fa-eye", !isPassword);
      toggleIcon.classList.toggle("fa-eye-slash", isPassword);
      toggleIcon.classList.toggle("text-[#0878E8]", isPassword);
    });

    /* ---------- Loading state ---------- */
    function setLoading(on) {
      if (on) {
        btnText.classList.add("hidden");
        btnLoader.classList.remove("hidden");
        btnLoader.classList.add("inline-flex");
        btn.disabled = true;
      } else {
        btnText.classList.remove("hidden");
        btnLoader.classList.add("hidden");
        btnLoader.classList.remove("inline-flex");
        btn.disabled = false;
      }
    }

    /* ---------- Submit — let the browser POST, just show loading ---------- */
    form?.addEventListener("submit", function () {
      // Don't preventDefault — we want a normal POST so server-side
      // flash + redirect work exactly as they do today.
      setLoading(true);
    });

    /* ---------- Auto-focus email + prefill from ?email= ---------- */
    document.addEventListener("DOMContentLoaded", function () {
      const emailEl = document.getElementById("email");
      const params = new URLSearchParams(window.location.search);
      const emailParam = params.get("email");
      if (emailParam && emailEl && !emailEl.value) {
        emailEl.value = emailParam;
        passwordEl?.focus();
      } else {
        emailEl?.focus();
      }
    });
  })();
</script>