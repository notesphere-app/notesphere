<% layout("/layouts/boilerplate") -%>

<section class="relative flex min-h-[calc(100vh-4rem)] items-center justify-center overflow-hidden bg-[#FBFAF7] px-4 py-12 dark:bg-slate-950 sm:py-16">

  <!-- Soft radial glows (same as home) -->
  <div class="pointer-events-none absolute -top-32 -left-24 h-72 w-72 rounded-full bg-[#0878E8]/10 blur-3xl sm:-left-32 sm:h-96 sm:w-96"></div>
  <div class="pointer-events-none absolute -bottom-40 -right-24 h-72 w-72 rounded-full bg-amber-400/10 blur-3xl sm:-right-32 sm:h-96 sm:w-96"></div>

  <div class="relative mx-auto grid w-full max-w-5xl gap-10 lg:grid-cols-2 lg:gap-16 lg:items-center">

    <!-- =========================================
         LEFT: Marketing side (desktop only)
    ========================================= -->
    <div class="hidden lg:block">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#0878E8]/25 bg-[#0878E8]/5 px-3 py-1 text-sm font-medium text-[#0878E8]">
        <i class="fa-solid fa-shield-halved"></i> Secure verification
      </span>

      <h1 class="mt-5 text-4xl font-bold leading-tight text-[#022E5A] dark:text-white">
        One last step
      </h1>

      <p class="mt-4 max-w-md text-base text-slate-600 dark:text-slate-300">
        We've sent a 6-digit code to your inbox. Enter it to activate your NoteSphere account.
      </p>

      <ul class="mt-8 space-y-3 text-sm text-slate-700 dark:text-slate-300">
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
            <i class="fa-solid fa-check text-[10px]"></i>
          </span>
          The code expires in 10 minutes
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
            <i class="fa-solid fa-check text-[10px]"></i>
          </span>
          Check your spam folder if you don't see it
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
            <i class="fa-solid fa-check text-[10px]"></i>
          </span>
          We never share your email with anyone
        </li>
      </ul>
    </div>

    <!-- =========================================
         RIGHT: OTP card
    ========================================= -->
    <div class="w-full">
      <div class="rounded-3xl bg-white p-7 shadow-xl ring-1 ring-slate-200/70 dark:bg-slate-900 dark:ring-slate-800 sm:p-9">

        <!-- Icon -->
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#0878E8]/10 text-[#0878E8]">
          <i class="fa-solid fa-envelope-circle-check text-xl"></i>
        </div>

        <!-- Header -->
        <div class="mt-5 text-center">
          <h2 class="font-script text-3xl leading-none text-[#022E5A] dark:text-white">
            Verify your email
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
            A 6-digit one-time password has been sent to your registered email address.
          </p>
        </div>

        <!-- OTP Form -->
        <form id="otpForm" action="/verify/<%= user._id %>" method="POST" class="mt-7 space-y-5">

          <!-- OTP input -->
          <div>
            <label for="otp" class="mb-1.5 block text-center text-sm font-medium text-slate-600 dark:text-slate-300">
              Enter the 6-digit code
            </label>
            <input
              id="otp"
              type="text"
              name="otp"
              maxlength="6"
              inputmode="numeric"
              pattern="[0-9]{6}"
              autocomplete="one-time-code"
              required
              placeholder="••••••"
              class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-3 pr-3 text-center text-2xl font-semibold tracking-[0.5em]
                     text-slate-900 placeholder-slate-300
                     transition-colors
                     focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/25
                     dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder-slate-600"
            />
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="verifyButton"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#0878E8] py-2.5 text-sm font-semibold text-white
                   transition-all hover:bg-[#0668CC] hover:shadow-md
                   focus:outline-none focus:ring-2 focus:ring-[#0878E8] focus:ring-offset-2
                   disabled:cursor-not-allowed disabled:opacity-70
                   dark:focus:ring-offset-slate-900"
          >
            <span id="buttonText" class="inline-flex items-center gap-2">
              <i class="fa-solid fa-circle-check"></i> Verify email
            </span>
            <span id="buttonLoader" class="hidden items-center gap-2">
              <i class="fa-solid fa-circle-notch fa-spin"></i> Verifying…
            </span>
          </button>
        </form>

        <!-- Divider -->
        <div class="my-6 flex items-center gap-3">
          <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>
          <span class="text-[11px] font-semibold uppercase tracking-widest text-slate-400">or</span>
          <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>
        </div>

        <!-- Resend -->
        <div class="text-center">
          <p class="text-sm text-slate-500 dark:text-slate-400">
            Didn't receive the code?
          </p>

          <form id="resendForm" action="/verify/<%= user._id %>/resend" method="POST" class="mt-3">
            <button
              id="resendBtn"
              type="submit"
              class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium
                     text-slate-700 transition-colors hover:bg-slate-50
                     disabled:cursor-not-allowed disabled:opacity-60
                     dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
            >
              <i class="fa-solid fa-rotate-right text-xs"></i>
              <span id="resendLabel">Resend code</span>
            </button>
          </form>

          <p id="timer" class="mt-3 text-xs text-slate-400"></p>
        </div>

        <!-- Back to login -->
        <div class="mt-6 border-t border-slate-200 pt-5 text-center dark:border-slate-800">
          <a href="/login" class="inline-flex items-center gap-1.5 text-sm font-medium text-[#0878E8] hover:underline">
            <i class="fa-solid fa-arrow-left text-xs"></i> Back to login
          </a>
        </div>

      </div>

      <p class="mt-6 text-center text-xs text-slate-400">
        NoteSphere uses secure verification to protect your account.
      </p>
    </div>

  </div>
</section>

<!-- =========================================
     Page-specific styles
========================================= -->
<style>
  .font-script { font-family: 'Lora', serif; font-style: italic; font-weight: 600; }

  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus,
  input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px #fff inset !important;
    box-shadow: 0 0 0 30px #fff inset !important;
    -webkit-text-fill-color: #0f172a !important;
    transition: background-color 5000s ease-in-out 0s;
  }
  .dark input:-webkit-autofill,
  .dark input:-webkit-autofill:hover,
  .dark input:-webkit-autofill:focus,
  .dark input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px #0f172a inset !important;
    box-shadow: 0 0 0 30px #0f172a inset !important;
    -webkit-text-fill-color: #e2e8f0 !important;
  }
</style>

<!-- =========================================
     Page-specific scripts
========================================= -->
<script>
  (function () {
    const form = document.getElementById("otpForm");
    const btn = document.getElementById("verifyButton");
    const btnText = document.getElementById("buttonText");
    const btnLoader = document.getElementById("buttonLoader");
    const otpInput = document.getElementById("otp");
    const resendBtn = document.getElementById("resendBtn");
    const resendLabel = document.getElementById("resendLabel");
    const timerEl = document.getElementById("timer");

    /* ---------- Numeric-only input + auto-submit at 6 digits ---------- */
    otpInput?.addEventListener("input", function () {
      // Strip non-digits
      this.value = this.value.replace(/\D/g, "").slice(0, 6);
      // Auto-submit when 6 digits
      if (this.value.length === 6) {
        form?.requestSubmit?.();
      }
    });

    // Paste-friendly: allow paste of a 6-digit code
    otpInput?.addEventListener("paste", function (e) {
      const text = (e.clipboardData || window.clipboardData).getData("text") || "";
      const digits = text.replace(/\D/g, "").slice(0, 6);
      if (digits) {
        e.preventDefault();
        this.value = digits;
        if (digits.length === 6) form?.requestSubmit?.();
      }
    });

    /* ---------- Verify loading state ---------- */
    function setLoading(on) {
      if (on) {
        btnText.classList.add("hidden");
        btnLoader.classList.remove("hidden");
        btnLoader.classList.add("inline-flex");
        btn.disabled = true;
      } else {
        btnText.classList.remove("hidden");
        btnLoader.classList.add("hidden");
        btnLoader.classList.remove("inline-flex");
        btn.disabled = false;
      }
    }
    form?.addEventListener("submit", function () {
      setLoading(true);
    });

    /* ---------- Resend with cooldown ---------- */
    const COOLDOWN = 60;
    const STORAGE_KEY = "ns-otp-cooldown-until";

    function renderCooldown() {
      if (!resendBtn || !resendLabel) return;
      const until = Number(sessionStorage.getItem(STORAGE_KEY) || 0);
      const now = Date.now();
      if (until > now) {
        const remain = Math.ceil((until - now) / 1000);
        resendBtn.disabled = true;
        resendLabel.textContent = "Resend code (" + remain + "s)";
        if (timerEl) timerEl.textContent = "Please wait before requesting a new code.";
        return true;
      }
      resendBtn.disabled = false;
      resendLabel.textContent = "Resend code";
      if (timerEl) timerEl.textContent = "";
      return false;
    }

    function startCooldown() {
      const until = Date.now() + COOLDOWN * 1000;
      sessionStorage.setItem(STORAGE_KEY, String(until));
      renderCooldown();
      const tick = setInterval(function () {
        if (!renderCooldown()) clearInterval(tick);
      }, 1000);
    }

    // Initial state — if user reloaded during a cooldown, show remaining time
    if (renderCooldown()) {
      const tick = setInterval(function () {
        if (!renderCooldown()) clearInterval(tick);
      }, 1000);
    }

    // Kick off cooldown when the resend form is submitted
    document.getElementById("resendForm")?.addEventListener("submit", function () {
      setTimeout(startCooldown, 200);
    });

    /* ---------- Auto-focus OTP field ---------- */
    document.addEventListener("DOMContentLoaded", function () {
      otpInput?.focus();
    });
  })();
</script>