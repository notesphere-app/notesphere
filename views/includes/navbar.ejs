<!-- =========================================
     NoteSphere Navbar
========================================= -->
<%
  const activePath = (typeof currentPath !== "undefined") ? currentPath : "/";
  const currentUser = (typeof currUser !== "undefined") ? currUser : null;

  /* Robust active-link check — handles trailing slash, sub-paths, query strings */
  function isActive(path) {
    var current = String(activePath || "/").split("?")[0].split("#")[0];
    if (current.length > 1 && current.endsWith("/")) current = current.slice(0, -1);
    if (path === "/") return current === "" || current === "/";
    if (current === path) return true;
    if (current.startsWith(path + "/")) return true;
    return false;
  }

  /* Avatar helper — shows <img> if avatar exists, otherwise a colored
     circle with the first letter of the user's name. Color is
     deterministic (same letter → same color, always). */
  function avatarHTML(user, size) {
    if (!user) user = {};
    var s = size || 'h-8 w-8';
    var name = String(user.name || user.email || 'U').trim();
    var initial = (name.charAt(0) || 'U').toUpperCase();

    if (user.avatar && String(user.avatar).trim()) {
      return '<img src="' + user.avatar + '" alt="" class="' + s + ' rounded-full ring-2 ring-white dark:ring-slate-900 object-cover" />';
    }

    var palette = ['#0878E8', '#7C3AED', '#059669', '#D97706', '#DC2626', '#0891B2', '#DB2777', '#65A30D'];
    var groups  = ['AIQY', 'BJRZ', 'CKS', 'DLT', 'EMU', 'FNV', 'GOW', 'HPX'];
    var idx = 0;
    for (var i = 0; i < groups.length; i++) {
      if (groups[i].indexOf(initial) !== -1) { idx = i; break; }
    }
    var color = palette[idx];
    var fontSize = s.indexOf('h-12') !== -1 ? 'text-base'
                 : s.indexOf('h-11') !== -1 ? 'text-sm'
                 : s.indexOf('h-9')  !== -1 ? 'text-sm'
                 : 'text-xs';

    return '<span class="' + s + ' ' + fontSize + ' inline-flex flex-shrink-0 items-center justify-center rounded-full font-bold text-white ring-2 ring-white dark:ring-slate-900" style="background-color:' + color + ';" aria-hidden="true">' + initial + '</span>';
  }
%>
<nav
  id="ns-navbar"
  class="sticky top-0 z-50 w-full
         border-b border-slate-200/80 bg-[#FBFAF7]/90 backdrop-blur-md
         dark:border-slate-800 dark:bg-slate-950/90"
>
