              </div>
            </div>

            <div class="my-2 h-px bg-slate-100 dark:bg-slate-800"></div>

            <a href="/profile" class="nav-menu-item"><i class="fa-regular fa-user w-4 text-center"></i> My profile</a>
            <a href="/notes/mine" class="nav-menu-item"><i class="fa-solid fa-file-lines w-4 text-center"></i> My notes</a>
            <a href="/saved/notes" class="nav-menu-item"><i class="fa-regular fa-bookmark w-4 text-center"></i> Saved notes</a>
