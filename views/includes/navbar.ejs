    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="NoteSphere Home">
      <img src="/images/logo-2.png" alt="NoteSphere" width="38" height="38" class="bg-white rounded-full">
      <span class="flex items-baseline gap-0.5">
        <span class="text-xl font-bold tracking-tight text-[#022E5A] dark:text-white">Note</span>
        <span class="font-script text-2xl leading-none text-[#0878E8]">Sphere</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden items-center gap-7 md:flex">
      <a href="/" class="nav-link" <%- isActive("/") ? 'aria-current="page"' : "" %>>Home</a>
      <a href="/notes" class="nav-link" <%- isActive("/notes") ? 'aria-current="page"' : "" %>>Notes</a>
      <a href="/blogs" class="nav-link" <%- isActive("/blogs") ? 'aria-current="page"' : "" %>>Blogs</a>
      <a href="/about" class="nav-link" <%- isActive("/about") ? 'aria-current="page"' : "" %>>About</a>
      <a href="/contact" class="nav-link" <%- isActive("/contact") ? 'aria-current="page"' : "" %>>Contact</a>
    </div>

    <!-- Desktop Right Side -->
    <div class="hidden items-center gap-1 md:flex">

      <!-- Search toggle -->
      <button type="button" id="nav-search-toggle" aria-label="Open search" aria-expanded="false"
        class="flex h-10 w-10 items-center justify-center rounded-full
               text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-[#0878E8]
               dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-blue-400">
        <i class="fa-solid fa-magnifying-glass text-base"></i>
      </button>

      <!-- Theme Toggle -->
      <button id="theme-toggle" type="button" aria-label="Toggle dark mode"
