            class="ml-1 flex items-center gap-2 rounded-full p-0.5 pr-2 transition-colors hover:bg-slate-900/5 dark:hover:bg-white/10">
            <%- avatarHTML(currentUser, 'h-8 w-8') %>
            <span class="hidden text-sm font-medium text-[#022E5A] dark:text-slate-200 lg:inline">
              <%= (currentUser.name || 'You').split(' ')[0] %>
