                <p class="truncate text-sm font-semibold text-[#022E5A] dark:text-white">
                  <%= currentUser.name || 'NoteSphere user' %>
                </p>
                <p class="truncate text-xs text-slate-500 dark:text-slate-400">
                  <%= currentUser.email || '' %>
