              <i class="fa-solid fa-right-from-bracket w-4 text-center"></i> Log out
            </button>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Mobile Controls -->
    <div class="flex items-center gap-1 md:hidden">

      <button type="button" id="mobile-search-toggle" aria-label="Search" aria-expanded="false"
        class="flex h-10 w-10 items-center justify-center rounded-full
               text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-[#0878E8]
               dark:text-slate-300 dark:hover:bg-white/10">
        <i class="fa-solid fa-magnifying-glass text-base"></i>
