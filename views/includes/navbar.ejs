          Cancel
        </button>
        <form action="/logout" method="GET" class="contents">
          <button type="submit"
            class="inline-flex items-center gap-2 rounded-full bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white
                   shadow-sm transition-all hover:bg-rose-700 hover:shadow-md">
            <i class="fa-solid fa-right-from-bracket"></i> Yes, log out
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- =========================================
     Navbar styles
========================================= -->
<style>
  .font-script { font-family: 'Lora', serif; font-style: italic; font-weight: 600; }

  .nav-link {
    position: relative;
    padding-bottom: 4px;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgb(51 65 85);
  }
  .dark .nav-link { color: rgb(203 213 225); }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: #0878E8;
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .nav-link:hover, .nav-link:focus-visible { color: #0878E8; }
  .nav-link:hover::after, .nav-link:focus-visible::after,
  .nav-link[aria-current="page"]::after { transform: scaleX(1); }
  .nav-link[aria-current="page"] { color: #0878E8; }
  .dark .nav-link:hover, .dark .nav-link:focus-visible { color: rgb(96 165 250); }
  .dark .nav-link[aria-current="page"] { color: rgb(96 165 250); }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.75rem;
    padding: 0.7rem 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgb(51 65 85);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .mobile-nav-link:hover { background: rgba(8, 120, 232, 0.06); color: #0878E8; }
  .dark .mobile-nav-link { color: rgb(203 213 225); }
  .dark .mobile-nav-link:hover { background: rgba(96, 165, 250, 0.12); color: rgb(96, 165, 250); }
  .mobile-nav-link[aria-current="page"] {
    background: rgba(8, 120, 232, 0.08);
    color: #0878E8;
    font-weight: 600;
  }
  .dark .mobile-nav-link[aria-current="page"] { background: rgba(96, 165, 250, 0.12); color: rgb(96 165 250); }

  .nav-menu-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.75rem;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(51 65 85);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-menu-item:hover { background: rgb(241 245 249); color: #0878E8; }
  .dark .nav-menu-item { color: rgb(203 213 225); }
  .dark .nav-menu-item:hover { background: rgb(30 41 59); color: rgb(96 165 250); }
  .nav-menu-item--danger { color: rgb(225 29 72); }
  .nav-menu-item--danger:hover { background: rgb(255 241 242); color: rgb(190 18 60); }
  .dark .nav-menu-item--danger { color: rgb(251 113 133); }
  .dark .nav-menu-item--danger:hover { background: rgba(159, 18, 57, 0.2); color: rgb(253 164 175); }
</style>

<!-- =========================================
     Navbar JS
========================================= -->
<script>
  (function () {
    const html = document.documentElement;
    const THEME_KEY = "theme";

    /* -------- Theme -------- */
    function syncThemeIcons() {
      const isDark = html.classList.contains("dark");
      document.querySelectorAll(".theme-icon-sun").forEach(el => el.classList.toggle("hidden", isDark));
      document.querySelectorAll(".theme-icon-moon").forEach(el => el.classList.toggle("hidden", !isDark));
    }
    function toggleTheme() {
      const next = html.classList.contains("dark") ? "light" : "dark";
      html.classList.toggle("dark", next === "dark");
      localStorage.setItem(THEME_KEY, next);
      syncThemeIcons();
    }
    syncThemeIcons();
    document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
    document.getElementById("mobile-theme-toggle")?.addEventListener("click", toggleTheme);
    window.matchMedia?.("(prefers-color-scheme: dark)").addEventListener("change", function (e) {
      if (localStorage.getItem(THEME_KEY)) return;
      html.classList.toggle("dark", e.matches);
      syncThemeIcons();
    });

    /* -------- Mobile Drawer -------- */
    const drawer = document.getElementById("mobile-drawer");
    const drawerBackdrop = document.getElementById("mobile-drawer-backdrop");
    const menuBtn = document.getElementById("mobile-menu-button");
    const menuOpenIcon = document.getElementById("menu-open-icon");
    const menuCloseIcon = document.getElementById("menu-close-icon");
    const drawerCloseBtn = document.getElementById("mobile-drawer-close");
    let drawerLastFocused = null;
    let drawerOpen = false;

    function openDrawer() {
      if (drawerOpen) return;
      drawerOpen = true;
      drawerLastFocused = document.activeElement;
      drawerBackdrop.classList.remove("hidden");
      void drawerBackdrop.offsetWidth;
      drawerBackdrop.classList.remove("opacity-0");
      drawerBackdrop.classList.add("opacity-100");
      drawer.classList.remove("-translate-x-full");
      menuOpenIcon.classList.add("hidden");
      menuCloseIcon.classList.remove("hidden");
      menuBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      drawerCloseBtn?.focus();
    }
    function closeDrawer() {
      if (!drawerOpen) return;
      drawerOpen = false;
      drawer.classList.add("-translate-x-full");
      drawerBackdrop.classList.remove("opacity-100");
      drawerBackdrop.classList.add("opacity-0");
      menuOpenIcon.classList.remove("hidden");
      menuCloseIcon.classList.add("hidden");
      menuBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      setTimeout(function () { drawerBackdrop.classList.add("hidden"); }, 320);
      drawerLastFocused?.focus?.();
    }
    menuBtn?.addEventListener("click", function () { drawerOpen ? closeDrawer() : openDrawer(); });
    drawerCloseBtn?.addEventListener("click", closeDrawer);
    drawerBackdrop?.addEventListener("click", closeDrawer);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && drawerOpen) closeDrawer();
    });
    document.querySelectorAll("#mobile-drawer a").forEach(function (link) {
      link.addEventListener("click", closeDrawer);
    });
    let touchStartX = 0;
    drawer?.addEventListener("touchstart", function (e) { touchStartX = e.touches[0].clientX; }, { passive: true });
    drawer?.addEventListener("touchend", function (e) {
      if (e.changedTouches[0].clientX - touchStartX < -60) closeDrawer();
    }, { passive: true });
    window.addEventListener("resize", function () {
      if (window.innerWidth >= 768 && drawerOpen) closeDrawer();
    });

    /* -------- User dropdown -------- */
    const userTrigger = document.getElementById("nav-user-trigger");
    const userDropdown = document.getElementById("nav-user-dropdown");
    const userChevron = document.getElementById("nav-user-chevron");

    function openUserMenu() {
      userDropdown.classList.remove("invisible", "opacity-0", "scale-95");
      userDropdown.classList.add("opacity-100", "scale-100");
      userTrigger?.setAttribute("aria-expanded", "true");
      userChevron?.classList.add("rotate-180");
    }
    function closeUserMenu() {
      userDropdown.classList.add("invisible", "opacity-0", "scale-95");
      userDropdown.classList.remove("opacity-100", "scale-100");
      userTrigger?.setAttribute("aria-expanded", "false");
      userChevron?.classList.remove("rotate-180");
    }
    userTrigger?.addEventListener("click", function (e) {
      e.stopPropagation();
      const isOpen = !userDropdown.classList.contains("invisible");
      isOpen ? closeUserMenu() : openUserMenu();
    });
    document.addEventListener("click", function (e) {
      if (!userDropdown?.contains(e.target) && !userTrigger?.contains(e.target)) closeUserMenu();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeUserMenu();
    });

    /* -------- Search (desktop) -------- */
    const searchToggle = document.getElementById("nav-search-toggle");
    const searchPanel = document.getElementById("nav-search-panel");
    const searchInput = document.getElementById("nav-search-input");
    const searchClose = document.getElementById("nav-search-close");
    const searchForm = document.getElementById("nav-search-form");
    const searchResults = document.getElementById("nav-search-results");
    let searchOpen = false;
    let searchAbort = null;
    let searchDebounce = null;

    function openSearch() {
      if (searchOpen) return;
      searchOpen = true;
      closeMobileSearch();
      searchPanel.classList.remove("hidden", "invisible", "opacity-0", "-translate-y-2");
      searchPanel.classList.add("opacity-100", "translate-y-0");
      searchToggle?.setAttribute("aria-expanded", "true");
      setTimeout(function () { searchInput?.focus(); }, 80);
    }
    function closeSearch() {
      if (!searchOpen) return;
      searchOpen = false;
      searchPanel.classList.add("invisible", "opacity-0", "-translate-y-2");
      searchPanel.classList.remove("opacity-100", "translate-y-0");
      searchToggle?.setAttribute("aria-expanded", "false");
      if (searchResults) { searchResults.classList.add("hidden"); searchResults.innerHTML = ""; }
      if (searchInput) searchInput.value = "";
      searchAbort?.abort();
      setTimeout(function () {
        if (!searchOpen) searchPanel.classList.add("hidden");
      }, 220);
    }
    searchToggle?.addEventListener("click", function (e) {
      e.stopPropagation();
      searchOpen ? closeSearch() : openSearch();
    });
    searchClose?.addEventListener("click", function (e) { e.stopPropagation(); closeSearch(); });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && searchOpen) closeSearch();
    });

    function renderResultsInto(container, items) {
      if (!items || !items.length) {
        container.innerHTML = '<p class="px-3 py-6 text-center text-sm text-slate-400">No results found.</p>';
        container.classList.remove("hidden");
        return;
      }
      container.innerHTML = items.map(function (item) {
        return '<a href="' + (item.url || '#') + '" class="flex items-center gap-3 rounded-xl px-3 py-2 transition-colors hover:bg-slate-100 dark:hover:bg-slate-800">' +
          '<span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-[#0878E8]/10 text-[#0878E8]"><i class="' + (item.icon || 'fa-solid fa-file-lines') + '"></i></span>' +
          '<span class="min-w-0 flex-1">' +
            '<span class="block truncate text-sm font-medium text-[#022E5A] dark:text-white">' + item.title + '</span>' +
            '<span class="block truncate text-xs text-slate-400">' + (item.subtitle || '') + '</span>' +
          '</span>' +
        '</a>';
      }).join("");
      container.classList.remove("hidden");
    }

    function runSearch(q, resultsEl) {
      searchAbort?.abort();
      searchAbort = new AbortController();
      fetch("/search?q=" + encodeURIComponent(q) + "&limit=6", {
        headers: { "Accept": "application/json" },
        signal: searchAbort.signal
      })
        .then(function (res) { return res.ok ? res.json() : { results: [] }; })
        .then(function (data) {
          if (resultsEl) renderResultsInto(resultsEl, data.results || []);
        })
        .catch(function (err) { if (err.name !== "AbortError") console.warn(err); });
    }

    searchInput?.addEventListener("input", function () {
      const q = searchInput.value.trim();
      clearTimeout(searchDebounce);
      if (!q) { searchResults?.classList.add("hidden"); return; }
      searchDebounce = setTimeout(function () { runSearch(q, searchResults); }, 200);
    });
    searchForm?.addEventListener("submit", function (e) {
      if (!searchInput?.value.trim()) e.preventDefault();
    });

    /* -------- Search (mobile) -------- */
    const mobileSearchToggle = document.getElementById("mobile-search-toggle");
    const mobileSearchPanel = document.getElementById("mobile-search-panel");
    const mobileSearchInput = document.getElementById("mobile-search-input");
    const mobileSearchClose = document.getElementById("mobile-search-close");
    let mobileSearchOpen = false;

    function openMobileSearch() {
      if (mobileSearchOpen) return;
      mobileSearchOpen = true;
      closeSearch();
      mobileSearchPanel.classList.remove("hidden", "invisible", "opacity-0", "-translate-y-2");
      mobileSearchPanel.classList.add("opacity-100", "translate-y-0");
      mobileSearchToggle?.setAttribute("aria-expanded", "true");
      setTimeout(function () { mobileSearchInput?.focus(); }, 80);
    }
    function closeMobileSearch() {
      if (!mobileSearchOpen) return;
      mobileSearchOpen = false;
      mobileSearchPanel.classList.add("invisible", "opacity-0", "-translate-y-2");
      mobileSearchPanel.classList.remove("opacity-100", "translate-y-0");
      mobileSearchToggle?.setAttribute("aria-expanded", "false");
      if (mobileSearchInput) mobileSearchInput.value = "";
      setTimeout(function () {
        if (!mobileSearchOpen) mobileSearchPanel.classList.add("hidden");
      }, 220);
    }
    mobileSearchToggle?.addEventListener("click", function (e) {
      e.stopPropagation();
      mobileSearchOpen ? closeMobileSearch() : openMobileSearch();
    });
    mobileSearchClose?.addEventListener("click", closeMobileSearch);

    /* -------- Logout confirmation -------- */
    const logoutRoot = document.getElementById("logout-modal-root");
    const logoutOverlay = document.getElementById("logout-modal-overlay");
    const logoutPanel = document.getElementById("logout-modal-panel");
    const logoutCancel = document.getElementById("logout-cancel");
    let logoutLastFocused = null;

    function openLogoutModal() {
      closeDrawer();
      closeUserMenu();
      logoutLastFocused = document.activeElement;
      logoutRoot.classList.remove("hidden");
      requestAnimationFrame(function () {
        logoutOverlay.classList.add("opacity-100");
        logoutPanel.classList.remove("opacity-0", "scale-95");
        logoutPanel.classList.add("opacity-100", "scale-100");
        logoutCancel?.focus();
      });
      document.body.style.overflow = "hidden";
    }
    function closeLogoutModal() {
      logoutOverlay.classList.remove("opacity-100");
      logoutPanel.classList.add("opacity-0", "scale-95");
      logoutPanel.classList.remove("opacity-100", "scale-100");
      setTimeout(function () {
        logoutRoot.classList.add("hidden");
        document.body.style.overflow = "";
      }, 200);
      logoutLastFocused?.focus?.();
    }
    document.querySelectorAll("[data-logout-trigger]").forEach(function (btn) {
      btn.addEventListener("click", function (e) { e.preventDefault(); openLogoutModal(); });
    });
    logoutCancel?.addEventListener("click", closeLogoutModal);
    logoutOverlay?.addEventListener("click", function (e) {
      if (e.target === logoutOverlay) closeLogoutModal();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !logoutRoot.classList.contains("hidden")) closeLogoutModal();
    });

    document.getElementById("mobile-user-trigger")?.addEventListener("click", openDrawer);
  })();
</script>