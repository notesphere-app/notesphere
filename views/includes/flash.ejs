<%
  const flashTypes = [
    { key: "success", icon: "fa-circle-check", tone: "border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-900/70 dark:bg-emerald-950/90 dark:text-emerald-100", iconTone: "text-emerald-600 dark:text-emerald-300" },
    { key: "error", icon: "fa-circle-exclamation", tone: "border-rose-200 bg-rose-50 text-rose-900 dark:border-rose-900/70 dark:bg-rose-950/90 dark:text-rose-100", iconTone: "text-rose-600 dark:text-rose-300" },
    { key: "warning", icon: "fa-triangle-exclamation", tone: "border-amber-200 bg-amber-50 text-amber-950 dark:border-amber-900/70 dark:bg-amber-950/90 dark:text-amber-100", iconTone: "text-amber-600 dark:text-amber-300" },
    { key: "info", icon: "fa-circle-info", tone: "border-blue-200 bg-blue-50 text-[#022E5A] dark:border-blue-900/70 dark:bg-slate-900 dark:text-blue-100", iconTone: "text-[#0878E8] dark:text-blue-300" },
    { key: "primary", icon: "fa-bell", tone: "border-slate-200 bg-white text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100", iconTone: "text-[#0878E8] dark:text-blue-300" },
  ];
%>
<%
  const flashValues = {
    success: typeof success === "undefined" ? [] : success,
    error: typeof error === "undefined" ? [] : error,
    warning: typeof warning === "undefined" ? [] : warning,
    info: typeof info === "undefined" ? [] : info,
    primary: typeof primary === "undefined" ? [] : primary,
  };
%>
<div class="pointer-events-none fixed inset-x-0 top-20 z-[9999] flex flex-col items-center gap-3 px-3 sm:top-24" aria-live="polite">
  <% flashTypes.forEach(function (type) {
    const value = flashValues[type.key];
    const entries = Array.isArray(value) ? value : (value ? [value] : []);
    entries.forEach(function (entry) {
      if (!entry) return;
  %>
    <div class="ns-flash-message pointer-events-auto relative flex w-full max-w-lg items-start gap-3 overflow-hidden rounded-2xl border px-4 py-3.5 pr-12 shadow-lg shadow-slate-900/10 backdrop-blur-sm transition-all duration-500 <%= type.tone %>" role="status" data-flash-message>
      <i class="fa-solid <%= type.icon %> mt-0.5 shrink-0 <%= type.iconTone %>" aria-hidden="true"></i>
      <p class="min-w-0 flex-1 text-sm font-medium leading-5"><%= entry %></p>
      <button type="button" class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full opacity-70 transition hover:bg-black/5 hover:opacity-100 dark:hover:bg-white/10" data-flash-close aria-label="Dismiss notification">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
      <span class="ns-flash-timer absolute inset-x-0 bottom-0 h-0.5 origin-left bg-current opacity-20" aria-hidden="true"></span>
    </div>
  <% }); }); %>
</div>

<style>
  .ns-flash-message.is-dismissing {
    opacity: 0;
    transform: translateY(-0.5rem);
    pointer-events: none;
  }

  .ns-flash-message.is-dismissing .ns-flash-timer {
    transform: scaleX(0);
  }

  .ns-flash-timer {
    animation: ns-flash-countdown 30s linear forwards;
  }

  @keyframes ns-flash-countdown {
    to { transform: scaleX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ns-flash-timer { animation-duration: 30s; }
    .ns-flash-message { transition-duration: 1ms; }
  }
</style>

<script>
  (function () {
    function scheduleFlashDismissal(message) {
      if (message.dataset.dismissScheduled) return;
      message.dataset.dismissScheduled = "true";
      window.setTimeout(function () {
        if (!message.isConnected) return;
        message.classList.add("is-dismissing");
        window.setTimeout(function () { message.remove(); }, 500);
      }, 30000);
    }

    function initializeFlashMessages(root) {
      if (root.matches?.("[data-flash-message]")) scheduleFlashDismissal(root);
      root.querySelectorAll?.("[data-flash-message]").forEach(scheduleFlashDismissal);
    }

    initializeFlashMessages(document);
    document.addEventListener("click", function (event) {
      const closeButton = event.target.closest("[data-flash-close]");
      if (closeButton) closeButton.closest("[data-flash-message]")?.remove();
    });

    if ("MutationObserver" in window) {
      new MutationObserver(function (mutations) {
        mutations.forEach(function (mutation) {
          mutation.addedNodes.forEach(function (node) {
            if (node.nodeType === Node.ELEMENT_NODE) initializeFlashMessages(node);
          });
        });
      }).observe(document.documentElement, { childList: true, subtree: true });
    }
  })();
</script>
