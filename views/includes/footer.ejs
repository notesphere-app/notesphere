<!-- =========================================
     NoteSphere Footer
========================================= -->
<footer class="relative overflow-hidden bg-[#022E5A] dark:bg-slate-950">
  <!-- subtle decorative glow -->
  <div class="pointer-events-none absolute -top-32 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-[#0878E8]/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-40 -right-24 h-72 w-72 rounded-full bg-[#5CA6F0]/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">

    <!-- =========================================
         Main footer grid
         Mobile: 2 columns (brand full-width on top, then links in 2 cols)
         Tablet (sm–md): 2 columns
         Desktop (lg): 5 columns (brand takes 2)
    ========================================= -->
    <div class="grid grid-cols-2 gap-8 sm:gap-10 md:grid-cols-2 lg:grid-cols-5">

      <!-- Brand + description + social -->
      <div class="col-span-2 md:col-span-2 lg:col-span-2">
        <a href="/" class="footer-brand inline-flex items-center gap-2.5" aria-label="NoteSphere Home">
          <img src="/images/logo-2.png" alt="NoteSphere"width="38" height="38" class="bg-white rounded-full">
          <span class="flex items-baseline gap-0.5">
            <span class="text-xl font-bold tracking-tight text-white">Note</span>
            <span class="font-script text-2xl leading-none text-[#5CA6F0]">Sphere</span>
          </span>
        </a>

        <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-300">
          A free library of class notes, notebook scans, and handwritten PDFs uploaded by
          students. Find what you need, download it, and pass it on.
        </p>

        <!-- small stats row inside footer -->
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs">
          <span class="flex items-center gap-2 text-slate-300">
            <i class="fa-solid fa-cloud-arrow-up text-[#5CA6F0]"></i> 24,600+ uploads
          </span>
          <span class="flex items-center gap-2 text-slate-300">
            <i class="fa-solid fa-download text-[#5CA6F0]"></i> 189k+ downloads
          </span>
          <span class="flex items-center gap-2 text-slate-300">
            <i class="fa-solid fa-users text-[#5CA6F0]"></i> 3,150+ contributors
          </span>
        </div>

        <div class="mt-6 flex items-center gap-3">
          <a href="#" aria-label="NoteSphere on Twitter" class="footer-social">
            <i class="fa-brands fa-x-twitter"></i>
          </a>
          <a href="#" aria-label="NoteSphere on Instagram" class="footer-social">
            <i class="fa-brands fa-instagram"></i>
          </a>
          <a href="#" aria-label="NoteSphere on LinkedIn" class="footer-social">
            <i class="fa-brands fa-linkedin-in"></i>
          </a>
          <a href="#" aria-label="NoteSphere on YouTube" class="footer-social">
            <i class="fa-brands fa-youtube"></i>
          </a>
        </div>
      </div>

      <!-- Product -->
      <div class="footer-col">
        <h3 class="footer-heading">
          <i class="fa-solid fa-cube text-[#5CA6F0]"></i> Product
        </h3>
        <ul class="footer-list">
          <li><a href="/notes" class="footer-link"><i class="fa-solid fa-angle-right"></i> Browse notes</a></li>
          <li><a href="/blogs" class="footer-link"><i class="fa-solid fa-angle-right"></i> Blogs</a></li>
          <li><a href="/#features" class="footer-link"><i class="fa-solid fa-angle-right"></i> Features</a></li>
          <li><a href="/upload" class="footer-link"><i class="fa-solid fa-angle-right"></i> Upload notes</a></li>
          <li><a href="/pricing" class="footer-link"><i class="fa-solid fa-angle-right"></i> Pricing</a></li>
        </ul>
      </div>

      <!-- Notes by course -->
      <div class="footer-col">
        <h3 class="footer-heading">
          <i class="fa-solid fa-graduation-cap text-[#5CA6F0]"></i> By course
        </h3>
        <ul class="footer-list">
          <li><a href="/notes?course=btech" class="footer-link"><i class="fa-solid fa-angle-right"></i> B.Tech</a></li>
          <li><a href="/notes?course=ba" class="footer-link"><i class="fa-solid fa-angle-right"></i> B.A.</a></li>
          <li><a href="/notes?course=bsc" class="footer-link"><i class="fa-solid fa-angle-right"></i> B.Sc.</a></li>
          <li><a href="/notes?course=bcom" class="footer-link"><i class="fa-solid fa-angle-right"></i> B.Com.</a></li>
          <li><a href="/notes?course=bba" class="footer-link"><i class="fa-solid fa-angle-right"></i> BBA</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div class="footer-col">
        <h3 class="footer-heading">
          <i class="fa-solid fa-circle-info text-[#5CA6F0]"></i> Company
        </h3>
        <ul class="footer-list">
          <li><a href="/about" class="footer-link"><i class="fa-solid fa-angle-right"></i> About</a></li>
          <li><a href="/contact" class="footer-link"><i class="fa-solid fa-angle-right"></i> Contact</a></li>
          <li><a href="/privacy" class="footer-link"><i class="fa-solid fa-angle-right"></i> Privacy policy</a></li>
          <li><a href="/terms" class="footer-link"><i class="fa-solid fa-angle-right"></i> Terms of service</a></li>
          <li><a href="/help" class="footer-link"><i class="fa-solid fa-angle-right"></i> Help center</a></li>
        </ul>
      </div>

    </div>

    <!-- =========================================
         Bottom bar
    ========================================= -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <p class="order-2 text-center text-xs text-slate-400 sm:order-1 sm:text-left sm:text-sm">
        &copy; <%= new Date().getFullYear() %> NoteSphere. All rights reserved.
        <span class="mx-1.5 hidden text-slate-600 sm:inline">·</span>
        <span class="mt-1 block sm:mt-0 sm:inline">
          Made with <i class="fa-solid fa-heart text-rose-400"></i> by students, for students.
        </span>
      </p>

      <div class="order-1 flex items-center gap-3 sm:order-2">
        <a href="/sitemap" class="hidden text-xs text-slate-400 transition-colors hover:text-white sm:inline">Sitemap</a>
        <button type="button" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="footer-back-top group">
          Back to top
          <i class="fa-solid fa-arrow-up-long transition-transform group-hover:-translate-y-0.5"></i>
        </button>
      </div>
    </div>

  </div>
</footer>

<style>
  /* ============================================================
     Footer brand link
  ============================================================ */
  .footer-brand {
    transition: opacity 0.2s ease;
  }
  .footer-brand:hover { opacity: 0.9; }

  /* ============================================================
     Footer column headings
  ============================================================ */
  .footer-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(148 163 184);
  }

  /* ============================================================
     Footer link list
  ============================================================ */
  .footer-list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .footer-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0;
    color: rgb(203 213 225);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  /* The little chevron starts small and slides right on hover */
  .footer-link > i {
    font-size: 0.65rem;
    color: rgb(100 116 139);
    transform: translateX(-2px);
    opacity: 0.6;
    transition: transform 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .footer-link::after {
    content: "";
    position: absolute;
    left: 1rem; /* starts after the chevron */
    right: 0;
    bottom: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .footer-link:hover {
    color: #5CA6F0;
    transform: translateX(2px);
  }
  .footer-link:hover > i {
    color: #5CA6F0;
    transform: translateX(2px);
    opacity: 1;
  }
  .footer-link:hover::after { transform: scaleX(1); }

  .footer-link:focus-visible {
    outline: 2px solid #5CA6F0;
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* ============================================================
     Social buttons
  ============================================================ */
  .footer-social {
    display: flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    font-size: 0.9rem;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .footer-social:hover {
    background: #0878E8;
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(8, 120, 232, 0.35);
  }
  .footer-social:focus-visible {
    outline: 2px solid #5CA6F0;
    outline-offset: 3px;
  }

  /* ============================================================
     Back to top button
  ============================================================ */
  .footer-back-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(203 213 225);
    background: rgba(255, 255, 255, 0.04);
    transition: all 0.2s ease;
  }
  .footer-back-top:hover {
    color: white;
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
  }
  .footer-back-top:focus-visible {
    outline: 2px solid #5CA6F0;
    outline-offset: 3px;
  }

  /* ============================================================
     Mobile tweaks — keep link columns in TWO columns, not stacked
  ============================================================ */
  @media (max-width: 400px) {
    /* On very small phones, tighten the link lists slightly */
    .footer-list { gap: 0.4rem; font-size: 0.8rem; }
    .footer-heading { font-size: 0.7rem; }
  }

  /* Screen-reader-only helper (in case boilerplate doesn't already have it) */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  /* ============================================================
     Subscribe form — inline feedback, no page reload.
     Wire this to your real route (e.g. POST /subscribe) later.
  ============================================================ */
  (function subscribeForm() {
    var form = document.getElementById('subscribe-form');
    var msg  = document.getElementById('subscribe-msg');
    if (!form || !msg) return;

    function show(text, kind) {
      msg.textContent = text;
      msg.classList.remove('hidden', 'text-emerald-300', 'text-rose-300');
      msg.classList.add(kind === 'ok' ? 'text-emerald-300' : 'text-rose-300');
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = form.querySelector('input[name="email"]');
      var value = (email.value || '').trim();

      // Simple client-side validation — server should validate again.
      var ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      if (!ok) {
        show('Please enter a valid email address.', 'err');
        email.focus();
        return;
      }

      var btn = form.querySelector('button[type="submit"]');
      var original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Subscribing…';

      // Simulated request — replace with a real fetch to /subscribe.
      fetch('/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ email: value })
      })
      .catch(function () { return null; }) // ignore network errors in demo
      .then(function () {
        show('Thanks! Check your inbox to confirm.', 'ok');
        form.reset();
      })
      .finally(function () {
        btn.disabled = false;
        btn.innerHTML = original;
      });
    });
  })();
</script>