<!-- =========================================
     NoteSphere Footer
========================================= -->
<footer class="relative overflow-hidden bg-[#022E5A] dark:bg-slate-950">
  <!-- subtle decorative glow -->
  <div class="pointer-events-none absolute -top-32 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-[#0878E8]/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-40 -right-24 h-72 w-72 rounded-full bg-[#5CA6F0]/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">

    <!-- =========================================
         Main footer grid
         Mobile: 2 columns (brand full-width on top, then links in 2 cols)
         Tablet (sm–md): 2 columns
         Desktop (lg): 5 columns (brand takes 2)
    ========================================= -->
    <div class="grid grid-cols-2 gap-8 sm:gap-10 md:grid-cols-2 lg:grid-cols-5">

      <!-- Brand + description + social -->
      <div class="col-span-2 md:col-span-2 lg:col-span-2">
        <a href="/" class="footer-brand inline-flex items-center gap-2.5" aria-label="NoteSphere Home">
          <img src="/images/logo-2.png" alt="NoteSphere"width="38" height="38" class="bg-white rounded-full">
          <span class="flex items-baseline gap-0.5">
            <span class="text-xl font-bold tracking-tight text-white">Note</span>
            <span class="font-script text-2xl leading-none text-[#5CA6F0]">Sphere</span>
          </span>
        </a>

        <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-300">
          A free library of class notes, notebook scans, and handwritten PDFs uploaded by
          students. Find what you need, download it, and pass it on.
        </p>

        <form id="subscribe-form" class="mt-6 max-w-sm" novalidate>
          <label for="subscribe-email" class="block text-sm font-semibold text-white">Newsletter</label>
          <p class="mt-1 text-xs text-slate-300">A short email when new notes and articles are added.</p>
          <div class="mt-3 flex gap-2">
            <input id="subscribe-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com"
              class="min-w-0 flex-1 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-white placeholder:text-slate-300" />
            <button type="submit" class="rounded-full bg-[#0878E8] px-4 py-2 text-sm font-semibold text-white">Join</button>
          </div>
          <div id="subscribe-verification" class="mt-3 hidden">
            <label for="subscribe-otp" class="block text-xs text-slate-200">Enter the 6-digit email code</label>
            <div class="mt-1 flex gap-2">
              <input id="subscribe-otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" class="min-w-0 flex-1 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-white" />
              <button type="button" id="verify-subscription" class="rounded-full border border-white/30 px-4 py-2 text-sm font-semibold text-white">Verify</button>
            </div>
          </div>
          <p id="subscribe-msg" role="status" aria-live="polite" class="mt-2 hidden text-xs"></p>
        </form>
      </div>

      <!-- Product -->
      <div class="footer-col">
        <h3 class="footer-heading">
          <i class="fa-solid fa-cube text-[#5CA6F0]"></i> Product
        </h3>
        <ul class="footer-list">
          <li><a href="/notes" class="footer-link"><i class="fa-solid fa-angle-right"></i> Browse notes</a></li>
          <li><a href="/blogs" class="footer-link"><i class="fa-solid fa-angle-right"></i> Blogs</a></li>
          <li><a href="/#features" class="footer-link"><i class="fa-solid fa-angle-right"></i> Features</a></li>
          <li><a href="<%= currUser ? '/notes/new' : '/login' %>" class="footer-link"><i class="fa-solid fa-angle-right"></i> Share notes</a></li>
          <li><a href="/about" class="footer-link"><i class="fa-solid fa-angle-right"></i> How it works</a></li>
        </ul>
      </div>

      <!-- Notes by course -->
      <div class="footer-col">
        <h3 class="footer-heading">
          <i class="fa-solid fa-graduation-cap text-[#5CA6F0]"></i> By course
        </h3>
        <ul class="footer-list">
          <% if (Array.isArray(footerCourses) && footerCourses.length) { %>
            <% footerCourses.forEach(function (course) { %>
              <li><a href="/notes?course=<%= course._id %>" class="footer-link"><i class="fa-solid fa-angle-right"></i> <%= course.name %></a></li>
            <% }) %>
          <% } else { %>
            <li><a href="/notes" class="footer-link"><i class="fa-solid fa-angle-right"></i> Browse all courses</a></li>
          <% } %>
        </ul>
      </div>

      <!-- Company -->
      <div class="footer-col">
        <h3 class="footer-heading">
          <i class="fa-solid fa-circle-info text-[#5CA6F0]"></i> Company
        </h3>
        <ul class="footer-list">
          <li><a href="/about" class="footer-link"><i class="fa-solid fa-angle-right"></i> About</a></li>
          <li><a href="/contact" class="footer-link"><i class="fa-solid fa-angle-right"></i> Contact</a></li>
          <li><a href="/privacy" class="footer-link"><i class="fa-solid fa-angle-right"></i> Privacy policy</a></li>
          <li><a href="/terms" class="footer-link"><i class="fa-solid fa-angle-right"></i> Terms of service</a></li>
          <li><a href="/cookies" class="footer-link"><i class="fa-solid fa-angle-right"></i> Cookie policy</a></li>
          <li><a href="/sitemap.xml" class="footer-link"><i class="fa-solid fa-angle-right"></i> Sitemap</a></li>
          <li><a href="/help" class="footer-link"><i class="fa-solid fa-angle-right"></i> Help center</a></li>
        </ul>
      </div>

    </div>

    <section class="mt-10 grid gap-5 rounded-2xl border border-white/15 bg-white/5 p-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:p-8" aria-label="Support NoteSphere">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-widest text-[#8CC4FF]">Student-run · Free to use</p>
        <h2 class="mt-2 text-xl font-bold text-white">Help keep shared learning resources accessible</h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-300">NoteSphere is an independent project maintained by students, not a formal organization or registered charity. If this library has helped you, you can make a voluntary contribution toward its hosting and upkeep.</p>
      </div>
      <button type="button" data-donate-open class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-[#022E5A] transition hover:bg-blue-50 sm:w-auto">
        <i class="fa-solid fa-heart text-rose-500"></i> Contribute
      </button>
    </section>

    <!-- =========================================
         Bottom bar
    ========================================= -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <p class="order-2 text-center text-xs text-slate-400 sm:order-1 sm:text-left sm:text-sm">
        &copy; <%= new Date().getFullYear() %> NoteSphere. All rights reserved.
        <span class="mx-1.5 hidden text-slate-600 sm:inline">·</span>
        <span class="mt-1 block sm:mt-0 sm:inline">
          Made with <i class="fa-solid fa-heart text-rose-400"></i> by students, for students.
        </span>
      </p>

      <div class="order-1 flex items-center gap-3 sm:order-2">
        <a href="/sitemap.xml" class="hidden text-xs text-slate-400 transition-colors hover:text-white sm:inline">Sitemap</a>
        <button type="button" data-open-cookie-consent class="text-xs text-slate-400 transition-colors hover:text-white">Cookie choices</button>
        <button type="button" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="footer-back-top group">
          Back to top
          <i class="fa-solid fa-arrow-up-long transition-transform group-hover:-translate-y-0.5"></i>
        </button>
      </div>
    </div>

  </div>
</footer>

<%- include("./contribution.ejs") %>

<style>
  /* ============================================================
     Footer brand link
  ============================================================ */
  .footer-brand {
    transition: opacity 0.2s ease;
  }
  .footer-brand:hover { opacity: 0.9; }

  /* ============================================================
     Footer column headings
  ============================================================ */
  .footer-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(148 163 184);
  }

  /* ============================================================
     Footer link list
  ============================================================ */
  .footer-list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .footer-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0;
    color: rgb(203 213 225);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  /* The little chevron starts small and slides right on hover */
  .footer-link > i {
    font-size: 0.65rem;
    color: rgb(100 116 139);
    transform: translateX(-2px);
    opacity: 0.6;
    transition: transform 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .footer-link::after {
    content: "";
    position: absolute;
    left: 1rem; /* starts after the chevron */
    right: 0;
    bottom: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .footer-link:hover {
    color: #5CA6F0;
    transform: translateX(2px);
  }
  .footer-link:hover > i {
    color: #5CA6F0;
    transform: translateX(2px);
    opacity: 1;
  }
  .footer-link:hover::after { transform: scaleX(1); }

  .footer-link:focus-visible {
    outline: 2px solid #5CA6F0;
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* ============================================================
     Social buttons
  ============================================================ */
  .footer-social {
    display: flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    font-size: 0.9rem;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .footer-social:hover {
    background: #0878E8;
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(8, 120, 232, 0.35);
  }
  .footer-social:focus-visible {
    outline: 2px solid #5CA6F0;
    outline-offset: 3px;
  }

  /* ============================================================
     Back to top button
  ============================================================ */
  .footer-back-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(203 213 225);
    background: rgba(255, 255, 255, 0.04);
    transition: all 0.2s ease;
  }
  .footer-back-top:hover {
    color: white;
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
  }
  .footer-back-top:focus-visible {
    outline: 2px solid #5CA6F0;
    outline-offset: 3px;
  }

  /* ============================================================
     Mobile tweaks — keep link columns in TWO columns, not stacked
  ============================================================ */
  @media (max-width: 400px) {
    /* On very small phones, tighten the link lists slightly */
    .footer-list { gap: 0.4rem; font-size: 0.8rem; }
    .footer-heading { font-size: 0.7rem; }
  }

  /* Screen-reader-only helper (in case boilerplate doesn't already have it) */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  /* Newsletter subscription and email confirmation. */
  (function subscribeForm() {
    var form = document.getElementById('subscribe-form');
    var msg  = document.getElementById('subscribe-msg');
    var verifyPanel = document.getElementById('subscribe-verification');
    var verifyButton = document.getElementById('verify-subscription');
    var pendingEmail = '';
    if (!form || !msg || !verifyPanel || !verifyButton) return;

    function show(text, kind) {
      msg.textContent = text;
      msg.classList.remove('hidden', 'text-emerald-300', 'text-rose-300');
      msg.classList.add(kind === 'ok' ? 'text-emerald-300' : 'text-rose-300');
    }

    function request(url, body) {
      return window.nsGetRecaptchaToken('subscribe').then(function (captchaToken) {
        body['g-recaptcha-response'] = captchaToken;
        return fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(body)
        });
      }).then(function (response) {
        return response.json().then(function (result) {
          if (!response.ok) throw new Error(result.message || 'Request failed.');
          return result;
        });
      });
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = form.querySelector('input[name="email"]');
      var value = (email.value || '').trim();
      var ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      if (!ok) {
        show('Please enter a valid email address.', 'err');
        email.focus();
        return;
      }

      var btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      request('/subscribe', { email: value }).then(function (result) {
        if (result.verificationRequired) {
          pendingEmail = result.email || value;
          verifyPanel.classList.remove('hidden');
          show(result.message, 'ok');
        } else {
          pendingEmail = '';
          verifyPanel.classList.add('hidden');
          show(result.message, 'ok');
          form.reset();
        }
      }).catch(function (error) {
        show(error.message || 'Unable to subscribe. Please try again.', 'err');
      }).finally(function () {
        btn.disabled = false;
      });
    });

    verifyButton.addEventListener('click', function () {
      var otp = document.getElementById('subscribe-otp').value.trim();
      if (!pendingEmail || !/^\d{6}$/.test(otp)) {
        show('Enter the 6-digit code sent to your email.', 'err');
        return;
      }
      verifyButton.disabled = true;
      request('/subscribe/verify', { email: pendingEmail, otp: otp }).then(function (result) {
        show(result.message, 'ok');
        verifyPanel.classList.add('hidden');
        form.reset();
        document.getElementById('subscribe-otp').value = '';
        pendingEmail = '';
      }).catch(function (error) {
        show(error.message || 'Unable to verify this code.', 'err');
      }).finally(function () {
        verifyButton.disabled = false;
      });
    });
  })();
</script>