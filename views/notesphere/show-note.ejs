<% layout("/layouts/boilerplate") -%>

<section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
  <a href="/notes" class="text-sm font-medium text-blue-700 hover:underline">← Browse notes</a>
  <article class="mt-5 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700 sm:p-8">
    <div class="flex flex-wrap gap-2 text-xs font-semibold text-blue-700">
      <span class="rounded-full bg-blue-50 px-3 py-1"><%= note.course %></span>
      <span class="rounded-full bg-blue-50 px-3 py-1"><%= note.subject %></span>
      <span class="rounded-full bg-blue-50 px-3 py-1">Semester <%= note.semester || "—" %></span>
      <% if (note.specialization) { %><span class="rounded-full bg-blue-50 px-3 py-1"><%= note.specialization %></span><% } %>
      <% if (note.noteCategory) { %><span class="rounded-full bg-blue-50 px-3 py-1"><%= note.noteCategory %></span><% } %>
    </div>
    <h1 class="mt-4 text-3xl font-bold text-slate-900 dark:text-white"><%= note.title %></h1>
    <p class="mt-3 whitespace-pre-line text-slate-600 dark:text-slate-300"><%= note.description || "Shared notes link" %></p>
    <% if (!note.isPublished) { %>
      <div class="mt-5 rounded-xl border px-4 py-3 text-sm <%= note.moderationStatus === 'rejected' ? 'border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-200' : 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200' %>">
        <strong><%= note.moderationStatus === "rejected" ? "Not approved" : "Awaiting admin review" %>.</strong>
        <% if (canModerate) { %>
          This note is private until approved.
        <% } else { %>
          Only you and admins can see this submission. It will appear in the public library after approval.
        <% } %>
      </div>
      <% if (canModerate) { %>
        <div class="mt-3 flex flex-wrap gap-2">
          <form action="/admin/notes/<%= note._id %>/moderate" method="POST">
            <input type="hidden" name="_method" value="PATCH">
            <input type="hidden" name="status" value="approved">
            <button class="rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white">Approve & publish</button>
          </form>
          <form action="/admin/notes/<%= note._id %>/moderate" method="POST">
            <input type="hidden" name="_method" value="PATCH">
            <input type="hidden" name="status" value="rejected">
            <button class="rounded-full border border-rose-300 px-4 py-2 text-sm font-semibold text-rose-700">Reject</button>
          </form>
        </div>
      <% } %>
    <% } %>
    <p class="mt-4 text-sm text-slate-500">
      Shared by <%= note.author?.name || note.author?.username || "Notesphere user" %>
    </p>
    <% if ((note.universities && note.universities.length) || (note.colleges && note.colleges.length) || note.university || note.college) { %>
      <p class="mt-2 text-sm text-slate-500">
        <%= (note.universities || []).map((item) => item.name).join(", ") || note.university %>
        <% if ((note.colleges && note.colleges.length) || note.college) { %> · <%= (note.colleges || []).map((item) => item.name).join(", ") || note.college %><% } %>
      </p>
    <% } %>
    <% if (note.isPublished) { %>
      <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
        <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-700 dark:bg-slate-800 dark:text-slate-200">External resource: <%= resourceSource.provider %></span>
        <% if (note.moderationStatus === "approved" && note.moderatedBy) { %>
          <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 font-semibold text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200"><i class="fa-solid fa-circle-check"></i> Reviewed by NoteSphere admin</span>
        <% } else { %>
          <span class="rounded-full bg-amber-50 px-3 py-1 text-amber-800 dark:bg-amber-950/40 dark:text-amber-200">Admin review not recorded</span>
        <% } %>
      </div>
    <% } %>
    <% if (canEditNote) { %>
      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800">
        <div>
          <p class="font-semibold text-slate-900 dark:text-white">Your note activity</p>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300"><%= note.downloadCount %> downloads · <%= note.likes.length %> likes</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/notes/<%= note._id %>/edit" class="rounded-full border border-blue-300 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50 dark:border-blue-800 dark:text-blue-300">Edit note</a>
          <form action="/notes/<%= note._id %>" method="POST" onsubmit="return confirm('Delete this note permanently?')">
            <input type="hidden" name="_method" value="DELETE">
            <button class="rounded-full border border-rose-300 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-50">Delete note</button>
          </form>
        </div>
      </div>
    <% } %>
    <div class="mt-6 flex flex-wrap gap-3">
      <% if (note.isPublished) { %>
        <a href="/notes/<%= note._id %>/download" id="note-download" class="rounded-full bg-blue-600 px-5 py-2.5 font-semibold text-white hover:bg-blue-700">
          <i class="fa-solid fa-arrow-up-right-from-square mr-1"></i> View source & download (<%= note.downloadCount %>)
        </a>
      <% } %>
      <% if (note.isPublished && currUser) { %>
        <button type="button" id="note-like" aria-pressed="<%= upvotedByMe %>" class="note-engagement-button rounded-full border px-5 py-2.5 font-semibold">
          <i class="<%= upvotedByMe ? 'fa-solid' : 'fa-regular' %> fa-thumbs-up"></i> Like (<span id="note-likes"><%= note.likes.length %></span>)
        </button>
        <button type="button" id="note-save" aria-pressed="<%= savedByMe %>" class="note-save-button rounded-full border px-5 py-2.5 font-semibold">
          <i class="<%= savedByMe ? 'fa-solid' : 'fa-regular' %> fa-bookmark"></i> <span><%= savedByMe ? "Saved" : "Save" %></span>
        </button>
      <% } else if (note.isPublished) { %>
        <a href="/login" class="rounded-full border px-5 py-2.5 font-semibold">Log in to like or save</a>
      <% } %>
      <button type="button" id="note-share" class="rounded-full border px-5 py-2.5 font-semibold">Share</button>
    </div>
  </article>

  <% if (note.isPublished) { %>
  <section class="mt-8 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
    <h2 class="text-xl font-bold">Comments (<%= note.comments.length %>)</h2>
    <% if (currUser) { %>
      <form action="/notes/<%= note._id %>/comments" method="POST" class="mt-4">
        <label for="note-comment" class="sr-only">Add a comment</label>
        <textarea id="note-comment" name="text" required maxlength="1000" rows="3" class="w-full rounded-lg border border-slate-300 bg-transparent p-3 dark:border-slate-700" placeholder="Add a helpful comment"></textarea>
        <button class="mt-3 rounded-full bg-blue-600 px-5 py-2.5 font-semibold text-white">Post comment</button>
      </form>
    <% } else { %>
      <p class="mt-3 text-sm text-slate-500"><a href="/login" class="text-blue-600 underline">Log in</a> to comment.</p>
    <% } %>
    <div class="mt-6 space-y-4">
      <% note.comments.slice().sort((a, b) => b.createdAt - a.createdAt).forEach(function (comment) { %>
        <article class="rounded-xl bg-slate-50 p-4 dark:bg-slate-800">
          <p class="text-sm font-semibold"><%= comment.user?.name || comment.user?.username || "Former user" %></p>
          <p class="mt-1 whitespace-pre-line text-slate-700 dark:text-slate-200"><%= comment.text %></p>
          <time class="mt-2 block text-xs text-slate-500"><%= new Date(comment.createdAt).toLocaleString() %></time>
        </article>
      <% }) %>
    </div>
  </section>
  <% } %>
</section>

<div id="download-campus-modal" class="fixed inset-0 z-[120] hidden items-center justify-center bg-slate-950/60 p-4" role="dialog" aria-modal="true" aria-labelledby="download-campus-title">
  <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl dark:bg-slate-900">
    <h2 id="download-campus-title" class="text-xl font-bold text-slate-900 dark:text-white">Your university details</h2>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Add your university and college once to improve campus-specific note search. Your details are saved with your account when signed in; for guests, they are remembered only for this browser session.</p>
    <form action="/notes/<%= note._id %>/download" method="POST" class="mt-5 space-y-4">
      <label class="block text-sm font-semibold">University
        <input name="university" required minlength="2" maxlength="160" value="<%= savedCampus.university || '' %>" autocomplete="organization" class="mt-1 w-full rounded-lg border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700">
      </label>
      <label class="block text-sm font-semibold">College
        <input name="college" required minlength="2" maxlength="160" value="<%= savedCampus.college || '' %>" autocomplete="organization" class="mt-1 w-full rounded-lg border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700">
      </label>
      <div class="flex justify-end gap-3">
        <button type="button" id="download-campus-cancel" class="rounded-full border px-4 py-2 font-semibold">Cancel</button>
        <button class="rounded-full bg-blue-600 px-5 py-2 font-semibold text-white">Continue to notes</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    var id = "<%= note._id %>";
    var like = document.getElementById("note-like");
    var save = document.getElementById("note-save");
    var share = document.getElementById("note-share");
    var downloadModal = document.getElementById("download-campus-modal");
    var downloadCancel = document.getElementById("download-campus-cancel");
    var downloadLink = document.getElementById("note-download");
    function post(url) {
      return fetch(url, { method: "POST", headers: { Accept: "application/json" } })
        .then(function (response) {
          if (!response.ok) throw new Error("Please sign in and try again.");
          return response.json();
        });
    }
    if (like) like.addEventListener("click", function () {
      post("/notes/" + id + "/like").then(function (result) {
        like.setAttribute("aria-pressed", result.liked);
        var icon = like.querySelector("i");
        icon.classList.toggle("fa-solid", result.liked);
        icon.classList.toggle("fa-regular", !result.liked);
        document.getElementById("note-likes").textContent = result.count;
      }).catch(function (error) { window.alert(error.message); });
    });
    if (save) save.addEventListener("click", function () {
      post("/notes/" + id + "/save").then(function (result) {
        save.setAttribute("aria-pressed", result.saved);
        save.querySelector("span").textContent = result.saved ? "Saved" : "Save";
        var icon = save.querySelector("i");
        icon.classList.toggle("fa-solid", result.saved);
        icon.classList.toggle("fa-regular", !result.saved);
      }).catch(function (error) { window.alert(error.message); });
    });
    if (share) share.addEventListener("click", function () {
      if (navigator.share) navigator.share({ title: document.title, url: location.href });
      else if (navigator.clipboard) navigator.clipboard.writeText(location.href).then(function () {
        window.alert("Link copied.");
      }).catch(function () { window.prompt("Copy this link:", location.href); });
      else window.prompt("Copy this link:", location.href);
    });
    if (downloadCancel && downloadModal) {
      downloadCancel.addEventListener("click", function () {
        downloadModal.classList.add("hidden");
        downloadModal.classList.remove("flex");
        history.replaceState({}, "", location.pathname);
      });
    }
    if (downloadModal && new URLSearchParams(location.search).get("downloadProfile") === "1") {
      downloadModal.classList.remove("hidden");
      downloadModal.classList.add("flex");
    }
    if (downloadLink) {
      downloadLink.addEventListener("click", function () {
        downloadLink.setAttribute("aria-busy", "true");
      });
    }
  })();
</script>
<style>
  .note-engagement-button[aria-pressed="true"],
  .note-save-button[aria-pressed="true"] {
    border-color: #0878e8;
    background: rgba(8, 120, 232, 0.12);
    color: #0878e8;
  }
  .dark .note-engagement-button[aria-pressed="true"],
  .dark .note-save-button[aria-pressed="true"] {
    background: rgba(8, 120, 232, 0.2);
    color: #93c5fd;
  }
</style>
