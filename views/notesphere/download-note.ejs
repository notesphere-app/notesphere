<% layout("/layouts/boilerplate") -%>

<main class="mx-auto flex min-h-[70vh] max-w-3xl items-center px-4 py-10 sm:px-6 lg:px-8">
  <article class="w-full rounded-3xl bg-white p-6 shadow-xl ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700 sm:p-9">
    <a href="/notes/<%= note._id %>" class="text-sm font-semibold text-blue-700 hover:underline">← Back to note details</a>
    <div class="mt-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-2xl text-blue-700 dark:bg-blue-950/50 dark:text-blue-300">
      <i class="fa-solid fa-arrow-up-right-from-square"></i>
    </div>
    <p class="mt-5 text-sm font-semibold uppercase tracking-wider text-blue-700">External learning resource</p>
    <h1 class="mt-2 break-words text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl"><%= note.title %></h1>
    <p class="mt-3 text-slate-600 dark:text-slate-300">This note is hosted outside NoteSphere. The button below opens the original file on its provider; NoteSphere does not host or copy the resource.</p>

    <dl class="mt-6 grid gap-4 rounded-2xl bg-slate-50 p-4 dark:bg-slate-800 sm:grid-cols-2">
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Link provider</dt><dd class="mt-1 break-all font-semibold text-slate-900 dark:text-white"><%= resourceSource.provider %></dd></div>
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Web address</dt><dd class="mt-1 break-all text-sm text-slate-700 dark:text-slate-200"><%= resourceSource.hostname %></dd></div>
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Course</dt><dd class="mt-1 text-sm text-slate-700 dark:text-slate-200"><%= note.course %> · <%= note.subject %></dd></div>
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Campus</dt><dd class="mt-1 break-words text-sm text-slate-700 dark:text-slate-200"><%= [(note.universities || []).map((item) => item.name).join(", ") || note.university, (note.colleges || []).map((item) => item.name).join(", ") || note.college].filter(Boolean).join(" · ") || "Not specified" %></dd></div>
    </dl>

    <% if (adminVerified) { %>
      <p class="mt-5 flex items-start gap-2 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-200">
        <i class="fa-solid fa-circle-check mt-0.5"></i><span><strong>Reviewed by a NoteSphere admin.</strong> This review indicates the submitted note link was checked during moderation. The external provider controls access and availability, so you may still need permission to open it.</span>
      </p>
    <% } else { %>
      <p class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">This link is published in the library, but no individual admin review record is available for it. Check the destination and its permissions before opening.</p>
    <% } %>

    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <a href="/notes/<%= note._id %>/download/open" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-blue-600 px-6 py-3 text-center font-semibold text-white hover:bg-blue-700">
        <i class="fa-solid fa-arrow-up-right-from-square"></i> Continue to <%= resourceSource.provider %>
      </a>
      <a href="/notes/<%= note._id %>" class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-300 px-6 py-3 text-center font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Cancel</a>
    </div>
  </article>
</main>
