<!-- =========================================
     Hero — Notes index
========================================= -->
<section class="relative overflow-hidden bg-[#FBFAF7] dark:bg-slate-950">
  <div class="pointer-events-none absolute -top-32 -left-24 h-72 w-72 rounded-full bg-[#0878E8]/10 blur-3xl sm:-left-32 sm:h-96 sm:w-96"></div>
  <div class="pointer-events-none absolute -bottom-40 -right-24 h-72 w-72 rounded-full bg-amber-400/10 blur-3xl sm:-right-32 sm:h-96 sm:w-96"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#0878E8]/25 bg-[#0878E8]/5 px-3 py-1 text-xs font-medium text-[#0878E8] sm:text-sm" data-reveal>
        <i class="fa-solid fa-book-open-reader"></i> Notes library
      </span>

      <h1 class="mt-5 text-3xl leading-tight text-[#022E5A] dark:text-white sm:text-4xl md:text-5xl" data-reveal data-reveal-delay="80">
        Every note you need, sorted by course
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-base text-slate-600 dark:text-slate-300 sm:text-lg" data-reveal data-reveal-delay="160">
        Free notebook scans, handwritten notes, and solved papers uploaded by students.
        Filter by course, semester, and type — download what you need instantly.
      </p>

      <form id="notes-search-form" class="mx-auto mt-8 max-w-2xl" data-reveal data-reveal-delay="240" onsubmit="return false;">
        <div class="relative">
          <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input
            id="notes-search"
            type="search"
            placeholder="Search by subject, title, or course…"
            aria-label="Search notes"
            class="w-full rounded-full border border-slate-300 bg-white py-3.5 pl-11 pr-32 text-sm text-slate-900
                   placeholder-slate-400 shadow-sm transition-colors
                   focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/25
                   dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder-slate-500"
          />
          <a href="/upload"
             class="absolute right-1.5 top-1/2 hidden -translate-y-1/2 items-center gap-2 rounded-full bg-[#0878E8] px-5 py-2.5 text-sm font-semibold text-white
                    shadow-sm transition-all hover:bg-[#0668CC] hover:-translate-y-0.5 sm:inline-flex">
            <i class="fa-solid fa-cloud-arrow-up"></i> Upload notes
          </a>
        </div>
      </form>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-500 dark:text-slate-400" data-reveal data-reveal-delay="300">
        <span class="flex items-center gap-1.5">
          <i class="fa-solid fa-file-pdf text-[#0878E8]"></i> 24,600+ notes
        </span>
        <span class="flex items-center gap-1.5">
          <i class="fa-solid fa-download text-[#0878E8]"></i> 189k+ downloads
        </span>
        <span class="flex items-center gap-1.5">
          <i class="fa-solid fa-users text-[#0878E8]"></i> 3,150+ contributors
        </span>
      </div>
    </div>
  </div>
</section>

<!-- =========================================
     Filters + Notes grid
========================================= -->
<section class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">

    <div class="grid gap-8 lg:grid-cols-12 lg:gap-8">

      <!-- Sidebar -->
      <aside class="lg:col-span-3" data-reveal>
        <div class="lg:sticky lg:top-24 space-y-6">

          <div class="rounded-2xl bg-[#FBFAF7] p-5 ring-1 ring-slate-200/70 dark:bg-slate-950 dark:ring-slate-800">
            <h3 class="text-[11px] font-semibold uppercase tracking-widest text-slate-400">Course</h3>
            <ul class="mt-3 space-y-1.5">
              <% courses.forEach(function (c) { %>
                <li>
                  <button type="button"
                          class="notes-filter-btn"
                          data-filter-type="course"
                          data-filter-value="<%= c.id %>"
                          aria-pressed="<%= c.id === 'all' ? 'true' : 'false' %>">
                    <i class="fa-solid <%= c.icon %>"></i>
                    <span><%= c.label %></span>
                  </button>
                </li>
              <% }) %>
            </ul>
          </div>

          <div class="rounded-2xl bg-[#FBFAF7] p-5 ring-1 ring-slate-200/70 dark:bg-slate-950 dark:ring-slate-800">
            <h3 class="text-[11px] font-semibold uppercase tracking-widest text-slate-400">Semester</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              <% semesters.forEach(function (s, i) { %>
                <button type="button"
                        class="notes-sem-pill"
                        data-filter-type="semester"
                        data-filter-value="<%= s === 'All' ? 'all' : s %>"
                        aria-pressed="<%= i === 0 ? 'true' : 'false' %>">
                  <%= s %>
                </button>
              <% }) %>
            </div>
          </div>

          <div class="rounded-2xl bg-[#FBFAF7] p-5 ring-1 ring-slate-200/70 dark:bg-slate-950 dark:ring-slate-800">
            <h3 class="text-[11px] font-semibold uppercase tracking-widest text-slate-400">File type</h3>
            <ul class="mt-3 space-y-1.5">
              <% fileTypes.forEach(function (f, i) { %>
                <li>
                  <button type="button"
                          class="notes-filter-btn"
                          data-filter-type="type"
                          data-filter-value="<%= f.id %>"
                          aria-pressed="<%= i === 0 ? 'true' : 'false' %>">
                    <i class="fa-regular fa-circle-check"></i>
                    <span><%= f.label %></span>
                  </button>
                </li>
              <% }) %>
            </ul>
          </div>

          <button type="button" id="notes-clear-all"
                  class="w-full rounded-full border border-slate-300 px-4 py-2.5 text-sm font-semibold text-[#022E5A]
                         transition-colors hover:bg-slate-900/5 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-white/10">
            <i class="fa-solid fa-rotate-right mr-1.5"></i> Clear all filters
          </button>
        </div>
      </aside>

      <!-- Grid -->
      <div class="lg:col-span-9" data-reveal data-reveal-delay="100">

        <div class="flex flex-col gap-3 border-b border-slate-200 pb-4 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-slate-500 dark:text-slate-400">
            Showing <span id="notes-count-visible" class="font-semibold text-[#022E5A] dark:text-white"><%= notes.length %></span>
            of <%= notes.length %> notes
          </p>

          <div class="flex items-center gap-2">
            <div class="relative">
              <label for="notes-sort" class="sr-only">Sort by</label>
              <select id="notes-sort"
                      class="appearance-none rounded-full border border-slate-300 bg-white py-2 pl-3.5 pr-9 text-xs font-medium text-slate-700
                             transition-colors focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/25
                             dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                <% sortOptions.forEach(function (o, i) { %>
                  <option value="<%= o.id %>" <%= i === 0 ? 'selected' : '' %>><%= o.label %></option>
                <% }) %>
              </select>
              <i class="fa-solid fa-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-slate-400"></i>
            </div>

            <div class="hidden overflow-hidden rounded-full border border-slate-300 dark:border-slate-700 sm:flex">
              <button type="button" id="view-grid" aria-label="Grid view" aria-pressed="true"
                      class="notes-view-btn">
                <i class="fa-solid fa-grip"></i>
              </button>
              <button type="button" id="view-list" aria-label="List view" aria-pressed="false"
                      class="notes-view-btn">
                <i class="fa-solid fa-list"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- Notes container -->
        <div id="notes-container" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-view="grid">
          <% notes.forEach(function (note, i) { %>
            <article
              class="note-card group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200/70
                     transition-all hover:-translate-y-1 hover:shadow-lg dark:bg-slate-900 dark:ring-slate-800"
              data-note-id="<%= note.id %>"
              data-course="<%= note.course %>"
              data-semester="<%= note.semester %>"
              data-type="<%= note.type %>"
              data-title="<%= note.title.toLowerCase() %>"
              data-subject="<%= note.subject.toLowerCase() %>"
              data-course-label="<%= note.courseLabel.toLowerCase() %>"
              data-downloads="<%= note.downloads %>"
              data-rating="<%= note.rating %>"
              data-pages="<%= note.pages %>"
              data-uploaded="<%= note.uploadedAt %>"
              data-reveal data-reveal-delay="<%= (i % 3) * 60 %>"
            >
              <div class="relative overflow-hidden h-44 sm:h-48">
                <img src="<%= note.cover %>" alt=""
                     class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />

                <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-red-500 shadow-sm backdrop-blur dark:bg-slate-900/90">
                  <i class="fa-solid fa-file-pdf"></i> PDF
                </span>

                <span class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-black/60 px-2.5 py-1 text-[10px] font-semibold text-white backdrop-blur">
                  <i class="fa-solid fa-download"></i> <span class="note-download-count"><%= note.downloads.toLocaleString() %></span>
                </span>

                <% if (note.featured) { %>
                  <span class="absolute -right-9 top-3 rotate-45 bg-amber-500 px-9 py-1 text-[9px] font-bold uppercase tracking-wider text-white shadow-md">
                    Featured
                  </span>
                <% } %>
              </div>

              <div class="flex flex-1 flex-col p-5">
                <div class="flex items-center flex-wrap gap-1.5">
                  <span class="rounded-full bg-[#0878E8]/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-[#0878E8]">
                    <%= note.courseLabel %>
                  </span>
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    Sem <%= note.semester %>
                  </span>
                  <span class="rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-400">
                    <%= note.typeLabel %>
                  </span>
                </div>

                <a href="/notes/<%= note.id %>" class="block">
                  <h3 class="mt-3 line-clamp-2 text-base font-semibold text-[#022E5A] transition-colors group-hover:text-[#0878E8] dark:text-white">
                    <%= note.title %>
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
                    <%= note.excerpt %>
                  </p>
                </a>

                <!-- Meta row -->
                <div class="mt-3 flex items-center gap-3 text-[11px] text-slate-500 dark:text-slate-400">
                  <span class="flex items-center gap-1">
                    <i class="fa-regular fa-file-lines"></i> <%= note.pages %> pages
                  </span>
                  <span class="flex items-center gap-1">
                    <i class="fa-regular fa-hard-drive"></i> <%= note.size %>
                  </span>
                  <span class="flex items-center gap-1 text-amber-500">
                    <i class="fa-solid fa-star"></i> <%= note.rating %>
                  </span>
                </div>

                <!-- ============ ACTION BAR ============ -->
                <!-- Thumbs-up + Save + Download, aligned to the same row -->
                <div class="mt-4 flex items-center justify-between gap-2 rounded-xl bg-slate-50 px-3 py-2 dark:bg-slate-800/50">
                  <div class="flex items-center gap-1">
                    <!-- Thumbs up -->
                    <button type="button"
                            class="note-upvote-btn group/btn flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-xs font-semibold text-slate-500
                                   transition-colors hover:bg-[#0878E8]/10 hover:text-[#0878E8]"
                            aria-label="Upvote this note"
                            aria-pressed="false">
                      <i class="fa-regular fa-thumbs-up text-sm"></i>
                      <span class="note-upvote-count"><%= note.upvotes %></span>
                    </button>

                    <!-- Save -->
                    <button type="button"
                            class="note-save-btn flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-xs font-semibold text-slate-500
                                   transition-colors hover:bg-amber-500/10 hover:text-amber-600"
                            aria-label="Save this note"
                            aria-pressed="false">
                      <i class="fa-regular fa-bookmark text-sm"></i>
                      <span class="note-save-label">Save</span>
                    </button>
                  </div>

                  <a href="/notes/<%= note.id %>/download"
                     class="note-download-btn inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#0878E8] px-3.5 py-1.5 text-xs font-semibold text-white
                            transition-colors hover:bg-[#0668CC]">
                    <i class="fa-solid fa-download"></i> Download
                  </a>
                </div>

                <!-- Author -->
                <div class="mt-3 flex items-center gap-2">
                  <img src="<%= note.avatar %>" alt="" class="h-6 w-6 shrink-0 rounded-full" />
                  <p class="truncate text-[11px] text-slate-500 dark:text-slate-400">
                    by <span class="font-medium text-slate-700 dark:text-slate-200"><%= note.author %></span> · <%= note.date %>
                  </p>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- Empty state -->
        <div id="notes-empty" class="hidden py-16 text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-400 dark:bg-slate-800 dark:text-slate-500">
            <i class="fa-solid fa-magnifying-glass text-xl"></i>
          </div>
          <h3 class="mt-4 text-base font-semibold text-[#022E5A] dark:text-white">No notes match those filters</h3>
          <p class="mt-1.5 text-sm text-slate-500 dark:text-slate-400">Try a different course or clear your filters.</p>
          <button type="button" id="notes-empty-clear"
            class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#0878E8] px-5 py-2.5 text-sm font-semibold text-white
                   transition-colors hover:bg-[#0668CC]">
            <i class="fa-solid fa-rotate-right"></i> Clear filters
          </button>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- =========================================
     Stats strip
========================================= -->
<section class="border-y border-slate-200 bg-[#FBFAF7] dark:border-slate-800 dark:bg-slate-950">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-10 sm:gap-8 sm:px-6 sm:py-12 md:grid-cols-4 lg:px-8">
    <% stats.forEach(function (s, i) { %>
      <div class="text-center" data-reveal data-reveal-delay="<%= i * 80 %>">
        <p class="text-2xl font-bold tabular-nums text-[#022E5A] dark:text-white sm:text-4xl">
          <span class="stat-count" data-target="<%= s.value %>" data-suffix="<%= s.suffix %>">0</span>
        </p>
        <p class="mt-1.5 text-[11px] font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400 sm:mt-2 sm:text-sm"><%= s.label %></p>
      </div>
    <% }) %>
  </div>
</section>

<!-- =========================================
     Final CTA
========================================= -->
<section class="bg-white dark:bg-slate-900">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8" data-reveal>
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#0878E8]/10 text-[#0878E8]">
      <i class="fa-solid fa-cloud-arrow-up text-2xl"></i>
    </div>
    <h2 class="mt-5 text-2xl text-[#022E5A] dark:text-white sm:text-3xl">Have notes others could use?</h2>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400 sm:text-base">
      Upload your notebook scans or PDFs once. They'll help thousands of students prepare better for their exams.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <button type="button" data-open-modal="signup"
        class="inline-flex items-center gap-2 rounded-full bg-[#0878E8] px-7 py-3 text-sm font-semibold text-white
               shadow-sm transition-all hover:bg-[#0668CC] hover:shadow-md hover:-translate-y-0.5">
        <i class="fa-solid fa-cloud-arrow-up"></i> Upload notes
      </button>
      <a href="/about"
        class="rounded-full border border-slate-300 px-7 py-3 text-sm font-semibold text-[#022E5A]
               transition-colors hover:bg-slate-900/5 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-white/10">
