<!-- =========================================
     Page-specific styles
========================================= -->
<style>
  html, body { overflow-x: clip; max-width: 100%; }

  /* ---------- Sidebar filter buttons ---------- */
  .notes-filter-btn {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border-radius: 0.6rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgb(51 65 85);
    background: transparent;
    transition: all 0.15s ease;
    text-align: left;
  }
  .dark .notes-filter-btn { color: rgb(203 213 225); }
  .notes-filter-btn i { color: rgb(148 163 184); font-size: 0.8rem; transition: color 0.15s ease; }
  .notes-filter-btn:hover { background: rgba(8, 120, 232, 0.06); color: #0878E8; }
  .notes-filter-btn:hover i { color: #0878E8; }
  .notes-filter-btn[aria-pressed="true"] {
    background: #0878E8;
    color: #fff;
    font-weight: 600;
    box-shadow: 0 6px 16px -6px rgba(8, 120, 232, 0.5);
  }
  .notes-filter-btn[aria-pressed="true"] i { color: #fff; }

  /* ---------- Semester pills ---------- */
  .notes-sem-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    padding: 0.4rem 0.7rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(71 85 105);
    background: rgb(241 245 249);
    transition: all 0.15s ease;
    cursor: pointer;
  }
  .dark .notes-sem-pill { background: rgb(30 41 59); color: rgb(148 163 184); }
  .notes-sem-pill:hover { background: rgba(8, 120, 232, 0.1); color: #0878E8; }
  .notes-sem-pill[aria-pressed="true"] {
    background: #0878E8;
    color: #fff;
    box-shadow: 0 6px 16px -6px rgba(8, 120, 232, 0.5);
  }

  /* ---------- View toggle ---------- */
  .notes-view-btn {
    display: flex;
    height: 2.25rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    background: #fff;
    color: rgb(100 116 139);
    font-size: 0.8rem;
    transition: all 0.15s ease;
  }
  .dark .notes-view-btn { background: rgb(15 23 42); color: rgb(148 163 184); }
  .notes-view-btn:hover { color: #0878E8; }
  .notes-view-btn[aria-pressed="true"] { background: #0878E8; color: #fff; }

  /* ---------- Grid vs list ---------- */
  #notes-container[data-view="list"] {
    display: flex !important;
    flex-direction: column;
    gap: 0.75rem;
  }
  #notes-container[data-view="list"] .note-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    #notes-container[data-view="list"] .note-card {
      grid-template-columns: 200px 1fr;
    }
    #notes-container[data-view="list"] .note-card > div:first-child {
      height: 100%;
      min-height: 140px;
    }
    #notes-container[data-view="list"] .note-card h3 { font-size: 1rem; }
    #notes-container[data-view="list"] .note-card p {
      -webkit-line-clamp: 1;
      line-clamp: 1;
    }
  }

  .note-card.is-filtered-out { display: none; }

  /* ============================================================
     UPVOTE (thumbs-up) button
  ============================================================ */
  .note-upvote-btn[aria-pressed="true"] {
    background: rgba(8, 120, 232, 0.12);
    color: #0878E8;
  }
  .note-upvote-btn[aria-pressed="true"] i {
    color: #0878E8;
  }
  /* Pop animation when clicked */
  @keyframes noteUpvotePop {
    0%   { transform: scale(1); }
    45%  { transform: scale(1.25); }
    100% { transform: scale(1); }
  }
  .note-upvote-btn.is-popping i {
    animation: noteUpvotePop 0.3s ease;
  }

  /* ============================================================
     SAVE (bookmark) button
  ============================================================ */
  .note-save-btn[aria-pressed="true"] {
    background: rgba(245, 158, 11, 0.12);
    color: #d97706;
  }
  .note-save-btn[aria-pressed="true"] i {
    color: #d97706;
  }
  .dark .note-save-btn[aria-pressed="true"] {
    background: rgba(245, 158, 11, 0.18);
    color: #fbbf24;
  }
  .dark .note-save-btn[aria-pressed="true"] i { color: #fbbf24; }

  @keyframes noteSavePop {
    0%   { transform: scale(1); }
    45%  { transform: scale(1.2); }
    100% { transform: scale(1); }
  }
  .note-save-btn.is-popping i {
    animation: noteSavePop 0.3s ease;
  }

  /* ---------- Download press feedback ---------- */
  .note-download-btn:active { transform: scale(0.96); }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .note-card, .notes-filter-btn, .notes-sem-pill, .notes-view-btn,
    .note-download-btn, .note-upvote-btn, .note-save-btn {
      transition: none !important;
      transform: none !important;
      animation: none !important;
    }
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>

<!-- =========================================
     Page-specific scripts
========================================= -->
<script>
  (function () {
    /* ============================================================
       FILTER / SORT / VIEW  (unchanged from before)
    ============================================================ */
    var state = {
      course: 'all',
      semester: 'all',
      type: 'all',
      query: '',
      sort: 'popular',
      view: 'grid'
    };

    var container = document.getElementById('notes-container');
    var emptyEl   = document.getElementById('notes-empty');
    var countEl   = document.getElementById('notes-count-visible');
    var searchEl  = document.getElementById('notes-search');
    var sortEl    = document.getElementById('notes-sort');
    var cards     = container ? Array.from(container.querySelectorAll('.note-card')) : [];

    function applyFilters() {
      var q = state.query.trim().toLowerCase();
      var visible = 0;

      cards.forEach(function (card) {
        var course = card.dataset.course || '';
        var sem    = card.dataset.semester || '';
        var type   = card.dataset.type || '';
        var title  = card.dataset.title || '';
        var subj   = card.dataset.subject || '';
        var courseLabel = card.dataset.courseLabel || '';

        var matchesCourse   = state.course === 'all'   || course === state.course;
        var matchesSemester = state.semester === 'all' || sem === state.semester;
        var matchesType     = state.type === 'all'     || type === state.type;
        var matchesQuery    = !q || title.indexOf(q) !== -1 || subj.indexOf(q) !== -1 || courseLabel.indexOf(q) !== -1;

        var show = matchesCourse && matchesSemester && matchesType && matchesQuery;
        card.classList.toggle('is-filtered-out', !show);
        if (show) visible++;
      });

      if (countEl) countEl.textContent = visible;
      if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
      if (container) container.classList.toggle('hidden', visible === 0);
    }

    function sortCards() {
      if (!container || !cards.length) return;
      var sorted = cards.slice().sort(function (a, b) {
        if (state.sort === 'popular')  return (+b.dataset.downloads) - (+a.dataset.downloads);
        if (state.sort === 'recent')   return (+b.dataset.uploaded)  - (+a.dataset.uploaded);
        if (state.sort === 'rating')   return (+b.dataset.rating)    - (+a.dataset.rating);
        if (state.sort === 'pages')    return (+b.dataset.pages)     - (+a.dataset.pages);
        return 0;
      });
      sorted.forEach(function (c) { container.appendChild(c); });
    }

    document.querySelectorAll('.notes-filter-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var type = btn.dataset.filterType;
        var value = btn.dataset.filterValue;
        state[type] = value;
        document.querySelectorAll('.notes-filter-btn[data-filter-type="' + type + '"]').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b === btn));
        });
        applyFilters();
      });
    });

    document.querySelectorAll('.notes-sem-pill').forEach(function (pill) {
      pill.addEventListener('click', function () {
        state.semester = pill.dataset.filterValue;
        document.querySelectorAll('.notes-sem-pill').forEach(function (p) {
          p.setAttribute('aria-pressed', String(p === pill));
        });
        applyFilters();
      });
    });

    if (searchEl) {
      var debounce = null;
      searchEl.addEventListener('input', function () {
        clearTimeout(debounce);
        debounce = setTimeout(function () {
          state.query = searchEl.value;
          applyFilters();
        }, 180);
      });
    }

    if (sortEl) {
      sortEl.addEventListener('change', function () {
        state.sort = sortEl.value;
        sortCards();
      });
      sortCards();
    }

    var viewGridBtn = document.getElementById('view-grid');
    var viewListBtn = document.getElementById('view-list');

    function setView(v) {
      state.view = v;
      if (container) container.dataset.view = v;
      if (viewGridBtn) viewGridBtn.setAttribute('aria-pressed', String(v === 'grid'));
      if (viewListBtn) viewListBtn.setAttribute('aria-pressed', String(v === 'list'));
      try { localStorage.setItem('ns-notes-view', v); } catch (e) {}
    }

    if (viewGridBtn) viewGridBtn.addEventListener('click', function () { setView('grid'); });
    if (viewListBtn) viewListBtn.addEventListener('click', function () { setView('list'); });

    try {
      var savedView = localStorage.getItem('ns-notes-view');
      if (savedView === 'list' || savedView === 'grid') setView(savedView);
    } catch (e) {}

    function clearAll() {
      state.course = 'all';
      state.semester = 'all';
      state.type = 'all';
      state.query = '';
      if (searchEl) searchEl.value = '';
      document.querySelectorAll('.notes-filter-btn').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.dataset.filterValue === 'all'));
      });
      document.querySelectorAll('.notes-sem-pill').forEach(function (p) {
        p.setAttribute('aria-pressed', String(p.dataset.filterValue === 'all'));
      });
      applyFilters();
    }

    var clearBtn = document.getElementById('notes-clear-all');
    var emptyClear = document.getElementById('notes-empty-clear');
    if (clearBtn) clearBtn.addEventListener('click', clearAll);
    if (emptyClear) emptyClear.addEventListener('click', clearAll);

    /* ============================================================
       UPVOTE (thumbs-up) + SAVE (bookmark) — persisted in localStorage
       ------------------------------------------------------------
       Each note card has data-note-id. We keep two sets:
         ns-upvotes → array of note ids the user upvoted
         ns-saves   → array of note ids the user saved
       On page load, we restore the visual state + counters.

       When the real backend exists, replace the persist() call
       with a fetch() to /api/notes/:id/upvote and /api/notes/:id/save,
       and swap localStorage reads for server-provided `upvotedByMe`
       and `savedByMe` flags passed through res.render().
    ============================================================ */
    var STORAGE_UPVOTES = 'ns-upvotes';
    var STORAGE_SAVES   = 'ns-saves';

    function readSet(key) {
      try {
        var raw = localStorage.getItem(key);
        return raw ? new Set(JSON.parse(raw)) : new Set();
      } catch (e) { return new Set(); }
    }
    function writeSet(key, set) {
      try { localStorage.setItem(key, JSON.stringify(Array.from(set))); } catch (e) {}
    }

    var upvotedIds = readSet(STORAGE_UPVOTES);
    var savedIds   = readSet(STORAGE_SAVES);

    /* ---------- Upvote buttons ---------- */
    document.querySelectorAll('.note-upvote-btn').forEach(function (btn) {
      var card = btn.closest('.note-card');
      if (!card) return;
      var id = card.dataset.noteId;
      var iconEl = btn.querySelector('i');
      var countEl = btn.querySelector('.note-upvote-count');

      // Restore state if previously upvoted
      if (upvotedIds.has(id)) {
        btn.setAttribute('aria-pressed', 'true');
        iconEl.classList.remove('fa-regular');
        iconEl.classList.add('fa-solid');
      }

      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        var isUpvoted = btn.getAttribute('aria-pressed') === 'true';
        var currentCount = Number(countEl.textContent) || 0;

        if (isUpvoted) {
          // Undo upvote
          btn.setAttribute('aria-pressed', 'false');
          iconEl.classList.add('fa-regular');
          iconEl.classList.remove('fa-solid');
          countEl.textContent = String(Math.max(0, currentCount - 1));
          upvotedIds.delete(id);
        } else {
          // Add upvote
          btn.setAttribute('aria-pressed', 'true');
          iconEl.classList.remove('fa-regular');
          iconEl.classList.add('fa-solid');
          countEl.textContent = String(currentCount + 1);
          upvotedIds.add(id);
        }

        // Pop animation
        btn.classList.add('is-popping');
        setTimeout(function () { btn.classList.remove('is-popping'); }, 320);

        writeSet(STORAGE_UPVOTES, upvotedIds);

        /* TODO: replace with a real API call
        fetch('/api/notes/' + id + '/upvote', {
          method: isUpvoted ? 'DELETE' : 'POST',
          headers: { 'Accept': 'application/json' }
        });
        */
      });
    });

    /* ---------- Save buttons ---------- */
    document.querySelectorAll('.note-save-btn').forEach(function (btn) {
      var card = btn.closest('.note-card');
      if (!card) return;
      var id = card.dataset.noteId;
      var iconEl = btn.querySelector('i');
      var labelEl = btn.querySelector('.note-save-label');

      function paint(saved) {
        btn.setAttribute('aria-pressed', String(saved));
        if (saved) {
          iconEl.classList.remove('fa-regular');
          iconEl.classList.add('fa-solid');
          if (labelEl) labelEl.textContent = 'Saved';
        } else {
          iconEl.classList.add('fa-regular');
          iconEl.classList.remove('fa-solid');
          if (labelEl) labelEl.textContent = 'Save';
        }
      }

      // Restore state if previously saved
      paint(savedIds.has(id));

      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        var isSaved = btn.getAttribute('aria-pressed') === 'true';
        if (isSaved) {
          savedIds.delete(id);
          paint(false);
        } else {
          savedIds.add(id);
          paint(true);
        }

        btn.classList.add('is-popping');
        setTimeout(function () { btn.classList.remove('is-popping'); }, 320);

        writeSet(STORAGE_SAVES, savedIds);

        /* TODO: replace with a real API call
        fetch('/api/notes/' + id + '/save', {
          method: isSaved ? 'DELETE' : 'POST',
          headers: { 'Accept': 'application/json' }
        });
        */
      });
    });

    /* ============================================================
       Stats count-up
    ============================================================ */
    (function statCounters() {
      var els = document.querySelectorAll('.stat-count');
      if (!els.length) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function animate(el) {
        var target = Number(el.dataset.target) || 0;
        var suffix = el.dataset.suffix || '';
        if (reduce) { el.textContent = target.toLocaleString() + suffix; return; }
        var start = performance.now();
        var duration = 1800;
        function frame(now) {
          var p = Math.min((now - start) / duration, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          var value = Math.floor(eased * target);
          el.textContent = value.toLocaleString() + (p === 1 ? suffix : '');
          if (p < 1) requestAnimationFrame(frame);
          else el.textContent = target.toLocaleString() + suffix;
        }
        requestAnimationFrame(frame);
      }

      var io = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { animate(e.target); obs.unobserve(e.target); }
        });
      }, { threshold: 0.4 });
      els.forEach(function (el) { io.observe(el); });
    })();

    /* ============================================================
       Guard: no auto-scroll on load
    ============================================================ */
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.addEventListener('load', function () {
      if (!sessionStorage.getItem('ns-notes-visited')) {
        window.scrollTo(0, 0);
        sessionStorage.setItem('ns-notes-visited', '1');
      }
    });
  })();
</script>