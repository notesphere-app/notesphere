<% layout("/layouts/boilerplate") -%>
<%
/* The featured content and metrics are supplied by the home controller. */

const features = [
  { icon: "fa-cloud-arrow-up", title: "Share your notes", desc: "Add a title, course, subject, and public resource link. Student submissions are reviewed before publication." },
  { icon: "fa-magnifying-glass", title: "Find exactly what you need", desc: "Browse published notes by course, semester, and subject to find relevant study material." },
  { icon: "fa-download", title: "Open shared resources", desc: "Review the resource details and open the public link provided with each note. No signup wall for published notes." },
  { icon: "fa-star", title: "Rated by students", desc: "Upvote notes that helped you. The highest-rated ones rise to the top, so quality takes care of itself." },
];

const stats = Array.isArray(homeStats) && homeStats.length ? homeStats : [
  { label: "Published notes", value: 0, suffix: "" },
  { label: "Community members", value: 0, suffix: "" },
  { label: "Downloads recorded", value: 0, suffix: "" },
  { label: "Active courses", value: 0, suffix: "" },
];
const trendingNotes = Array.isArray(featuredNotes) ? featuredNotes : [];
const latestBlogs = Array.isArray(homeBlogs) ? homeBlogs : [];
const activityItems = Array.isArray(homeActivity) ? homeActivity : [];
const subjects = Array.isArray(homeSubjects) ? homeSubjects : [];
const courses = Array.isArray(homeCourses) ? homeCourses : [];
const testimonials = [
  { quote: "I needed a clear set of revision notes before an exam. Finding an organized resource saved me time and helped me focus.", name: "Rhea Kapoor", role: "B.Tech, 3rd Year" },
  { quote: "Sharing my handwritten notes is a simple way to help students taking the same course after me.", name: "Yash Thakur", role: "B.Sc, Final Year" },
  { quote: "Course and semester filters make it easier to narrow down material for a particular subject.", name: "Nikhil Bansal", role: "B.Com, 2nd Year" },
  { quote: "A shared place for class notes makes group study more organized and saves everyone from searching old chats.", name: "Simran Kaur", role: "B.Tech, 2nd Year" },
  { quote: "I like being able to check the resource details before opening a study link.", name: "Aditya Joshi", role: "BBA, 1st Year" },
  { quote: "A free, student-focused library is a practical way to make study resources easier to find.", name: "Neha Prasad", role: "B.A. English, 3rd Year" },
];
%>

<!-- =========================================
     Hero — animated "note upload" demo
========================================= -->
<section id="hero" class="relative overflow-hidden bg-[#FBFAF7] dark:bg-slate-950">
  <!-- soft radial glows -->
  <div class="pointer-events-none absolute -top-32 -left-32 h-96 w-96 rounded-full bg-[#0878E8]/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-40 -right-32 h-96 w-96 rounded-full bg-amber-400/10 blur-3xl"></div>

  <div class="relative mx-auto grid grid-cols-1 max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 md:items-center md:gap-12 md:py-24 lg:px-8">

    <div data-reveal>
      <span class="inline-flex items-center gap-2 rounded-full border border-[#0878E8]/25 bg-[#0878E8]/5 px-3 py-1 text-xs font-medium text-[#0878E8] sm:text-sm">
        <i class="fa-solid fa-cloud-arrow-up"></i> Community notes, free forever
      </span>

      <h1 class="mt-5 text-3xl leading-tight text-[#022E5A] dark:text-white sm:text-4xl md:text-5xl">
        Notes that get you through the exam — shared by students like you
      </h1>

      <p class="mt-5 max-w-md text-base text-slate-600 dark:text-slate-300 sm:text-lg">
        NoteSphere is a free library of class notes, notebook scans, and handwritten PDFs uploaded
        by students. Find what you need, download it, and pass it on.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/notes"
          class="rounded-full bg-[#0878E8] px-6 py-3 text-sm font-semibold text-white shadow-sm
                 transition-all hover:bg-[#0668CC] hover:shadow-md hover:-translate-y-0.5">
          <i class="fa-solid fa-magnifying-glass mr-1.5"></i> Browse notes
        </a>
        <button type="button" data-open-modal="signup"
          class="rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-[#022E5A]
                 transition-colors hover:bg-slate-900/5 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-white/10">
          <i class="fa-solid fa-upload mr-1.5"></i> Upload yours
        </button>
      </div>

      <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">No credit card. No signup needed to download.</p>
    </div>

    <!-- Recent note preview -->
    <div class="relative mx-auto w-full max-w-md" data-reveal data-reveal-delay="150">
      <!-- Decorative stacked papers behind -->
      <div class="pointer-events-none absolute -inset-3 top-6 rounded-2xl bg-white shadow-xl ring-1 ring-slate-200/70 dark:bg-slate-900 dark:ring-slate-800"
           style="transform: rotate(-5deg);"></div>
      <div class="pointer-events-none absolute -inset-3 top-6 translate-x-3 translate-y-3 rounded-2xl bg-white shadow-xl ring-1 ring-slate-200/70 dark:bg-slate-900 dark:ring-slate-800"
           style="transform: rotate(3deg);"></div>

      <!-- Main card -->
      <div class="relative flex min-h-[20rem] flex-col rounded-2xl bg-white p-5 shadow-2xl ring-1 ring-slate-200/70
                  dark:bg-slate-900 dark:ring-slate-800 sm:min-h-[22rem] sm:p-6">

        <div class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
          <span class="ml-auto text-[10px] font-semibold uppercase tracking-wider text-slate-400"><%= heroNote ? "Recently shared" : "Community library" %></span>
        </div>

        <div class="mt-4 flex items-center gap-3 rounded-xl bg-slate-50 p-3 dark:bg-slate-800/60">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-red-500/10 text-red-500">
            <i class="fa-solid fa-file-pdf text-xl"></i>
          </div>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-[#022E5A] dark:text-white">
              <%= heroNote ? heroNote.title : "A shared study library for every course" %>
            </p>
            <p class="mt-0.5 truncate text-xs text-slate-500 dark:text-slate-400">
              <%= heroNote ? [heroNote.course, heroNote.subject].filter(Boolean).join(" · ") : "Published resources from the NoteSphere community" %>
            </p>
          </div>
        </div>

        <p class="mt-5 line-clamp-3 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          <%= heroNote ? heroNote.description : "Browse course-organized notes, or share a resource to help another student." %>
        </p>

        <div class="mt-auto flex items-center justify-between gap-3 pt-6">
          <div class="min-w-0">
            <% if (heroNote) { %>
              <p class="truncate text-xs font-semibold text-slate-700 dark:text-slate-200"><%= heroNote.author %></p>
              <p class="text-[10px] text-slate-400"><%= heroNote.createdAt ? new Date(heroNote.createdAt).toLocaleDateString("en-IN") : "Recently added" %></p>
            <% } else { %>
              <p class="text-xs font-semibold text-slate-700 dark:text-slate-200">A student-powered learning space</p>
              <p class="text-[10px] text-slate-400">New resources are added by the community</p>
            <% } %>
          </div>
          <% if (heroNote) { %>
            <a href="/notes/<%= heroNote.id %>" class="shrink-0 rounded-full bg-[#0878E8] px-4 py-2 text-xs font-semibold text-white transition hover:bg-[#0668CC]">View note</a>
          <% } else { %>
            <a href="/notes" class="shrink-0 rounded-full bg-[#0878E8] px-4 py-2 text-xs font-semibold text-white transition hover:bg-[#0668CC]">Browse notes</a>
          <% } %>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- =========================================
     Stats bar — animated count-up
========================================= -->
<section class="border-y border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-10 sm:gap-8 sm:px-6 sm:py-12 md:grid-cols-4 lg:px-8">
    <% stats.forEach(function (s, i) { %>
      <div class="text-center" data-reveal data-reveal-delay="<%= i * 80 %>">
        <p class="text-2xl font-bold tabular-nums text-[#022E5A] dark:text-white sm:text-4xl">
          <span class="stat-count" data-target="<%= s.value %>" data-suffix="<%= s.suffix %>">0</span>
        </p>
        <p class="mt-1.5 text-[11px] font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400 sm:mt-2 sm:text-sm"><%= s.label %></p>
      </div>
    <% }) %>
  </div>
</section>

<!-- =========================================
     Trending Notes — the actual notes library
========================================= -->
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
  <div class="mb-6 flex flex-col gap-4 sm:mb-4" data-reveal>
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl text-[#022E5A] dark:text-white sm:text-3xl">Popular notes in the library</h2>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 sm:text-base">Published resources ranked by downloads and recent activity.</p>
      </div>
      <a href="/notes" class="hidden shrink-0 text-sm font-semibold text-[#0878E8] hover:underline sm:block">Browse all →</a>
    </div>
  </div>

  <!-- Search + sort controls -->
  <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" data-reveal data-reveal-delay="60">
    <div class="relative w-full sm:max-w-xs">
      <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
      <input id="notes-search" type="text" placeholder="Search notes by title or subject..."
        class="w-full rounded-full border border-slate-300 bg-white py-2.5 pl-10 pr-4 text-sm text-slate-900
               focus:border-[#0878E8] focus:outline-none focus:ring-2 focus:ring-[#0878E8]/30
               dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
    </div>
    <div id="notes-sort" class="flex flex-wrap gap-2">
      <button type="button" class="sort-chip is-active" data-sort="trending">Trending</button>
      <button type="button" class="sort-chip" data-sort="newest">Newest</button>
      <button type="button" class="sort-chip" data-sort="downloads">Most downloaded</button>
    </div>
  </div>

  <div id="trending-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:auto-rows-[minmax(18rem,auto)] lg:gap-6">
    <% trendingNotes.forEach(function (note, i) { %>
      <article
        class="trending-card group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200/70
               transition-all hover:-translate-y-1 hover:shadow-lg dark:bg-slate-900 dark:ring-slate-800
               <%= note.featured ? 'sm:col-span-2 lg:col-span-2 lg:col-start-1 lg:row-start-1' : note.featuredBelow ? 'sm:col-span-2 lg:col-span-2 lg:col-start-1 lg:row-start-2' : 'lg:col-start-' + (i % 2 === 1 ? '3' : '4') + ' lg:row-start-' + (i <= 2 ? '1' : '2') %>"
        data-reveal data-reveal-delay="<%= (i % 4) * 80 %>"
        data-order="<%= i %>"
        data-recency="<%= note.recency %>"
        data-downloads="<%= note.downloadsNum %>"
        data-title="<%= note.title %>"
        data-tag="<%= note.tag %>"
      >
        <div class="relative overflow-hidden <%= note.featured ? 'h-48 sm:h-56 lg:h-64' : 'h-40 sm:h-36' %>">
          <img src="<%= note.cover %>" alt="" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />

          <!-- PDF badge -->
          <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-red-500 shadow-sm backdrop-blur dark:bg-slate-900/90">
            <i class="fa-solid fa-file-pdf"></i> PDF
          </span>

          <!-- Downloads chip -->
          <span class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-black/60 px-2.5 py-1 text-[10px] font-semibold text-white backdrop-blur">
            <i class="fa-solid fa-download"></i> <%= note.downloads %>
          </span>
        </div>

        <div class="flex flex-1 flex-col p-5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wide text-[#0878E8]"><%= note.tag %></span>
            <% if (note.featured) { %>
              <span class="rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-600">Featured</span>
            <% } %>
          </div>

          <h3 class="mt-2 line-clamp-2 <%= note.featured ? 'text-lg sm:text-xl' : 'text-base' %> font-semibold text-[#022E5A] dark:text-white">
            <a href="/notes/<%= note.id %>" class="transition-colors hover:text-[#0878E8]"><%= note.title %></a>
          </h3>
          <p class="mt-2 line-clamp-2 text-sm text-slate-500 dark:text-slate-400"><%= note.excerpt %></p>

          <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4 dark:border-slate-800">
            <div class="flex min-w-0 items-center gap-2">
              <img src="<%= note.avatar %>" alt="" class="h-7 w-7 shrink-0 rounded-full" />
              <div class="min-w-0">
                <p class="truncate text-xs font-medium text-slate-700 dark:text-slate-200"><%= note.author %></p>
                <p class="text-[11px] text-slate-400"><%= note.pages %></p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <a href="/notes/<%= note.id %>" class="flex items-center gap-1 text-xs text-slate-400 transition-colors hover:text-emerald-500" aria-label="View note likes">
                <i class="fa-regular fa-thumbs-up"></i> <span><%= note.upvotes %></span>
              </a>
              <a href="/notes/<%= note.id %>" class="text-xs text-slate-400 transition-colors hover:text-[#0878E8]" aria-label="Open note to save it">
                <i class="fa-regular fa-bookmark"></i>
              </a>
              <a href="/notes/<%= note.id %>"
                class="shrink-0 rounded-full bg-[#0878E8] px-3 py-1.5 text-xs font-semibold text-white
                       transition-colors hover:bg-[#0668CC]">
                View note
              </a>
            </div>
          </div>
        </div>
      </article>
    <% }) %>

    <% if (!trendingNotes.length) { %>
      <p class="col-span-full py-10 text-center text-sm text-slate-500 dark:text-slate-400">
        No published notes yet. Check back soon or <a class="font-semibold text-[#0878E8] hover:underline" href="/notes">browse the library</a>.
      </p>
    <% } %>
    <p id="notes-empty" class="col-span-full hidden py-10 text-center text-sm text-slate-400">
      No notes match your search — try a different subject or title.
    </p>
  </div>

  <a href="/notes" class="mt-6 block text-center text-sm font-semibold text-[#0878E8] hover:underline sm:hidden">Browse all notes →</a>
</section>

<!-- =========================================
     Browse Notes by Course
========================================= -->
<section class="bg-white dark:bg-slate-900">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="text-2xl text-[#022E5A] dark:text-white sm:text-3xl">Browse notes by course</h2>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 sm:text-base">Choose a course to browse its published notes and available study resources.</p>
    </div>

    <% if (courses.length) { %>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal data-reveal-delay="100">
        <% courses.forEach(function (course) { %>
          <a href="/notes?course=<%= course.id %>" class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200/70 transition hover:-translate-y-1 hover:shadow-md dark:bg-slate-950 dark:ring-slate-800">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#0878E8]/10 text-[#0878E8]"><i class="fa-solid fa-graduation-cap"></i></span>
            <h3 class="mt-4 font-semibold text-[#022E5A] dark:text-white"><%= course.name %></h3>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= course.semesterCount %> semesters · <%= course.noteCount %> published notes</p>
            <% if (course.specializations.length) { %>
              <p class="mt-2 line-clamp-2 text-xs text-slate-400"><%= course.specializations.join(" · ") %></p>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="mt-8 rounded-2xl bg-white p-6 text-center text-sm text-slate-500 shadow-sm dark:bg-slate-950 dark:text-slate-400">Courses will appear here as soon as they are added.</p>
    <% } %>
  </div>
</section>

<!-- =========================================
     Features
========================================= -->
<section class="bg-[#FBFAF7] dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="text-2xl text-[#022E5A] dark:text-white sm:text-3xl">Built for students, by students</h2>
      <p class="mt-3 text-sm text-slate-500 dark:text-slate-400 sm:text-base">Share a useful resource and help fellow students. Download freely, whenever you need.</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:mt-12 sm:grid-cols-2 sm:gap-8 lg:grid-cols-4">
      <% features.forEach(function (f, i) { %>
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200/70 transition-transform hover:-translate-y-1
                    dark:bg-slate-900 dark:ring-slate-800"
             data-reveal data-reveal-delay="<%= i * 100 %>">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#0878E8]/10 text-[#0878E8]">
            <i class="fa-solid <%= f.icon %>"></i>
          </div>
          <h3 class="mt-4 font-semibold text-[#022E5A] dark:text-white"><%= f.title %></h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400"><%= f.desc %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- =========================================
     Latest Blogs — split layout
========================================= -->
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
  <div class="mb-8 flex items-end justify-between gap-4 sm:mb-10" data-reveal>
    <div>
      <h2 class="text-2xl text-[#022E5A] dark:text-white sm:text-3xl">From the blog</h2>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 sm:text-base">Study tips, note-taking ideas, and stories from students.</p>
    </div>
    <a href="/blogs" class="hidden text-sm font-semibold text-[#0878E8] hover:underline sm:block">Read more →</a>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8">

    <!-- LEFT: blog list -->
    <div class="min-w-0 space-y-4 lg:col-span-7 lg:space-y-5">
      <% latestBlogs.forEach(function (post, i) { %>
        <article
          class="blog-item group flex flex-col gap-3 overflow-hidden rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200/70
                 transition-all hover:-translate-y-1 hover:shadow-lg
                 dark:bg-slate-900 dark:ring-slate-800 sm:flex-row sm:gap-4"
          data-blog-index="<%= i %>"
          style="--blog-delay: <%= i * 90 %>ms;"
        >
          <div class="relative shrink-0 overflow-hidden rounded-xl <%= i === 0 ? 'h-44 w-full sm:h-32 sm:w-40 lg:h-36 lg:w-48' : 'h-36 w-full sm:h-24 sm:w-32' %>">
            <img src="<%= post.cover %>" alt=""
                 class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
            <% if (i === 0) { %>
              <span class="absolute left-3 top-3 rounded-full bg-amber-500/90 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-white shadow-sm">Featured</span>
            <% } %>
          </div>

          <div class="flex min-w-0 flex-1 flex-col">
            <a href="/blogs/<%= post.id %>" class="block">
              <h3 class="line-clamp-2 <%= i === 0 ? 'text-base sm:text-base' : 'text-sm' %> font-semibold text-[#022E5A] transition-colors group-hover:text-[#0878E8] dark:text-white sm:text-base">
                <%= post.title %>
              </h3>
              <p class="mt-1 line-clamp-2 text-xs text-slate-500 dark:text-slate-400 sm:text-sm"><%= post.excerpt %></p>
            </a>

            <div class="mt-3 flex flex-wrap items-center justify-between gap-2 sm:mt-auto sm:pt-3">
              <div class="flex min-w-0 items-center gap-2">
                <img src="<%= post.avatar %>" alt="" class="h-6 w-6 shrink-0 rounded-full sm:h-7 sm:w-7" />
                <div class="min-w-0 leading-tight">
                  <p class="truncate text-[11px] font-medium text-slate-700 dark:text-slate-200 sm:text-xs"><%= post.author %></p>
                  <p class="text-[10px] text-slate-400 sm:text-[11px]"><%= post.date %></p>
                </div>
              </div>

              <div class="flex items-center gap-3 text-xs text-slate-400 sm:text-sm">
                <a href="/blogs/<%= post.id %>" class="flex items-center gap-1 transition-colors hover:text-rose-500" aria-label="Open article likes">
                  <i class="fa-regular fa-heart"></i> <span><%= post.likes %></span>
                </a>
                <span class="flex items-center gap-1"><i class="fa-regular fa-comment"></i> <%= post.comments %></span>
                <a href="/blogs/<%= post.id %>" class="transition-colors hover:text-[#0878E8]" aria-label="Open article to save it">
                  <i class="fa-regular fa-bookmark"></i>
                </a>
              </div>
            </div>
          </div>
        </article>
      <% }) %>

      <% if (!latestBlogs.length) { %>
        <p class="rounded-2xl bg-white p-6 text-sm text-slate-500 shadow-sm dark:bg-slate-900 dark:text-slate-400">No published articles are available yet.</p>
      <% } %>
      <a href="/blogs" class="mt-2 block text-center text-sm font-semibold text-[#0878E8] hover:underline sm:hidden">Read more →</a>
    </div>

    <!-- RIGHT: animated activity panel -->
    <aside class="min-w-0 lg:col-span-5" data-reveal data-reveal-delay="200">
      <div class="space-y-5 lg:sticky lg:top-24">

        <!-- Live activity -->
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#022E5A] via-[#053A72] to-[#0878E8] p-6 text-white shadow-xl">
          <div class="pointer-events-none absolute -top-10 -right-10 h-40 w-40 rounded-full bg-white/10 blur-2xl"></div>
          <div class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-white/5 blur-2xl"></div>

          <div class="relative flex items-center justify-between">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-white/70">Recent community uploads</p>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-300">Published</span>
          </div>

          <h3 class="relative mt-3 text-base font-semibold sm:text-lg">Recently shared notes</h3>

          <ul class="relative mt-4 space-y-2.5 text-sm">
            <% if (activityItems.length) { %>
              <% activityItems.forEach(function (item) { %>
                <li class="activity-item">
                  <span class="activity-avatar"><%= (item.who || "S").charAt(0).toUpperCase() %></span>
                  <span class="min-w-0 flex-1 truncate">
                    <span class="font-semibold text-white"><%= item.who %></span>
                    <span class="text-white/80"><%= item.action %></span>
                    <span class="text-white/60"><%= item.tag %></span>
                  </span>
                </li>
              <% }) %>
            <% } else { %>
              <li class="py-3 text-sm text-white/75">New community uploads will show here.</li>
            <% } %>
          </ul>
        </div>

        <!-- Trending tags -->
        <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200/70 dark:bg-slate-900 dark:ring-slate-800">
          <p class="text-[11px] font-semibold uppercase tracking-widest text-slate-400">Trending subjects</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <% if (subjects.length) { %>
              <% subjects.forEach(function (subject) { %>
                <a href="/notes?q=<%= encodeURIComponent(subject) %>" class="tag-chip">#<%= subject %></a>
              <% }) %>
            <% } else { %>
              <span class="text-sm text-slate-500 dark:text-slate-400">Subjects will appear when notes are published.</span>
            <% } %>
          </div>
        </div>

      </div>
    </aside>

  </div>
</section>

<!-- =========================================
     Testimonials — auto-scrolling marquee
========================================= -->
<section id="testimonials" class="overflow-hidden bg-[#022E5A] dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 sm:pt-20 lg:px-8">
    <h2 class="text-center text-2xl text-white sm:text-3xl" data-reveal>Illustrative student stories</h2>
    <p class="mx-auto mt-3 max-w-xl text-center text-sm text-slate-300/80 sm:text-base" data-reveal data-reveal-delay="100">
      Sample content to show how shared notes can help; these are not verified testimonials.
    </p>
  </div>

  <div class="testi-viewport mt-10 pb-16 sm:mt-12 sm:pb-20" id="testi-viewport" aria-label="Student testimonials, hover to pause">
    <div class="testi-track" id="testi-track">
      <% testimonials.forEach(function (t) { %>
        <div class="testi-card">
          <i class="fa-solid fa-quote-left text-[#0878E8]"></i>
          <p class="mt-3 text-sm leading-relaxed text-slate-200">"<%= t.quote %>"</p>
          <div class="mt-5 flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#0878E8]/15 text-sm font-semibold text-[#8CC4FF]"><%= t.name.charAt(0) %></span>
            <div>
              <p class="text-sm font-semibold text-white"><%= t.name %></p>
              <p class="text-xs text-slate-400"><%= t.role %></p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- =========================================
     Final CTA
========================================= -->
<section class="bg-[#FBFAF7] dark:bg-slate-900">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8" data-reveal>
    <h2 class="text-2xl text-[#022E5A] dark:text-white sm:text-3xl">Have notes others could use?</h2>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400 sm:text-base">
      Share your notebook scans or public study resources to help other students prepare.
    </p>
    <button type="button" data-open-modal="signup"
      class="mt-8 rounded-full bg-[#0878E8] px-8 py-3 text-sm font-semibold text-white shadow-sm
             transition-all hover:bg-[#0668CC] hover:shadow-md hover:-translate-y-0.5">
      <i class="fa-solid fa-cloud-arrow-up mr-1.5"></i> Upload notes
    </button>
  </div>
</section>

<!-- =========================================
     Page-specific styles
========================================= -->
<style>
    /* Clip slide-in transforms without creating a scroll container
      that would prevent the navbar from sticking to the viewport. */
    html, body { overflow-x: clip; }

  /* -------- Sort chips (Trending / Newest / Most downloaded) -------- */
  .sort-chip {
    border-radius: 9999px;
    border: 1px solid rgb(203 213 225);
    padding: 0.4rem 0.9rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(51 65 85);
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .dark .sort-chip { border-color: rgb(51 65 85); color: rgb(203 213 225); }
  .sort-chip.is-active { background: #0878E8; border-color: #0878E8; color: white; }

  /* ============================================================
     BLOG LIST — slide in from left (smaller offset on phones so
     nothing ever visibly touches the viewport edge)
  ============================================================ */
  .blog-item {
    opacity: 0;
    transform: translateX(-40px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--blog-delay, 0ms);
  }
  @media (max-width: 640px) {
    .blog-item { transform: translateX(-16px); }
  }
  .blog-item.is-in { opacity: 1; transform: translateX(0); }
  @media (prefers-reduced-motion: reduce) {
    .blog-item { opacity: 1; transform: none; transition: none; }
  }

  .activity-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.7rem;
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.06);
    animation: activityIn 0.5s ease both;
  }
  @keyframes activityIn {
    from { opacity: 0; transform: translateX(8px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .activity-avatar {
    display: flex;
    height: 1.75rem; width: 1.75rem;
    align-items: center; justify-content: center;
    border-radius: 9999px;
    background: rgba(255,255,255,0.15);
    font-size: 0.7rem; font-weight: 700; color: white;
    flex-shrink: 0;
  }

  /* -------- Trending tags -------- */
  .tag-chip {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgb(71 85 105);
    background: rgb(241 245 249);
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .dark .tag-chip { background: rgb(30 41 59); color: rgb(148 163 184); }
  .tag-chip:hover {
    background: rgba(8, 120, 232, 0.1);
    color: #0878E8;
    transform: translateY(-2px);
  }

  /* ============================================================
     Testimonials marquee
  ============================================================ */
  .testi-viewport {
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .testi-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    padding-inline: 1.25rem;
    animation: testiScroll 55s linear infinite;
    will-change: transform;
  }
  @media (min-width: 640px) {
    .testi-track { gap: 1.5rem; padding-inline: 1.5rem; }
  }
  .testi-viewport:hover .testi-track,
  .testi-viewport:focus-within .testi-track {
    animation-play-state: paused;
  }
  @keyframes testiScroll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }
  .testi-card {
    flex: 0 0 280px;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 1.25rem;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    transition: background 0.25s ease, transform 0.25s ease;
  }
  @media (min-width: 640px) {
    .testi-card { flex: 0 0 320px; padding: 1.5rem; }
  }
  @media (min-width: 1024px) {
    .testi-card { flex: 0 0 340px; }
  }
  @media (max-width: 380px) {
    .testi-card { flex: 0 0 240px; padding: 1rem; }
  }
  .testi-card:hover {
    background: rgba(255, 255, 255, 0.09);
    transform: translateY(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .testi-track { animation: none; }
  }

  /* -------- Like / upvote pop -------- */
  @keyframes likePop {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }
  .like-pop { animation: likePop 0.25s ease; }
</style>

<!-- =========================================
     Page-specific scripts
========================================= -->
<script>
  (function () {
    /* ============================================================
       FIX: Prevent page auto-scroll to testimonials on load.
    ============================================================ */
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

    window.addEventListener('load', function () {
      if (location.hash) {
        var target = document.querySelector(location.hash);
        if (target && (target.id === 'testimonials' || target.closest('#testimonials'))) {
          history.replaceState(null, '', location.pathname + location.search);
        }
      }
      if (!sessionStorage.getItem('ns-visited')) {
        window.scrollTo(0, 0);
        sessionStorage.setItem('ns-visited', '1');
      }
      var active = document.activeElement;
      if (active && active !== document.body &&
          active.closest && active.closest('#testimonials')) {
        active.blur();
      }
    });

    /* ============================================================
       STATS — count-up on scroll
    ============================================================ */
    (function statCounters() {
      var els = document.querySelectorAll('.stat-count');
      if (!els.length) return;
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function animate(el) {
        var target = Number(el.dataset.target) || 0;
        var suffix = el.dataset.suffix || '';
        if (prefersReduced) { el.textContent = target.toLocaleString() + suffix; return; }
        var duration = 1800;
        var start = performance.now();
        function frame(now) {
          var p = Math.min((now - start) / duration, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          var value = Math.floor(eased * target);
          el.textContent = value.toLocaleString() + (p === 1 ? suffix : '');
          if (p < 1) requestAnimationFrame(frame);
          else el.textContent = target.toLocaleString() + suffix;
        }
        requestAnimationFrame(frame);
      }

      var io = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { animate(e.target); obs.unobserve(e.target); }
        });
      }, { threshold: 0.4 });
      els.forEach(function (el) { io.observe(el); });
    })();

    /* ============================================================
       BLOG LIST — slide-in from left
    ============================================================ */
    (function blogReveal() {
      var items = document.querySelectorAll('.blog-item');
      if (!items.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach(function (i) { i.classList.add('is-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      items.forEach(function (el) { io.observe(el); });
    })();

    /* ============================================================
       TRENDING NOTES — live search + sort
    ============================================================ */
    (function trendingControls() {
      var grid = document.getElementById('trending-grid');
      var searchInput = document.getElementById('notes-search');
      var sortEl = document.getElementById('notes-sort');
      var emptyEl = document.getElementById('notes-empty');
      if (!grid) return;

      var cards = Array.from(grid.querySelectorAll('.trending-card'));

      function applySearch() {
        var q = (searchInput.value || '').toLowerCase().trim();
        var anyVisible = false;
        cards.forEach(function (card) {
          var haystack = (card.dataset.title + ' ' + card.dataset.tag).toLowerCase();
          var visible = !q || haystack.indexOf(q) !== -1;
          card.style.display = visible ? '' : 'none';
          if (visible) anyVisible = true;
        });
        if (emptyEl) emptyEl.classList.toggle('hidden', anyVisible);
      }

      function applySort(mode) {
        var sorted = cards.slice().sort(function (a, b) {
          if (mode === 'downloads') return Number(b.dataset.downloads) - Number(a.dataset.downloads);
          if (mode === 'newest') return Number(b.dataset.recency) - Number(a.dataset.recency);
          return Number(a.dataset.order) - Number(b.dataset.order);
        });
        sorted.forEach(function (card) { grid.appendChild(card); });
        if (emptyEl) grid.appendChild(emptyEl);
      }

      if (searchInput) searchInput.addEventListener('input', applySearch);

      if (sortEl) {
        sortEl.addEventListener('click', function (e) {
          var btn = e.target.closest('.sort-chip');
          if (!btn) return;
          sortEl.querySelectorAll('.sort-chip').forEach(function (b) {
            b.classList.toggle('is-active', b === btn);
          });
          applySort(btn.dataset.sort);
        });
      }
    })();

    /* ============================================================
       Testimonials marquee — duplicate for seamless loop
    ============================================================ */
    var track = document.getElementById('testi-track');
    if (track) {
      var originals = Array.from(track.children);
      originals.forEach(function (node) {
        var clone = node.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      });
      track.style.animationDuration = (originals.length * 6) + 's';
    }
  })();
</script>
