<% layout("/layouts/boilerplate") -%>
<%
  const editing = Boolean(note);
  const selectedUniversities = (note?.universities || []).map((item) => String(item._id || item));
  const selectedColleges = (note?.colleges || []).map((item) => String(item._id || item));
%>

<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
  <a href="<%= editing ? `/notes/${note._id}` : '/notes' %>" class="text-sm font-medium text-blue-700 hover:underline">← <%= editing ? "Back to note" : "Back to notes" %></a>
  <h1 class="mt-5 text-3xl font-bold text-slate-900 dark:text-white"><%= editing ? "Edit note" : "Share a note link" %></h1>
  <p class="mt-2 text-slate-600 dark:text-slate-300">Help students find relevant study material. Only share resources you have permission to publish.</p>
  <% if (editing && note.isPublished) { %>
    <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">Saving changes to a published note sends it back for admin review and temporarily hides it from the public library.</p>
  <% } else if (currUser?.role === "admin") { %>
    <p class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-200">Admin submissions publish immediately to the public notes library.</p>
  <% } else { %>
    <p class="mt-4 rounded-xl border border-blue-200 bg-blue-50 p-4 text-sm text-blue-900 dark:border-blue-900 dark:bg-blue-950/40 dark:text-blue-200">Your submission will be visible to you right away and published to the library after admin review.</p>
  <% } %>

  <% if (courses.length) { %>
    <form action="<%= editing ? `/notes/${note._id}` : '/notes' %>" method="POST" class="mt-8 space-y-5 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700"
      data-selected-universities="<%= selectedUniversities.join(',') %>"
      data-selected-colleges="<%= selectedColleges.join(',') %>"
      data-selected-specialization="<%= note?.specialization || '' %>"
      data-selected-semester="<%= note?.semester || '' %>">
      <% if (editing) { %><input type="hidden" name="_method" value="PUT"><% } %>
      <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Course
        <select name="courseId" id="note-course" required class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
          <option value="">Select a course</option>
          <% courses.forEach(function (course) { %><option value="<%= course._id %>" <%= String(note?.courseId || '') === String(course._id) ? "selected" : "" %>><%= course.name %></option><% }) %>
        </select>
      </label>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Specialization
          <select name="specialization" id="note-specialization" required disabled class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
            <option value="">Select a course first</option>
          </select>
        </label>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Semester
          <select name="semester" id="note-semester" required disabled class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
            <option value="">Select a course first</option>
          </select>
        </label>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <fieldset class="min-w-0 rounded-xl border border-slate-200 p-4 dark:border-slate-700">
          <legend class="px-1 text-sm font-semibold text-slate-700 dark:text-slate-200">1. Choose universities</legend>
          <p class="mb-3 text-xs text-slate-500">Select one or more universities where these notes are useful.</p>
          <div id="note-universities" class="max-h-64 space-y-2 overflow-y-auto" aria-live="polite">
            <p class="text-sm text-slate-500">Select a course first.</p>
          </div>
        </fieldset>
        <fieldset class="min-w-0 rounded-xl border border-slate-200 p-4 dark:border-slate-700">
          <legend class="px-1 text-sm font-semibold text-slate-700 dark:text-slate-200">2. Choose colleges</legend>
          <p class="mb-3 text-xs text-slate-500">Colleges appear under the universities you select.</p>
          <div id="note-colleges" class="max-h-64 space-y-3 overflow-y-auto" aria-live="polite">
            <p class="text-sm text-slate-500">Choose a university to see its colleges.</p>
          </div>
        </fieldset>
      </div>
      <p id="note-campus-error" class="hidden text-sm font-medium text-rose-600" role="alert">Choose at least one university and one college.</p>
      <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Note title
        <input name="title" required maxlength="160" value="<%= note?.title || '' %>" class="mt-1 w-full rounded-lg border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700">
      </label>
      <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Public notes URL
        <input name="sourceUrl" type="url" required maxlength="2048" value="<%= note?.sourceUrl || '' %>" placeholder="https://..." class="mt-1 w-full rounded-lg border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700">
        <span class="mt-1 block text-xs text-slate-500">Test the link in a signed-out/private browser window first. NoteSphere stores the URL, not the file.</span>
      </label>
      <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Description
        <textarea name="description" maxlength="2000" rows="3" class="mt-1 w-full rounded-lg border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700"><%= note?.description || '' %></textarea>
      </label>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">SEO description
          <textarea name="metaDescription" maxlength="300" rows="3" placeholder="A short search-result description" class="mt-1 w-full rounded-lg border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700"><%= note?.metaDescription || '' %></textarea>
        </label>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">SEO keywords
          <textarea name="keywords" maxlength="1200" rows="3" placeholder="exam notes, semester 2, mathematics" class="mt-1 w-full rounded-lg border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700"><%= (note?.keywords || []).join(', ') %></textarea>
          <span class="mt-1 block text-xs text-slate-500">Separate keywords with commas (up to 20).</span>
        </label>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Subject
          <input name="subject" required maxlength="100" value="<%= note?.subject || '' %>" class="mt-1 w-full rounded-lg border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700">
        </label>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Material category
          <input name="noteCategory" maxlength="80" value="<%= note?.noteCategory || 'General' %>" placeholder="EasyNotes, Quantom, exam preparation" class="mt-1 w-full rounded-lg border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700">
          <span class="mt-1 block text-xs text-slate-500">Examples: EasyNotes, Quantom, exam preparation. File format is selected separately.</span>
        </label>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 sm:col-span-2">File format
          <select name="type" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
            <% [["pdf", "PDF"], ["handwritten", "Handwritten"], ["typed", "Typed"], ["solved", "Solved papers"]].forEach(function (option) { %>
              <option value="<%= option[0] %>" <%= (note?.type || "pdf") === option[0] ? "selected" : "" %>><%= option[1] %></option>
            <% }); %>
          </select>
        </label>
      </div>
      <button type="submit" class="rounded-full bg-blue-600 px-6 py-3 font-semibold text-white hover:bg-blue-700"><%= editing ? "Save changes" : currUser?.role === "admin" ? "Publish note" : "Submit for review" %></button>
    </form>
  <% } else { %>
    <div class="mt-8 rounded-2xl border border-dashed border-slate-300 p-8 text-center dark:border-slate-700">
      <p class="font-semibold">No courses are available yet.</p>
      <p class="mt-2 text-sm text-slate-500">An administrator needs to add courses before notes can be submitted.</p>
      <% if (currUser?.role === "admin") { %><a href="/admin/universities" class="mt-4 inline-block text-sm font-semibold text-blue-700">Manage universities and colleges</a><% } %>
    </div>
  <% } %>
</section>

<script>
  (function () {
    const form = document.querySelector("form[data-selected-universities]");
    const courseSelect = document.getElementById("note-course");
    if (!form || !courseSelect) return;
    const specializationSelect = document.getElementById("note-specialization");
    const semesterSelect = document.getElementById("note-semester");
    const universitiesList = document.getElementById("note-universities");
    const collegesList = document.getElementById("note-colleges");
    const campusError = document.getElementById("note-campus-error");
    const initialUniversities = new Set(form.dataset.selectedUniversities.split(",").filter(Boolean));
    const initialColleges = new Set(form.dataset.selectedColleges.split(",").filter(Boolean));
    const initialSpecialization = form.dataset.selectedSpecialization;
    const initialSemester = form.dataset.selectedSemester;
    let selectedCourse = null;
    let loadingInitialCourse = true;

    function setOptions(select, options, placeholder) {
      select.replaceChildren();
      if (placeholder) select.add(new Option(placeholder, ""));
      options.forEach(function (option) {
        const item = typeof option === "string"
          ? new Option(option, option)
          : new Option(option.name, option._id);
        select.add(item);
      });
      select.disabled = options.length === 0;
    }

    function renderUniversityChoices(universities, selectedIds) {
      universitiesList.replaceChildren();
      if (!universities.length) {
        universitiesList.textContent = "No universities are available yet.";
        return;
      }
      universities.forEach(function (university) {
        const label = document.createElement("label");
        label.className = "flex cursor-pointer items-center gap-3 rounded-lg border border-slate-200 px-3 py-2 text-sm hover:border-blue-300 hover:bg-blue-50 dark:border-slate-700 dark:hover:bg-slate-800";
        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.name = "universities[]";
        checkbox.value = university._id;
        checkbox.checked = Boolean(selectedIds && selectedIds.has(university._id));
        checkbox.className = "h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500";
        checkbox.addEventListener("change", function () {
          renderCollegeChoices(selectedValues(universitiesList), selectedValues(collegesList));
        });
        const name = document.createElement("span");
        name.textContent = university.name;
        label.append(checkbox, name);
        universitiesList.appendChild(label);
      });
    }

    function selectedValues(container) {
      return new Set(Array.from(container.querySelectorAll('input[type="checkbox"]:checked')).map(function (input) {
        return input.value;
      }));
    }

    function renderCollegeChoices(selectedUniversityIds, selectedCollegeIds) {
      collegesList.replaceChildren();
      const selectedUniversities = (selectedCourse?.universities || []).filter(function (university) {
        return selectedUniversityIds.has(university._id);
      });
      if (!selectedUniversities.length) {
        collegesList.textContent = "Choose a university to see its colleges.";
        return;
      }
      selectedUniversities.forEach(function (university) {
        const group = document.createElement("fieldset");
        group.className = "space-y-2";
        const legend = document.createElement("legend");
        legend.className = "text-xs font-bold uppercase tracking-wide text-slate-500";
        legend.textContent = university.name;
        group.appendChild(legend);
        if (!university.colleges.length) {
          const empty = document.createElement("p");
          empty.className = "text-sm text-slate-500";
          empty.textContent = "No colleges are listed for this university yet.";
          group.appendChild(empty);
        }
        university.colleges.forEach(function (college) {
          const label = document.createElement("label");
          label.className = "flex cursor-pointer items-center gap-3 rounded-lg border border-slate-200 px-3 py-2 text-sm hover:border-blue-300 hover:bg-blue-50 dark:border-slate-700 dark:hover:bg-slate-800";
          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.name = "colleges[]";
          checkbox.value = college._id;
          checkbox.checked = Boolean(selectedCollegeIds && selectedCollegeIds.has(college._id));
          checkbox.className = "h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500";
          const name = document.createElement("span");
          name.textContent = college.name;
          label.append(checkbox, name);
          group.appendChild(label);
        });
        collegesList.appendChild(group);
      });
    }

    async function loadCourse(courseId, initial) {
      selectedCourse = null;
      setOptions(specializationSelect, [], "Loading...");
      setOptions(semesterSelect, [], "Loading...");
      universitiesList.textContent = courseId ? "Loading universities..." : "Select a course first.";
      collegesList.textContent = "Choose a university to see its colleges.";
      if (!courseId) return;
      try {
        const response = await fetch("/notes/courses/" + encodeURIComponent(courseId), {
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        if (!response.ok) throw new Error("Unable to load course and campus choices.");
        selectedCourse = await response.json();

        const specializationOptions = selectedCourse.specializations.length ? selectedCourse.specializations : ["General"];
        setOptions(specializationSelect, specializationOptions, "Select specialization");
        specializationSelect.value = initial ? initialSpecialization || specializationOptions[0] : specializationOptions[0];
        setOptions(
          semesterSelect,
          Array.from({ length: selectedCourse.semesterCount }, function (_, index) { return String(index + 1); }),
          "Select semester",
        );
        semesterSelect.value = initial && initialSemester ? initialSemester : "1";
        renderUniversityChoices(selectedCourse.universities, initial ? initialUniversities : null);
        renderCollegeChoices(
          initial ? initialUniversities : new Set(),
          initial ? initialColleges : new Set(),
        );
      } catch (error) {
        setOptions(specializationSelect, [], "Could not load course");
        setOptions(semesterSelect, [], "Could not load course");
        universitiesList.textContent = "Could not load universities.";
        collegesList.textContent = "Could not load colleges.";
        window.alert(error.message);
      } finally {
        loadingInitialCourse = false;
      }
    }

    courseSelect.addEventListener("change", function () {
      loadCourse(courseSelect.value, false);
    });
    form.addEventListener("submit", function (event) {
      const validCampus = selectedValues(universitiesList).size > 0 && selectedValues(collegesList).size > 0;
      campusError.classList.toggle("hidden", validCampus);
      if (!validCampus) {
        event.preventDefault();
        campusError.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });
    if (courseSelect.value) loadCourse(courseSelect.value, loadingInitialCourse);
  })();
</script>
